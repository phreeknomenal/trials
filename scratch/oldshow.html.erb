<% if @error.present? %>
  <!-- Error State -->
  <div class="min-h-screen flex items-center justify-center px-5">
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-8 max-w-2xl w-full text-center">
      <div class="text-red-400 dark:text-red-500 mb-4">
        <%= render Utilities::IconComponent.new("exclamation_circle", size: 16) %>
      </div>
      <h2 class="text-2xl font-bold text-red-900 dark:text-red-100 mb-2">Error Loading Trial</h2>
      <p class="text-red-800 dark:text-red-200 mb-6"><%= @error %></p>
      <%= link_to "Back to My Trials", my_trials_path, class: "inline-flex items-center text-lavender-600 hover:text-lavender-700 font-medium" %>
    </div>
  </div>
<% elsif @study.present? %>
  <!-- Header Section -->
  <%= render Page::Trials::HeaderComponent.new(study: @study) %>

  <section class="px-5 lg:px-44 pt-8 flex flex-row justify-between items-center">
    <%= render Page::Navigation::BreadcrumbComponent.new %>
  </section>

  <section class="px-5 lg:px-44 pt-8 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-8 gap-10">
      <%# LEFT SIDEBAR %>
      <div class="lg:col-span-2">
        <div class="sticky top-10">
          <%= render Page::Trials::Sidebar::ContainerComponent.new() do %>
            <%= render Page::Trials::Sidebar::AnchorLinkComponent.new(path: "#key-details", text: "Key Details") %>
            <%= render Page::Trials::Sidebar::AnchorLinkComponent.new(path: "#study-overview", text: "Study Overview") %>
            <%= render Page::Trials::Sidebar::AnchorLinkComponent.new(path: "#eligibility", text: "Eligibility Criteria") %>
            <%= render Page::Trials::Sidebar::AnchorLinkComponent.new(path: "#interventions", text: "Interventions/Treatments") %>
            <%= render Page::Trials::Sidebar::AnchorLinkComponent.new(path: "#locations", text: "Trial Locations") %>
            <%= render Page::Trials::Sidebar::AnchorLinkComponent.new(path: "#contact-information", text: "Contact Information") %>
          <% end %>
          
          <!-- Trial Match Score -->
          <% if @trial_score.present? %>
            <%= render Page::Trials::MatchScoreCardComponent.new(
              trial_score: @trial_score,
              match_level: @match_level,
              score_breakdown: @score_breakdown
            ) %>
          <% end %>

          <!-- Profile Match Info -->
          <% if @profile %>
            <div class="mt-6 p-4 bg-lavender-50 dark:bg-lavender-900/20 border border-lavender-200 dark:border-lavender-800 rounded-lg">
              <h3 class="text-sm font-semibold text-lavender-900 dark:text-lavender-100 mb-2">
                Your Profile
              </h3>
              <div class="text-xs text-lavender-800 dark:text-lavender-200 space-y-1">
                <% if @profile.age.present? %>
                  <p><strong>Age:</strong> <%= @profile.age %></p>
                <% end %>
                <% if @profile.sex_assigned_at_birth.present? %>
                  <p><strong>Sex:</strong> <%= @profile.sex_assigned_at_birth.titleize %></p>
                <% end %>
                <% if @profile.city && @profile.state %>
                  <p><strong>Location:</strong> <%= @profile.city %>, <%= @profile.state %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# RIGHT CONTENT %>
      <div class="lg:col-span-6 space-y-8">
        <!-- Key Details -->
        <%= render Page::Trials::KeyDetailsComponent.new(study: @study) %>

        <!-- Overview -->
        <%= render Page::Trials::OverviewComponent.new(
          summary: @study[:summary],
          detailed_description: @study[:detailed_description]
        ) %>

        <!-- Eligibility Criteria -->
        <div id="eligibility" class="mb-8">
          <%= render Typography::HeadingComponent.new(size: :h4, text: "Eligibility Criteria") %>
          <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
            <% if @study[:min_age].present? %>
              <div>
                <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Minimum Age</p>
                <p class="text-base text-zinc-900 dark:text-zinc-100"><%= @study[:min_age] %></p>
              </div>
            <% end %>
            
            <% if @study[:max_age].present? %>
              <div>
                <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Maximum Age</p>
                <p class="text-base text-zinc-900 dark:text-zinc-100"><%= @study[:max_age] %></p>
              </div>
            <% end %>
            
            <% if @study[:sex].present? %>
              <div>
                <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Sex</p>
                <p class="text-base text-zinc-900 dark:text-zinc-100"><%= @study[:sex] %></p>
              </div>
            <% end %>
          </div>

          <% if @study[:inclusion_criteria].present? %>
            <div class="mt-6">
              <%= render Page::DropdownComponent.new(title: "Eligibility Criteria", body: @study[:inclusion_criteria]) %>
            </div>
          <% end %>
        </div>

        <!-- Interventions/Treatments -->
        <% if @study[:interventions].present? && @study[:interventions].any? %>
          <div id="interventions" class="mb-8">
            <div class="mb-4">
              <%= render Typography::HeadingComponent.new(size: :h4, text: "Interventions/Treatments") %>
            </div>
            <div class="space-y-4">
              <% @study[:interventions].each do |intervention| %>
                <div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg p-4">
                  <div class="flex items-start gap-2 mb-2">
                    <%= render Utilities::BadgeComponent.new(
                      text: intervention[:type],
                      variant: :tag,
                      size: :sm
                    ) %>
                    <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-300">
                      <%= intervention[:name] %>
                    </h3>
                  </div>
                  <% if intervention[:description].present? %>
                    <p class="text-sm text-zinc-600 dark:text-zinc-400">
                      <%= intervention[:description] %>
                    </p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Locations -->
        <div id="locations">
          <%= render Typography::HeadingComponent.new(size: :h4, text: "Trial Locations") %>
          <% if @study[:locations].present? %>
            <div class="grid grid-cols-2 mt-4 gap-6">
              <% @study[:locations].each do |location| %>
                <div class="col-span-1 flex items-start gap-1 p-3 border border-zinc-300 dark:border-zinc-700 rounded-lg">
                  <div class="mt-0.5">
                    <%= render Utilities::IconComponent.new("map_pin", size: 5, options: { class: "text-lavender-600" }) %>
                  </div>
                  <span class="text-zinc-900 dark:text-zinc-100"><%= location %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-zinc-500 dark:text-zinc-400 mt-4">No location information available.</p>
          <% end %>
        </div>

        <!-- Contact Information -->
        <% if (@study[:central_contacts].present? && @study[:central_contacts].any?) || (@study[:overall_officials].present? && @study[:overall_officials].any?) %>
          <div id="contact-information" class="mb-8">
            <div class="mb-4">
              <%= render Typography::HeadingComponent.new(size: :h4, text: "Contact Information") %>
            </div>

            <% if @study[:central_contacts].present? && @study[:central_contacts].any? %>
              <div class="mb-6">
                <%= render Typography::HeadingComponent.new(size: :h6, text: "Study Contacts") %>
                <div class="mt-3 space-y-3">
                  <% @study[:central_contacts].each do |contact| %>
                    <div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg p-4">
                      <h4 class="font-semibold text-zinc-900 dark:text-zinc-300">
                        <%= contact[:name] %>
                      </h4>
                      <% if contact[:role].present? %>
                        <p class="text-sm text-zinc-500 dark:text-zinc-400">
                          <%= contact[:role] %>
                        </p>
                      <% end %>
                      <div class="mt-2 space-y-1">
                        <% if contact[:phone].present? %>
                          <p class="text-sm text-zinc-600 dark:text-zinc-400">
                            <strong>Phone:</strong> <%= contact[:phone] %>
                          </p>
                        <% end %>
                        <% if contact[:email].present? %>
                          <p class="text-sm text-zinc-600 dark:text-zinc-400">
                            <strong>Email:</strong> <%= contact[:email] %>
                          </p>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @study[:overall_officials].present? && @study[:overall_officials].any? %>
              <div>
                <%= render Typography::HeadingComponent.new(size: :h6, text: "Principal Investigators") %>
                <div class="mt-3 space-y-3">
                  <% @study[:overall_officials].each do |official| %>
                    <div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg p-4">
                      <h4 class="font-semibold text-zinc-900 dark:text-zinc-300">
                        <%= official[:name] %>
                      </h4>
                      <% if official[:role].present? %>
                        <p class="text-sm text-zinc-500 dark:text-zinc-400">
                          <%= official[:role] %>
                        </p>
                      <% end %>
                      <% if official[:affiliation].present? %>
                        <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
                          <%= official[:affiliation] %>
                        </p>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- CTA Section -->
        <div class="bg-lavender-50 dark:bg-lavender-900/20 border border-lavender-200 dark:border-lavender-800 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-lavender-900 dark:text-lavender-100 mb-2">
            Interested in this trial?
          </h3>
          <p class="text-lavender-800 dark:text-lavender-200 mb-4">
            Visit ClinicalTrials.gov for contact information and to learn more about participating.
          </p>
          <%= link_to "View on ClinicalTrials.gov", "https://clinicaltrials.gov/study/#{@study[:nct_id]}", 
              target: "_blank", 
              rel: "noopener noreferrer",
              class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-lavender-600 hover:bg-lavender-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-lavender-500" %>
        </div>
      </div>
    </div>
  </section>
<% else %>
  <!-- Not Found State -->
  <section class="px-5 lg:px-24 py-16">
    <div class="bg-zinc-100 dark:bg-zinc-800 rounded-lg p-8 text-center">
      <div class="text-zinc-400 dark:text-zinc-500 mb-4">
        <%= render Utilities::IconComponent.new("search", size: 16) %>
      </div>
      <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-300 mb-2">
        Trial Not Found
      </h3>
      <p class="text-zinc-600 dark:text-zinc-400 mb-4">
        The clinical trial you're looking for could not be found.
      </p>
      <%= link_to "Back to Search", search_index_path, class: "text-lavender-600 hover:text-lavender-700 font-medium" %>
    </div>
  </section>
<% end %>

