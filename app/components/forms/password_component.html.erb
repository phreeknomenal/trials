<label for="<%= name %>" class="block text-sm font-medium text-ink-2">
  <%= label %>
  <% if options[:required] %>
    <span class="text-crit">*</span>
  <% end %>
</label>
<div class="relative" data-controller="password-visibility">
  <%= form.text_field name, options %>
  <%= button_tag type: "button", class: "absolute inset-y-0 right-0 flex items-center pr-3 text-ink-3 dark:text-ink-3-on-dark hover:text-ink-2 dark:hover:text-ink-2-on-dark focus:outline-none", data: {action: "click->password-visibility#toggle", "password-visibility-target": "button"} do %>
    <%= render Utilities::IconComponent.new("eye", size: 6, options: {class: "h-6 w-6", data: {"password-visibility-target": "visibleIcon"}, viewbox: "0 0 24 24", stroke_width: "2"}) %>
    <%= render Utilities::IconComponent.new("eye_slash", size: 6, options: {class: "hidden h-6 w-6", data: {"password-visibility-target": "hiddenIcon"}, viewbox: "0 0 24 24"}) %>
  <% end %>
</div>
