<label for="<%= name %>" class="<%= label_options[:class] %>">
  <%= label %>
  <% if choice_options[:required] %>
    <span class="text-red-500">*</span>
  <% end %>
</label>
<div class="flex flex-col my-1" data-controller="sortable">
  <ul data-sortable-target="list">
    <% choices.each do |option| %>
      <li data-sortable-id-param="<%= option[0] %>" class="flex items-center justify-between px-2 py-1 cursor-move border border-secondary-200 rounded-md my-2" data-sortable-target="item">
        <span class="handle mr-2 cursor-move handle">
          <%= render Utilities::IconComponent.new("bars_4", options: {class: "h-6 w-6 text-gray-400"}) %>
        </span>
        <%= form.hidden_field name, name: form.field_name(name, multiple: true), value: option[0] %>
        <%= form.label name, option[1], class: "ml-2 text-md" %>
        <div class="flex flex-col">
          <div class="border rounded-md m-0.5 move-up">
            <div class="p-2">
              <span data-action="click->sortable#moveUp" class="cursor-pointer">
                <%= render Utilities::IconComponent.new("chevron_up", options: {class: "h-5 w-5 text-gray-400" }) %>
              </span>
            </div>
          </div>
          <div class="border rounded-md m-0.5 move-down">
            <div class="p-2">
              <span data-action="click->sortable#moveDown" class="cursor-pointer">
                <%= render Utilities::IconComponent.new("chevron_down", options: {class: "h-5 w-5 text-gray-400" }) %>
              </span>
            </div>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</div>
