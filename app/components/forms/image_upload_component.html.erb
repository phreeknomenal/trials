<div class="flex items-center gap-5 rounded-card border border-dashed border-line-2 dark:border-line-on-dark bg-surface-2 dark:bg-surface-on-dark px-5 py-4"
     data-controller="avatar-upload">

  <%# Fixed box, so the row does not jump when a preview replaces the
      placeholder, and so the image cannot stretch. %>
  <div class="relative w-20 h-20 shrink-0">
    <% if current_image? %>
      <%= image_tag current, class: "w-full h-full object-cover rounded-full", alt: "" %>
    <% else %>
      <div data-avatar-upload-target="placeholder"
           class="w-full h-full rounded-full bg-line dark:bg-surface-2-on-dark flex items-center justify-center text-ink-3 dark:text-ink-3-on-dark">
        <% if initials.present? %>
          <span class="text-xl font-bold"><%= initials %></span>
        <% else %>
          <%= render Utilities::IconComponent.new("user_circle", size: 8) %>
        <% end %>
      </div>
    <% end %>

    <img data-avatar-upload-target="preview" hidden alt=""
         class="absolute inset-0 w-full h-full object-cover rounded-full ring-2 ring-sky-500">
  </div>

  <div class="min-w-0 flex flex-col items-start gap-1.5">
    <%# A label rather than a button, so the hidden input is reached by clicking
        or by keyboard without any JavaScript in the path. %>
    <label class="<%= Buttons::ButtonStyles.classes("secondary", size: "px-4 py-2 text-sm") %> cursor-pointer
                  focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-focus">
      <%= render Utilities::IconComponent.new("pen_nib", size: 4) %>
      <%= button_label %>
      <%= form.file_field attribute,
            accept: "image/png, image/jpeg, image/webp",
            direct_upload: true,
            class: "sr-only",
            data: {action: "change->avatar-upload#select", "avatar-upload-target": "input"} %>
    </label>

    <p class="text-xs text-ink-3 dark:text-ink-3-on-dark">PNG, JPEG or WebP. Optional.</p>

    <p data-avatar-upload-target="filename" class="text-xs font-medium text-ink-2 dark:text-ink-2-on-dark truncate max-w-[220px]"></p>

    <button type="button" hidden data-avatar-upload-target="remove" data-action="avatar-upload#remove"
            class="text-xs font-semibold text-crit dark:text-crit-on-dark hover:underline cursor-pointer">
      Remove this photo
    </button>
  </div>
</div>
