<div class="form-group">
  <% case field_type %>
  <% when :checkbox %>
    <div class="flex items-center gap-2">
      <%= input_field %>
      <%= form.label(attribute, field_label, class: checkbox_label_class) %>
    </div>
  <% when :checkbox_with_description %>
    <div>
      <div class="flex items-center gap-2">
        <%= input_field %>
        <%= form.label(attribute, field_label, class: checkbox_label_class) %>
      </div>
      <p class="<%= Forms::FieldStyles::HINT %>"><%= options[:description] %></p>
    </div>
  <% when :radio %>
    <%= form.label(attribute, field_label, class: Forms::FieldStyles::LABEL) if label.present? %>
    <div class="flex flex-col gap-1">
      <% select_options.each do |option| %>
        <div class="flex items-center gap-2">
          <%= form.radio_button(attribute, option[0], class: "h-4 w-4 accent-sky-500") %>
          <%= form.label("#{attribute}_#{option[0]}".parameterize, option[1], class: checkbox_label_class) %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= form.label(attribute, field_label, class: Forms::FieldStyles::LABEL) if label.present? %>
    <%= input_field %>
  <% end %>

  <%# The hint sits above the error, because a hint explains the field and an
      error explains this attempt. Both are wired to the input by id. %>
  <% if hint.present? %>
    <p id="<%= hint_id %>" class="<%= Forms::FieldStyles::HINT %>"><%= hint %></p>
  <% end %>

  <% if invalid? %>
    <p id="<%= error_id %>" class="<%= Forms::FieldStyles::MESSAGE %>">
      <span class="shrink-0 mt-0.5">
        <%= render Utilities::IconComponent.new("exclamation_circle", size: 4) %>
      </span>
      <span><%= errors.to_sentence.upcase_first %></span>
    </p>
  <% end %>
</div>
