<div class="border-b border-sky-200 dark:border-sky-800 bg-sky-50 dark:bg-navy-900/30">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <p class="text-sm text-ink-2 dark:text-ink-2-on-dark">
      <span class="font-semibold">Your profile is not finished.</span>
      <%= pluralize(remaining, "optional step") %> left, and they sharpen how studies are ranked for you.
    </p>

    <div class="flex items-center gap-3 shrink-0">
      <%= link_to "Finish it",
            onboarding_step_path(step: next_step.slug),
            class: "text-sm font-bold text-sky-700 dark:text-sky-300 hover:underline" %>

      <%= button_to onboarding_banner_path,
            method: :delete,
            class: "text-ink-4 hover:text-ink-2 dark:hover:text-ink-on-dark cursor-pointer",
            aria: {label: "Dismiss"} do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      <% end %>
    </div>
  </div>
</div>
