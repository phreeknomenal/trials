<%# Half width rather than thirds. Thirds were a space saving move from when
    this step also carried the pill lists; with the step to itself there is room,
    and "Prefer not to say" is cramped in a third of a column. %>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
  <%= render Forms::FieldComponent.new(
    form: form, attribute: :gender_id, field_type: :select, label: "Gender",
    select_options: Gender.all.map { |gender| [gender.name.titleize, gender.id] },
    options: {include_blank: "Prefer not to say", autofocus: true, data: {onboarding_target: "firstField"}}
  ) %>

  <%= render Forms::FieldComponent.new(
    form: form, attribute: :race_id, field_type: :select, label: "Race",
    select_options: Race.all.map { |race| [race.name.titleize, race.id] },
    options: {include_blank: "Prefer not to say"}
  ) %>

  <%= render Forms::FieldComponent.new(
    form: form, attribute: :ethnicity, field_type: :select, label: "Ethnicity",
    select_options: ethnicity_options,
    options: {include_blank: "Prefer not to say"}
  ) %>
</div>
