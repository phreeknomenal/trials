<div class="space-y-5">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <%# Takes the autofocus that pronouns used to carry, pronouns having moved to
        step one. Without it the step opens with nothing focused. %>
    <%= render Forms::FieldComponent.new(
      form: form, attribute: :gender_id, field_type: :select, label: "Gender",
      select_options: Gender.all.map { |gender| [gender.name.titleize, gender.id] },
      options: {include_blank: "Prefer not to say", autofocus: true, data: {onboarding_target: "firstField"}}
    ) %>

    <%= render Forms::FieldComponent.new(
      form: form, attribute: :race_id, field_type: :select, label: "Race",
      select_options: Race.all.map { |race| [race.name.titleize, race.id] },
      options: {include_blank: "Prefer not to say"}
    ) %>

    <%= render Forms::FieldComponent.new(
      form: form, attribute: :ethnicity, field_type: :select, label: "Ethnicity",
      select_options: ethnicity_options,
      options: {include_blank: "Prefer not to say"}
    ) %>
  </div>

  <% if Identity.any? %>
    <div>
      <label class="block text-sm font-bold text-ink dark:text-ink-2-on-dark mb-2">I am a...</label>
      <%# Bounded rather than left to grow. Sixty one pills between the two lists
          ran this step to several screens, which pushed the panel beside it out
          of view. Nothing is hidden: the region scrolls. %>
      <div class="max-h-44 overflow-y-auto overscroll-contain rounded-card border border-line dark:border-line-on-dark bg-surface-2/50 dark:bg-surface-on-dark/40 p-3">
        <div class="flex flex-wrap gap-2">
        <%= form.collection_check_boxes :identity_ids, Identity.all, :id, :name do |builder| %>
          <label class="inline-flex items-center px-4 py-2 bg-surface dark:bg-surface-on-dark hover:bg-sky-100 dark:hover:bg-navy-900 rounded-full cursor-pointer transition-colors border-2 border-transparent has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50 dark:has-[:checked]:bg-navy-900/50 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-focus">
            <%= builder.check_box(class: "sr-only") %>
            <span class="text-sm font-medium text-ink-2 dark:text-ink-2-on-dark"><%= builder.text.titleize %></span>
          </label>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if Interest.any? %>
    <div>
      <label class="block text-sm font-bold text-ink dark:text-ink-2-on-dark mb-2">Looking for...</label>
      <%# Bounded rather than left to grow. Sixty one pills between the two lists
          ran this step to several screens, which pushed the panel beside it out
          of view. Nothing is hidden: the region scrolls. %>
      <div class="max-h-44 overflow-y-auto overscroll-contain rounded-card border border-line dark:border-line-on-dark bg-surface-2/50 dark:bg-surface-on-dark/40 p-3">
        <div class="flex flex-wrap gap-2">
        <%= form.collection_check_boxes :interest_ids, Interest.all, :id, :name do |builder| %>
          <label class="inline-flex items-center px-4 py-2 bg-surface dark:bg-surface-on-dark hover:bg-sky-100 dark:hover:bg-navy-900 rounded-full cursor-pointer transition-colors border-2 border-transparent has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50 dark:has-[:checked]:bg-navy-900/50 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-focus">
            <%= builder.check_box(class: "sr-only") %>
            <span class="text-sm font-medium text-ink-2 dark:text-ink-2-on-dark"><%= builder.text.titleize %></span>
          </label>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
