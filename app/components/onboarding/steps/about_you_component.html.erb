<div class="space-y-5">
  <div class="flex justify-center">
    <%= render Forms::ImageUploadComponent.new(form: form, attribute: :avatar) %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <%= render Forms::FieldComponent.new(
      form: form, attribute: :pronouns, field_type: :select, label: "Pronouns",
      select_options: pronoun_options,
      options: {include_blank: "Prefer not to say", autofocus: true, data: {onboarding_target: "firstField"}}
    ) %>

    <%= render Forms::FieldComponent.new(
      form: form, attribute: :gender_id, field_type: :select, label: "Gender",
      select_options: Gender.all.map { |gender| [gender.name.titleize, gender.id] },
      options: {include_blank: "Prefer not to say"}
    ) %>

    <%= render Forms::FieldComponent.new(
      form: form, attribute: :race_id, field_type: :select, label: "Race",
      select_options: Race.all.map { |race| [race.name.titleize, race.id] },
      options: {include_blank: "Prefer not to say"}
    ) %>

    <%= render Forms::FieldComponent.new(
      form: form, attribute: :ethnicity, field_type: :select, label: "Ethnicity",
      select_options: ethnicity_options,
      options: {include_blank: "Prefer not to say"}
    ) %>
  </div>

  <% if Identity.any? %>
    <div>
      <label class="block text-sm font-bold text-ink dark:text-ink-2-on-dark mb-3">I am a...</label>
      <div class="flex flex-wrap gap-2">
        <%= form.collection_check_boxes :identity_ids, Identity.all, :id, :name do |builder| %>
          <label class="inline-flex items-center px-4 py-2 bg-surface-2 dark:bg-surface-on-dark hover:bg-sky-100 dark:hover:bg-navy-900 rounded-full cursor-pointer transition-colors border-2 border-transparent has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50 dark:has-[:checked]:bg-navy-900/50">
            <%= builder.check_box(class: "sr-only") %>
            <span class="text-sm font-medium text-ink-2 dark:text-ink-2-on-dark"><%= builder.text.titleize %></span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if Interest.any? %>
    <div>
      <label class="block text-sm font-bold text-ink dark:text-ink-2-on-dark mb-3">Looking for...</label>
      <div class="flex flex-wrap gap-2">
        <%= form.collection_check_boxes :interest_ids, Interest.all, :id, :name do |builder| %>
          <label class="inline-flex items-center px-4 py-2 bg-surface-2 dark:bg-surface-on-dark hover:bg-sky-100 dark:hover:bg-navy-900 rounded-full cursor-pointer transition-colors border-2 border-transparent has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50 dark:has-[:checked]:bg-navy-900/50">
            <%= builder.check_box(class: "sr-only") %>
            <span class="text-sm font-medium text-ink-2 dark:text-ink-2-on-dark"><%= builder.text.titleize %></span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
