<div class="space-y-5">
  <%= render Forms::FieldComponent.new(
    form: form, attribute: :birth_year, field_type: :number, label: "Birth year",
    options: {min: 1900, max: Time.current.year, placeholder: "e.g. 1986",
              autofocus: true, data: {onboarding_target: "firstField"}}
  ) %>

  <div>
    <%= render Forms::FieldComponent.new(
      form: form, attribute: :sex_assigned_at_birth, field_type: :select,
      label: "Sex assigned at birth",
      select_options: sex_options,
      options: {include_blank: UNANSWERED_PROMPT}
    ) %>
    <%# "Prefer not to say" is stored, so the profile can show it was declined,
        but Profile#sex_for_matching reads it as blank. It scores neutral and
        disqualifies nobody, which is why the two non-binary options were
        removed in #96: they were read as definite answers and ruled the user
        out of every sex-restricted study. %>
    <p class="mt-2 text-xs text-ink-3 dark:text-ink-3-on-dark">
      Studies list eligibility as all, female, or male. Prefer not to say keeps you eligible everywhere.
    </p>
  </div>
</div>
