<div id="profile-onboarding-modal" 
     data-controller="modal" 
     data-profile-incomplete="<%= !profile.profile_completed? %>">
  
  <div data-modal-target="modal" class="hidden fixed inset-0 bg-zinc-900 bg-opacity-75 z-50 items-center justify-center p-4">
    <div class="bg-white dark:bg-zinc-800 rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto scrollbar-hide">
      
      <!-- Modal Header -->
      <div class="sticky top-0 bg-white dark:bg-zinc-800 border-b border-zinc-200 dark:border-zinc-700 px-6 py-4 rounded-t-2xl z-10">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-300">Welcome! Complete Your Profile</h2>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">Help us personalize your experience by completing your profile</p>
          </div>
          <div class="text-purple-600 dark:text-purple-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Modal Body -->
      <div class="px-6 py-6">
        <%= render Profiles::OnboardingFormComponent.new(profile: profile) %>
      </div>

    </div>
  </div>
</div>

