<%= link_to path, class: color_styles do %>
  <% if icon.present? %>
    <% if icon_position == "left" %>
      <%= render Utilities::IconComponent.new(icon, size: 5) %> <%= text %>
    <% else %>
      <%= text %> <%= render Utilities::IconComponent.new(icon, size: 5) %>
    <% end %>
  <% else %>
    <%= text %>
  <% end %>
<% end %>
