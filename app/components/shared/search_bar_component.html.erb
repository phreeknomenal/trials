<div>
  <%= form_with url: url, method: :get, class: container_class do |f| %>
    <div class="<%= layout_class %>">

      <div class="<%= full? ? "flex-1 min-w-0" : "flex-1 min-w-0" %>">
        <%= f.label :condition, "Condition", class: label_class %>
        <%# A text field with suggestions, not a select.

            It was a select built from the conditions table, which meant the app
            could search for 72 conditions and no others: somebody with
            sarcoidosis or myasthenia gravis had no way to ask. The registry
            accepts any term, so the control was narrower than the thing behind
            it for no reason.

            A datalist keeps the list one keystroke away and still lets anyone
            type what they actually have. %>
        <%= f.text_field :condition, value: condition, placeholder: PLACEHOLDER,
              list: datalist_id, autocomplete: "off", class: field_class %>
        <% if condition_names.any? %>
          <datalist id="<%= datalist_id %>">
            <% condition_names.each do |name| %>
              <option value="<%= name %>"></option>
            <% end %>
          </datalist>
        <% end %>
      </div>

      <span class="<%= divider_class %>" aria-hidden="true"></span>

      <div class="<%= full? ? "lg:w-[220px]" : "sm:w-[200px]" %>">
        <%= f.label :location, "Location", class: label_class %>
        <%= f.text_field :location, value: location, placeholder: "City, state or ZIP", class: field_class %>
      </div>

      <%# A button rather than a submit input, because an input cannot hold the
          search icon the style guide asks for. %>
      <%= f.button type: "submit", class: submit_class do %>
        <%= render Utilities::IconComponent.new("search", size: full? ? 5 : 4) %>
        <%= submit_text %>
      <% end %>
    </div>
  <% end %>

  <% if full? && popular_conditions.any? %>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="text-sm text-ink-3 dark:text-ink-3-on-dark">Common searches</span>
      <% popular_conditions.each do |name| %>
        <%= render Shared::PillComponent.new(text: name, path: path_for(name)) %>
      <% end %>
    </div>
  <% end %>
</div>
