<div id="main-flash-messages" class="flex flex-col gap-2 px-4 py-3">
  <% messages.each do |message| %>
    <% style = presentation_for(message[:tone]) %>
    <div class="flex items-start gap-3 rounded-lg border border-l-4 p-4 <%= style[:classes] %>"
         role="<%= style[:role] %>"
         data-controller="flash">
      <span class="shrink-0 mt-0.5" aria-hidden="true">
        <%= render Utilities::IconComponent.new(style[:icon], size: 5) %>
      </span>

      <p class="flex-1 text-sm">
        <span class="sr-only"><%= style[:prefix] %>:</span>
        <%= message[:text] %>
      </p>

      <button type="button"
              class="shrink-0 rounded p-0.5 opacity-70 hover:opacity-100 transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
              data-action="flash#dismiss"
              aria-label="Dismiss <%= style[:prefix].downcase %> message">
        <%= render Utilities::IconComponent.new("close", size: 4) %>
      </button>
    </div>
  <% end %>
</div>
