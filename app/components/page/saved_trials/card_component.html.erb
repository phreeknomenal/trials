<%# A saved study in the list, against the board.

    The checkbox is the page's one selection. It used to carry
    `form="compare-trials-form"` and say "Compare", which made it a
    compare-only control while a second, dead "Select All" claimed to select
    the same rows for a status change. One box now, and the toolbar above
    decides what to do with it.

    No distance beside the location. There is none in the data. %>
<article id="saved-trial-<%= saved_trial.id %>"
         class="rounded-card border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark
                p-5 flex gap-4 transition-colors hover:border-navy-600 dark:hover:border-sky-400">

  <div class="pt-1">
    <label class="flex items-center cursor-pointer">
      <span class="sr-only">Select <%= saved_trial.trial_title %></span>
      <input type="checkbox" value="<%= saved_trial.id %>"
             data-selection-target="checkbox" data-action="selection#update"
             class="w-4 h-4 rounded-sm border-line-2 dark:border-line-2-on-dark accent-navy-600">
    </label>
  </div>

  <div class="flex-1 min-w-0 flex flex-col gap-3">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <%# items-start, or the badge stretches. A flex column defaults to
          align-items: stretch, which makes an inline-flex badge as wide as the
          title beneath it. %>
      <div class="flex flex-col items-start gap-2 min-w-0">
        <%= render Shared::StatusBadgeComponent.new(status: saved_trial.status) %>
        <h2 class="font-primary text-lg font-bold leading-snug tracking-tight text-ink dark:text-ink-on-dark">
          <%= link_to saved_trial.trial_title, saved_trial_path(saved_trial),
                class: "hover:text-sky-600 dark:hover:text-sky-300" %>
        </h2>
      </div>

      <% if saved_trial.match_score.present? %>
        <span class="shrink-0 rounded-control <%= match_score_badge_class(saved_trial.match_score.to_i) %> px-2.5 py-1.5 flex flex-col items-center leading-none">
          <span class="text-base font-extrabold tabular-nums"><%= saved_trial.match_score.to_i %></span>
          <span class="text-[9px] font-bold tracking-wider">MATCH</span>
        </span>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-3 dark:text-ink-3-on-dark">
      <span class="font-mono"><%= saved_trial.nct_id %></span>
      <span>Saved <%= saved_trial.created_at.to_fs(:long) %></span>
      <% if saved_trial.phase.present? %>
        <span><%= humanize_registry_value(saved_trial.phase) %></span>
      <% end %>
    </div>

    <%# The note if there is one, otherwise the tags. Both at once on a row this
        size pushes the next study off the screen, and the note is the thing
        somebody wrote themselves. %>
    <% if saved_trial.notes.present? %>
      <p class="text-sm leading-relaxed text-ink-2 dark:text-ink-2-on-dark line-clamp-2">
        <span class="font-semibold text-ink dark:text-ink-on-dark">Your note:</span>
        <%= truncate(saved_trial.notes.to_plain_text, length: 180) %>
      </p>
    <% elsif saved_trial.tags_array.any? %>
      <ul class="flex flex-wrap gap-1.5">
        <% saved_trial.tags_array.first(4).each do |tag| %>
          <li class="rounded-chip bg-surface-2 dark:bg-surface-2-on-dark px-2 py-0.5 text-xs font-semibold text-ink-2 dark:text-ink-2-on-dark">
            <%= tag %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="flex flex-wrap gap-3 pt-1">
      <%= link_to "Open", saved_trial_path(saved_trial),
            class: Buttons::ButtonStyles.classes("secondary", size: "px-3 py-1.5 text-sm") %>
      <%= link_to "View the study", search_path(saved_trial.nct_id),
            class: Buttons::ButtonStyles.classes("quiet", size: "px-3 py-1.5 text-sm") %>
    </div>
  </div>
</article>
