<article class="<%= card_class %>">
  <div class="flex items-start gap-4">

    <%# Signed in, the score leads. Signed out there is nothing here at all,
        rather than a greyed-out number, which would read as a bad score instead
        of an absent one. %>
    <% if scored? %>
      <div class="shrink-0 flex flex-col items-center gap-1">
        <span class="<%= score_class %> flex flex-col items-center justify-center w-14 h-14 rounded-chip">
          <span class="text-lg font-extrabold leading-none tabular-nums"><%= score %></span>
          <span class="text-[9px] font-bold tracking-wider">MATCH</span>
        </span>
      </div>
    <% end %>

    <div class="min-w-0 flex-1">
      <% if eyebrow.present? %>
        <p class="text-xs font-bold uppercase tracking-wide text-ink-3 dark:text-ink-3-on-dark mb-1">
          <%= scored? ? "#{tier_label} · #{eyebrow}" : eyebrow %>
        </p>
      <% end %>

      <h3 class="text-lg font-bold leading-snug tracking-tight text-ink dark:text-ink-on-dark">
        <%= link_to title, detail_path, class: "hover:text-sky-600 dark:hover:text-sky-300" %>
      </h3>

      <%# The two icons that survived review: a pin for where, a calendar for
          when. Everything else on the row is words. %>
      <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-3 dark:text-ink-3-on-dark">
        <% if location_label.present? %>
          <span class="inline-flex items-center gap-1.5">
            <%= render Utilities::IconComponent.new("map_pin", size: 4) %>
            <%= location_label %><%= " · Near you" if near_you? %>
          </span>
        <% end %>

        <% if age_range.present? %>
          <span class="inline-flex items-center gap-1.5">
            <%= render Utilities::IconComponent.new("calendar", size: 4) %>
            <%= age_range %>
          </span>
        <% end %>
      </div>

      <% if conditions.any? %>
        <div class="mt-2.5 flex flex-wrap gap-1.5">
          <% conditions.each do |condition| %>
            <span class="inline-flex items-center rounded-chip bg-surface-2 dark:bg-surface-2-on-dark px-2.5 py-1 text-xs font-semibold text-ink-2 dark:text-ink-2-on-dark">
              <%= condition %>
            </span>
          <% end %>
        </div>
      <% end %>

      <%# An ineligible study says which criterion stopped it. A number at zero
          looks like a poor match; it is a hard stop from a named failure. %>
      <% if ineligible? && disqualifier_reason.present? %>
        <p class="mt-3 rounded-chip bg-surface-2 dark:bg-surface-2-on-dark px-3 py-2 text-sm text-ink-2 dark:text-ink-2-on-dark">
          <%= disqualifier_reason %>
        </p>
      <% elsif criteria_summary.present? %>
        <p class="mt-3 text-sm font-semibold text-ink-2 dark:text-ink-2-on-dark">
          <%= criteria_summary %>
        </p>
      <% end %>
    </div>

    <div class="shrink-0 flex flex-col items-end gap-2">
      <% if signed_in? %>
        <%= render Buttons::SaveTrialButtonComponent.new(
              nct_id: nct_id,
              trial_title: title,
              saved_trial: saved_trial,
              size: "sm",
              match_score: score
            ) %>
      <% else %>
        <%# The offer that replaces the score. It names what signing in buys,
            rather than asking for an account and explaining afterwards. %>
        <%= link_to "Check your match", new_user_session_path,
              class: Buttons::ButtonStyles.classes("secondary", size: "px-3 py-1.5 text-sm") %>
      <% end %>
    </div>
  </div>
</article>
