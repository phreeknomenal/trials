<div class="bg-surface dark:bg-surface-on-dark border border-line dark:border-line-on-dark rounded-xl p-6 transition-colors hover:border-line-2 dark:hover:border-line-2-on-dark">
  <!-- Match Score Badge (if available) -->
  <% if study[:trial_score].present? %>
    <div class="mb-3">
      <span class="<%= match_score_badge_class(study[:trial_score]) %> inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-semibold">
        <%= render Utilities::IconComponent.new("check_circle", size: 4) %>
        <%= study[:trial_score] %>% Match
        <span class="text-xs opacity-75">(<%= study[:match_level].capitalize %>)</span>
      </span>
    </div>
  <% end %>

  <h3 class="text-2xl font-bold tracking-tight text-ink dark:text-ink-on-dark mb-2">
    <%= link_to study[:title], detail_path, class: "hover:text-sky-600" %>
  </h3>
  <div class="flex items-start gap-2 mb-5">
    <%= render Utilities::BadgeComponent.new(
      text: study[:nct_id],
      variant: :nct_id,
      size: :md
    ) %>
    <%= render Utilities::BadgeComponent.new(
      status: study[:status],
      size: :md
    ) %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
    <% if study[:phase].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Phase", record: study[:phase], icon: "beaker") %>
    <% end %>

    <% if study[:start_date].present? || study[:completion_date].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Study Duration", record: parse_date_range(study[:start_date], study[:completion_date]), icon: "clock_arrow") %>
    <% end %>

    <% if study[:min_age].present? || study[:max_age].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Age Range", record: [study[:min_age], study[:max_age]].compact.join(" - "), icon: "calendar_month") %>
    <% end %>

    <% if study[:sponsor].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Sponsor", record: study[:sponsor], icon: "building_office") %>
    <% end %>

    <% if study[:conditions].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Conditions", record: study[:conditions].first, icon: "microscope") %>
    <% end %>

    <% if study[:locations].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Locations", record: study[:locations].first, icon: "map_pin") %>
    <% end %>
  </div>

  <% if study[:summary].present? %>
    <p class="font-body text-sm text-zinc-600 dark:text-zinc-400 line-clamp-3">
      <%= study[:summary] %>
    </p>
  <% end %>

  <div class="mt-4">
    <%= render Buttons::ButtonComponent.new(
      path: detail_path,
      text: "View Details",
      color: "quiet",
      icon: "arrow_right",
      icon_position: "right"
    ) %>
  </div>
</div>

