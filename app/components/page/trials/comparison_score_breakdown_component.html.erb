<div class="rounded-lg border border-zinc-200 dark:border-zinc-700 shadow-md bg-white dark:bg-zinc-800 overflow-hidden">
  <div class="px-6 py-4 border-b border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-700/50">
    <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">Match Score Breakdown Comparison</h2>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[600px]">
      <thead>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <th scope="col" class="text-left py-3 px-4 text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 w-32">
            Criteria
          </th>
          <% @trials.each_with_index do |trial, idx| %>
            <th scope="col" class="text-left py-3 px-4 border-l border-zinc-200 dark:border-zinc-700 <%= idx == 0 ? 'bg-zinc-50 dark:bg-zinc-700/30' : '' %>">
              <div class="space-y-1">
                <p class="text-xs text-zinc-500 dark:text-zinc-400">NCT<%= trial.nct_id %></p>
                <p class="font-semibold text-zinc-900 dark:text-zinc-100 text-sm line-clamp-2 break-words">
                  <%= truncate(trial.trial_title, length: 40) %>
                </p>
              </div>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @criteria.each_with_index do |criteria, idx| %>
          <tr class="border-b border-zinc-200 dark:border-zinc-700 <%= idx.even? ? 'bg-white dark:bg-zinc-800' : 'bg-zinc-50 dark:bg-zinc-700/20' %>">
            <td class="py-4 px-4 text-sm font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
              <div class="w-4 h-4 text-zinc-600 dark:text-zinc-400 flex-shrink-0">
                <%= render Utilities::IconComponent.new(get_icon_for_criteria(criteria), size: 16) %>
              </div>
              <%= criteria %>
            </td>
            <% @trials.each_with_index do |trial, trial_idx| %>
              <% score = score_for_trial_and_criteria(trial, @criteria_keys[idx]) %>
              <% is_highest = is_highest_score?(score, @criteria_keys[idx]) %>
              <td class="py-4 px-4 border-l border-zinc-200 dark:border-zinc-700 <%= idx.even? ? 'bg-white dark:bg-zinc-800' : 'bg-zinc-50 dark:bg-zinc-700/20' %>">
                <div class="space-y-2">
                  <div 
                    class="relative h-8 overflow-hidden rounded-md <%= match_score_bg_class(score_match_level(score)) %> border <%= match_score_border_class(score_match_level(score)) %> transition-all duration-300"
                    style="width: max(50px, <%= score %>%);"
                  >
                    <div
                      class="h-full rounded-md flex items-center justify-center"
                      data-score="<%= score %>"
                      data-match-level="<%= score_match_level(score) %>"
                    >
                      <span class="text-sm font-bold drop-shadow-sm <%= get_text_color_for_score(score) %>">
                        <%= score %>%
                      </span>
                    </div>
                  </div>
                  <% if is_highest %>
                    <div class="text-xs font-semibold text-zinc-600 dark:text-zinc-400 flex items-center gap-1">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />
                      </svg>
                      Highest
                    </div>
                  <% end %>
                </div>
              </td>
            <% end %>
          </tr>
        <% end %>
        <tr class="border-t-2 border-zinc-300 dark:border-zinc-600 bg-zinc-50 dark:bg-zinc-700/50">
          <td class="py-4 px-4 text-sm font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <svg class="w-4 h-4 text-zinc-600 dark:text-zinc-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
            </svg>
            Overall Match
          </td>
          <% @trials.each_with_index do |trial, trial_idx| %>
            <td class="py-4 px-4 border-l border-zinc-200 dark:border-zinc-700 <%= trial_idx == 0 ? 'bg-zinc-50 dark:bg-zinc-700/50' : 'bg-zinc-50 dark:bg-zinc-700/50' %>">
              <div class="flex items-center gap-3">
                <span class="text-2xl font-bold <%= match_score_text_class(match_level_for_score(trial.match_score)) %>">
                  <%= trial.match_score %>%
                </span>
                <span class="text-xs font-semibold px-2 py-1 rounded-full <%= match_score_badge_class(trial.match_score) %>">
                  <%= score_label_for_score(trial.match_score) %>
                </span>
              </div>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>
</div>
