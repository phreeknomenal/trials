<div class="mb-8 p-8 border border-line-2 dark:border-line-on-dark rounded-lg">
  <%= render Typography::HeadingComponent.new(size: :h5, text: "Eligibility Checklist") %>
  
  <% if @checklist_items.empty? %>
    <div class="mt-4 p-4 bg-surface-2 dark:bg-surface-on-dark rounded-lg text-center">
      <p class="text-ink-3 dark:text-ink-3-on-dark text-sm">
        No eligibility information available for this trial.
      </p>
    </div>
  <% else %>
    <div class="mt-4 space-y-3">
      <% @checklist_items.each do |item| %>
        <div class="flex gap-4 p-4 bg-surface-2 dark:bg-surface-on-dark/50 border border-line dark:border-line-on-dark rounded-lg">
          <!-- Icon Column -->
          <div class="flex-shrink-0 w-6 h-6 mt-0.5 <%= status_icon_color(item[:status]) %>">
            <%= render Utilities::IconComponent.new(item[:icon], size: 6) %>
          </div>

          <!-- Content Column -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <h4 class="font-semibold text-ink dark:text-ink-on-dark">
                <%= item[:label] %>
              </h4>
              <span class="inline-block text-xs font-medium px-2 py-0.5 rounded-full <%= status_badge_class(item[:status]) %>">
                <%= status_label(item[:status]) %>
              </span>
            </div>

            <p class="text-sm text-ink-2 dark:text-ink-2-on-dark">
              <%= item[:explanation] %>
            </p>

            <!-- Expandable Section for Parsed Criteria -->
            <% if item[:is_expandable] && item[:full_text] %>
              <details class="mt-2">
                <summary class="text-sm text-sky-600 dark:text-sky-400 cursor-pointer hover:underline font-medium">
                  View full eligibility criteria
                </summary>
                <div class="mt-2 p-3 bg-surface dark:bg-paper-on-dark border border-line dark:border-line-on-dark rounded text-sm text-ink-2 dark:text-ink-2-on-dark max-h-48 overflow-y-auto">
                  <%= simple_format(item[:full_text]) %>
                </div>
              </details>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Disclaimer -->
    <div class="mt-4 p-3 bg-info/10 dark:bg-info-on-dark/20 border border-info/30 dark:border-info-on-dark rounded-lg">
      <p class="text-xs text-info dark:text-info-on-dark">
        <strong>Note:</strong> This checklist is a quick reference based on publicly available trial information. Always verify eligibility requirements directly with the trial contact before applying.
      </p>
    </div>
  <% end %>
</div>
