<% if render? %>
  <div class="mt-4 p-5 lg:p-10 bg-surface dark:bg-surface-on-dark border border-line dark:border-line-on-dark rounded-lg">
    <%= render Typography::HeadingComponent.new(size: :h5, text: "Key dates") %>
    <div class="flex flex-wrap items-center gap-4 mt-4">
      <% dates.each_with_index do |(label, date_val), index| %>
        <div class="flex items-center gap-2">
          <% if index > 0 %>
            <span class="text-ink-4 dark:text-ink-4-on-dark">→</span>
          <% end %>
          <div class="flex flex-col">
            <span class="text-sm font-body text-ink-3 dark:text-ink-3-on-dark"><%= label %></span>
            <span class="text-sm font-body text-ink-2 dark:text-ink-on-dark"><%= format_date(date_val) %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
