<% if render? %>
  <div class="mt-4 p-5 lg:p-10 bg-white dark:bg-zinc-800/900 border border-zinc-200 dark:border-zinc-700 rounded-lg">
    <%= render Typography::HeadingComponent.new(size: :h5, text: "Key dates") %>
    <div class="flex flex-wrap items-center gap-4 mt-4">
      <% dates.each_with_index do |(label, date_val), index| %>
        <div class="flex items-center gap-2">
          <% if index > 0 %>
            <span class="text-zinc-300 dark:text-zinc-600">→</span>
          <% end %>
          <div class="flex flex-col">
            <span class="text-sm font-body text-zinc-500 dark:text-zinc-400"><%= label %></span>
            <span class="text-sm font-body text-zinc-800 dark:text-zinc-200"><%= format_date(date_val) %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
