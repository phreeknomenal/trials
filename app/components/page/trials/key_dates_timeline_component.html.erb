<% if render? %>
  <div class="mt-4 p-4 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-lg">
    <p class="text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-3">Key dates</p>
    <div class="flex flex-wrap items-center gap-4">
      <% dates.each_with_index do |(label, date_val), index| %>
        <div class="flex items-center gap-2">
          <% if index > 0 %>
            <span class="text-zinc-300 dark:text-zinc-600">→</span>
          <% end %>
          <div class="flex flex-col">
            <span class="text-xs text-zinc-500 dark:text-zinc-400"><%= label %></span>
            <span class="text-sm font-medium text-zinc-800 dark:text-zinc-200"><%= format_date(date_val) %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
