<% if render? %>
  <div class="mt-4 p-4 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-lg">
    <p class="text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">What does this mean?</p>
    <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
      <% if phase_explanation.present? %>
        <li>
          <strong class="text-zinc-800 dark:text-zinc-200">Phase:</strong>
          <%= phase_explanation %>
        </li>
      <% end %>
      <% if status_explanation.present? %>
        <li>
          <strong class="text-zinc-800 dark:text-zinc-200">Status:</strong>
          <%= status_explanation %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
