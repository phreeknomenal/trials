<div id="key-details" class="border border-zinc-300 dark:border-zinc-700 p-8 rounded-lg">
  <div class="mb-4">
    <%= render Typography::HeadingComponent.new(size: :h5, text: "Key Details") %>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-y-6">
    <% if @study[:phase].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Phase", record: @study[:phase], icon: "swatch") %>
    <% end %>

    <% if @study[:study_type].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Study Type", record: @study[:study_type], icon: "rectangle_stack") %>
    <% end %>

    <% if @study[:status].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Status", record: @study[:status]&.gsub("_", " "), icon: "exclamation_triangle") %>
    <% end %>

    <% if @study[:min_age].present? || @study[:max_age].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Age Range", record: [@study[:min_age], @study[:max_age]].compact.join(" - "), icon: "calendar_month") %>
    <% end %>

    <% if @study[:enrollment_count].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Enrollment", record: @study[:enrollment_count], icon: "users_group") %>
    <% end %>

    <% if @study[:start_date].present? || @study[:completion_date].present? %>
      <%= render Page::Trials::TileComponent.new(title: "Study Duration", record: parse_date_range(@study[:start_date], @study[:completion_date]), icon: "clock_arrow") %>
    <% end %>

    <div class="col-span-3">
      <%= render Page::Trials::TileComponent.new(title: "Sponsor(s)", record: @study[:sponsor], icon: "building_office") %>
    </div>
  </div>
</div>

