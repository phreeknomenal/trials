<div id="eligibility" class="rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-6 lg:p-8 flex flex-col gap-7">
  <%# The board's heading is the answer, not the question: "You meet 6 of 7
      criteria". The score sits beside it rather than two panels away, so the
      number and the reason for it are on screen together, and the one thing
      this panel asks for is a button on the right rather than a link buried in
      the caveat. %>
  <header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="flex items-start gap-4 flex-1 min-w-0">
      <% if score? %>
        <%# Solid, not tinted by tier. The tint is how a score reads at a glance
            against the scores either side of it on a result list; here the tile
            is alone on the page and the number beside a sentence saying what it
            counts is the whole signal. %>
        <span class="shrink-0 w-16 h-16 rounded-card bg-navy-700 dark:bg-navy-600 flex flex-col items-center justify-center leading-none">
          <span class="text-2xl font-extrabold tabular-nums text-white"><%= trial_score.to_i %></span>
          <span class="mt-1 text-[9px] font-bold tracking-[0.12em] text-white/75">MATCH</span>
        </span>
      <% end %>

      <div class="flex flex-col gap-1 min-w-0">
        <%# Not pluralize: Rails does not know this one and produces "criterions". %>
        <%= render Typography::HeadingComponent.new(
              size: :section,
              text: "You meet #{met_count} of #{total_count} #{(total_count == 1) ? "criterion" : "criteria"}"
            ) %>
        <%# The caveat that has to be on this section rather than buried: the app
            is reading a registry record against a profile, and only the study
            team can actually say yes. %>
        <p class="text-meta text-ink-3 dark:text-ink-3-on-dark">
          <% if profile_updated_on %>
            Based on the profile you last updated on <%= profile_updated_on %>.
          <% end %>
          Only the study team can confirm eligibility.
        </p>
      </div>
    </div>

    <% if profile %>
      <%= link_to "Update my profile", edit_profile_path(profile),
            class: "shrink-0 #{Buttons::ButtonStyles.classes("secondary")}" %>
    <% end %>
  </header>

  <div class="grid gap-x-10 gap-y-7 md:grid-cols-2">
    <% sections.each do |key, config, items| %>
      <section class="<%= "md:col-span-2" if full_width?(key) %>">
        <h3 class="text-xs font-bold uppercase tracking-[0.09em] text-ink-3 dark:text-ink-3-on-dark">
          <%= config[:heading] %>
        </h3>
        <% if config[:note].present? %>
          <p class="mt-1.5 text-xs leading-relaxed text-ink-3 dark:text-ink-3-on-dark"><%= config[:note] %></p>
        <% end %>

        <%# Rules between rows rather than a card around each, which is the
            board's shape and also the honest one: these are lines in a list,
            not four separate objects. %>
        <ul class="mt-2 divide-y divide-line dark:divide-line-on-dark">
          <% items.each do |item| %>
            <% icon, tone = mark_for(item) %>
            <li class="flex gap-3 items-start py-3">
              <span class="shrink-0 mt-0.5 <%= tone %>">
                <%= render Utilities::IconComponent.new(icon, size: 5) %>
              </span>

              <div class="min-w-0">
                <%# One flowing line per row, as on the board. The label leads
                    because a couple of the checker's explanations ("Pregnancy
                    status may apply | Organ function requirements may apply")
                    do not say what they are about on their own. %>
                <p class="text-body text-ink dark:text-ink-2-on-dark">
                  <span class="font-semibold"><%= item[:label] %></span>
                  <% if item[:explanation].present? %>
                    <span class="text-ink-2 dark:text-ink-3-on-dark"><%= item[:explanation] %></span>
                  <% end %>
                </p>

                <%# Some criteria carry the registry's full text, which is long and
                    written for clinicians. It stays collapsed. %>
                <% if item[:is_expandable] && item[:full_text].present? %>
                  <details class="mt-2">
                    <summary class="text-xs font-semibold text-sky-700 dark:text-sky-300 cursor-pointer">
                      Read the study's own wording
                    </summary>
                    <p class="mt-2 text-xs text-ink-3 dark:text-ink-3-on-dark whitespace-pre-line leading-relaxed">
                      <%= item[:full_text] %>
                    </p>
                  </details>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <%# The working, behind a disclosure. The criteria above are the answer; this
      is how the number was arrived at, and it used to be a panel of its own two
      sections up. %>
  <% if breakdown_items.any? %>
    <details class="border-t border-line dark:border-line-on-dark pt-4 group">
      <summary class="cursor-pointer list-none flex items-center gap-2 text-sm font-semibold text-ink-2 dark:text-ink-2-on-dark rounded-nav focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
        <span class="text-ink-3 dark:text-ink-3-on-dark transition-transform group-open:rotate-180">
          <%= render Utilities::IconComponent.new("chevron_down", size: 4) %>
        </span>
        How the score breaks down
      </summary>
      <div class="grid gap-x-8 gap-y-4 sm:grid-cols-2 pt-4">
        <% breakdown_items.each do |item| %>
          <div class="flex gap-3 items-start">
            <span class="w-5 h-5 mt-0.5 shrink-0 <%= match_score_text_class(match_level) %>">
              <%= render Utilities::IconComponent.new(item[:icon], size: 5) %>
            </span>
            <div class="w-full min-w-0">
              <%= render Utilities::ScoreProgressBarComponent.new(
                    score: item[:value], label: item[:label], match_level: match_level
                  ) %>
            </div>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
