<div id="eligibility" class="rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-6 lg:p-8">
  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
    <h2 class="text-xl font-bold tracking-tight text-ink dark:text-ink-on-dark">Do you qualify</h2>
    <p class="text-sm font-semibold text-ink-2 dark:text-ink-2-on-dark tabular-nums">
      You meet <%= met_count %> of <%= total_count %>
    </p>
  </div>

  <%# The caveat that has to be on this section rather than buried: the app is
      reading a registry record against a profile, and only the study team can
      actually say yes. %>
  <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mb-6 leading-relaxed">
    <% if profile_updated_on %>
      Checked against the profile you last updated on <%= profile_updated_on %>.
    <% end %>
    Only the study team can confirm whether you can join.
    <%= link_to "Update your profile", edit_profile_path(profile), class: "font-semibold text-sky-700 dark:text-sky-300 hover:underline" if profile %>
  </p>

  <div class="flex flex-col gap-6">
    <% visible_groups.each do |key, config, items| %>
      <section>
        <h3 class="flex items-center gap-2 text-sm font-bold text-ink dark:text-ink-2-on-dark mb-1">
          <span class="<%= config[:tone] %>">
            <%= render Utilities::IconComponent.new(config[:icon], size: 5) %>
          </span>
          <%= config[:heading] %>
          <span class="tabular-nums font-semibold text-ink-3 dark:text-ink-3-on-dark">(<%= items.length %>)</span>
        </h3>
        <p class="text-xs text-ink-3 dark:text-ink-3-on-dark mb-3 ml-7"><%= config[:note] %></p>

        <ul class="flex flex-col gap-2 ml-7">
          <% items.each do |item| %>
            <li class="rounded-card border border-line dark:border-line-on-dark p-3">
              <p class="text-sm font-semibold text-ink dark:text-ink-2-on-dark"><%= item[:label] %></p>
              <% if item[:explanation].present? %>
                <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mt-0.5 leading-relaxed"><%= item[:explanation] %></p>
              <% end %>

              <%# Some criteria carry the registry's full text, which is long and
                  written for clinicians. It stays collapsed. %>
              <% if item[:is_expandable] && item[:full_text].present? %>
                <details class="mt-2">
                  <summary class="text-xs font-semibold text-sky-700 dark:text-sky-300 cursor-pointer">
                    Read the study's own wording
                  </summary>
                  <p class="mt-2 text-xs text-ink-3 dark:text-ink-3-on-dark whitespace-pre-line leading-relaxed">
                    <%= item[:full_text] %>
                  </p>
                </details>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
