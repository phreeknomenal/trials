<div id="eligibility" class="rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-6 lg:p-8">
  <%# The board's heading is the answer, not the question: "You meet 6 of 7
      criteria". The score sits beside it rather than two panels away, so the
      number and the reason for it are on screen together. %>
  <div class="flex flex-wrap items-center gap-4 mb-1">
    <% if score? %>
      <span class="shrink-0 rounded-control <%= match_score_bg_class(match_level) %> border <%= match_score_border_class(match_level) %> px-3 py-2 flex flex-col items-center leading-none">
        <span class="text-2xl font-extrabold tabular-nums <%= match_score_text_class(match_level) %>"><%= trial_score.to_i %></span>
        <span class="text-[9px] font-bold tracking-wider <%= match_score_text_class(match_level) %>">OF 100</span>
      </span>
    <% end %>
    <h2 class="text-xl font-bold tracking-tight text-ink dark:text-ink-on-dark">
      <%# Not pluralize: Rails does not know this one and produces "criterions". %>
      You meet <%= met_count %> of <%= total_count %> <%= (total_count == 1) ? "criterion" : "criteria" %>
    </h2>
  </div>

  <%# The caveat that has to be on this section rather than buried: the app is
      reading a registry record against a profile, and only the study team can
      actually say yes. %>
  <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mb-6 leading-relaxed">
    <% if profile_updated_on %>
      Checked against the profile you last updated on <%= profile_updated_on %>.
    <% end %>
    Only the study team can confirm whether you can join.
    <%= link_to "Update your profile", edit_profile_path(profile), class: "font-semibold text-sky-700 dark:text-sky-300 hover:underline" if profile %>
  </p>

  <div class="flex flex-col gap-6">
    <% visible_groups.each do |key, config, items| %>
      <section>
        <h3 class="flex items-center gap-2 text-sm font-bold text-ink dark:text-ink-2-on-dark mb-1">
          <span class="<%= config[:tone] %>">
            <%= render Utilities::IconComponent.new(config[:icon], size: 5) %>
          </span>
          <%= config[:heading] %>
          <span class="tabular-nums font-semibold text-ink-3 dark:text-ink-3-on-dark">(<%= items.length %>)</span>
        </h3>
        <p class="text-xs text-ink-3 dark:text-ink-3-on-dark mb-3 ml-7"><%= config[:note] %></p>

        <ul class="flex flex-col gap-2 ml-7">
          <% items.each do |item| %>
            <li class="rounded-card border border-line dark:border-line-on-dark p-3">
              <p class="text-sm font-semibold text-ink dark:text-ink-2-on-dark"><%= item[:label] %></p>
              <% if item[:explanation].present? %>
                <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mt-0.5 leading-relaxed"><%= item[:explanation] %></p>
              <% end %>

              <%# Some criteria carry the registry's full text, which is long and
                  written for clinicians. It stays collapsed. %>
              <% if item[:is_expandable] && item[:full_text].present? %>
                <details class="mt-2">
                  <summary class="text-xs font-semibold text-sky-700 dark:text-sky-300 cursor-pointer">
                    Read the study's own wording
                  </summary>
                  <p class="mt-2 text-xs text-ink-3 dark:text-ink-3-on-dark whitespace-pre-line leading-relaxed">
                    <%= item[:full_text] %>
                  </p>
                </details>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <%# The working, behind a disclosure. The criteria above are the answer; this
      is how the number was arrived at, and it used to be a panel of its own two
      sections up. %>
  <% if breakdown_items.any? %>
    <details class="mt-6 border-t border-line dark:border-line-on-dark pt-4 group">
      <summary class="cursor-pointer list-none flex items-center gap-2 text-sm font-semibold text-ink-2 dark:text-ink-2-on-dark rounded-nav focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
        <span class="text-ink-3 dark:text-ink-3-on-dark transition-transform group-open:rotate-180">
          <%= render Utilities::IconComponent.new("chevron_down", size: 4) %>
        </span>
        How the score breaks down
      </summary>
      <div class="grid gap-x-8 gap-y-4 sm:grid-cols-2 pt-4">
        <% breakdown_items.each do |item| %>
          <div class="flex gap-3 items-start">
            <span class="w-5 h-5 mt-0.5 shrink-0 <%= match_score_text_class(match_level) %>">
              <%= render Utilities::IconComponent.new(item[:icon], size: 5) %>
            </span>
            <div class="w-full min-w-0">
              <%= render Utilities::ScoreProgressBarComponent.new(
                    score: item[:value], label: item[:label], match_level: match_level
                  ) %>
            </div>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
