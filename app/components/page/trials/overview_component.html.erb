<div id="study-overview" class="border border-zinc-300 dark:border-zinc-700 rounded-lg p-8">
  <%= render Typography::HeadingComponent.new(size: :h5, text: "Overview") %>
  <div class="text-zinc-600 dark:text-zinc-400 font-body max-w-none mt-4">
    <%= simple_format(summary) %>
  </div>
  
  <% if detailed_description.present? %>
    <div class="mt-4">
      <%= render Page::DropdownComponent.new(
        title: "Detailed Description",
        body: detailed_description
      ) %>
    </div>
  <% end %>

  <% if @study[:conditions].present? %>
    <div class="flex gap-2 items-start mt-6">
      <div class="w-5 h-5 mt-[3px] shrink-0 text-lavender-600">
        <%= render Utilities::IconComponent.new("microscope", size: 16) %>
      </div>
      <div class="">
        <%= render Typography::HeadingComponent.new(size: :h7, text: "Conditions") %>
        <div class="mt-2 flex flex-wrap gap-2">
          <% @study[:conditions].each do |condition| %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300">
              <%= condition %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

