<div id="study-overview" class="border border-line-2 dark:border-line-on-dark rounded-panel p-8">
  <%= render Typography::HeadingComponent.new(size: :h5, text: "What this study is testing") %>

  <%# Said out loud, because the order is the point: the registry's own words are
      what you read, and the plain-language rewrite below is something you ask
      for. Without the label the two blocks look interchangeable. %>
  <p class="mt-1 text-xs font-bold uppercase tracking-wide text-ink-3 dark:text-ink-3-on-dark">
    From the registry record
  </p>

  <div class="text-ink-3 dark:text-ink-3-on-dark font-body max-w-none mt-3">
    <%= simple_format(summary) %>
  </div>

  <%= helpers.turbo_stream_from "readable_study_summary_#{nct_id}" %>
  <div id="readable-study-summary-content-<%= nct_id %>" class="mt-6">
    <%= helpers.render partial: "shared/readable_study_summary_content", locals: {record: readable_summary, nct_id: nct_id, source_present: source_present?} %>
  </div>

  <% if detailed_description.present? %>
    <div class="mt-4">
      <%= render Page::DropdownComponent.new(
        title: "Detailed Description",
        body: detailed_description
      ) %>
    </div>
  <% end %>

  <% if conditions.present? %>
    <div class="flex gap-2 items-start mt-6">
      <div class="w-5 h-5 mt-[3px] shrink-0 text-sky-600">
        <%= render Utilities::IconComponent.new("microscope", size: 5) %>
      </div>
      <div class="">
        <%= render Typography::HeadingComponent.new(size: :h7, text: "Conditions") %>
        <div class="mt-2 flex flex-wrap gap-2">
          <% conditions.each do |condition| %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-info/10 text-info dark:bg-info-on-dark/30 dark:text-info-on-dark">
              <%= condition %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

