<div id="match-score-card" class="grid grid-cols-4 gap-8 p-8 <%= match_score_bg_class(@match_level) %> border <%= match_score_border_class(@match_level) %> rounded-lg mb-6">
  <div class="col-span-1">
    <h3 class="text-lg font-bold text-center text-ink dark:text-ink-on-dark">
      Your Match Score
    </h3>
    
    <div class="text-center">
      <div class="text-6xl <%= match_score_text_class(@match_level) %> font-bold mt-2 mb-3">
        <%= @trial_score %>%
      </div>
      <div class="text-sm text-ink dark:text-ink-on-dark font-semibold mt-1 leading-none">
        <%= match_phrase(@match_level) %>
      </div>
    </div>
  </div>

  <div class="col-span-3">
    <h3 class="text-lg font-bold text-ink dark:text-ink-on-dark mb-4">
      Match Score Details
    </h3>
    <div class="grid grid-cols-2 gap-x-8 gap-y-6">
      <% breakdown_items.each_with_index do |item, index| %>
        <div class="flex gap-3 items-start" data-controller="expandable-explanation">
          <div class="w-5 h-5 mt-1 flex-shrink-0 <%= match_score_text_class(@match_level) %>">
            <%= render Utilities::IconComponent.new(item[:icon], size: 5) %>
          </div>
          <div class="w-full min-w-0 flex-1">
            <%= render Utilities::ScoreProgressBarComponent.new(
              score: item[:value],
              label: item[:label],
              match_level: @match_level
            ) %>
            <% explanation = generate_explanations[item[:label].downcase.to_sym] %>
            <% if explanation.present? %>
              <button
                type="button"
                class="mt-2 text-xs text-ink-3 dark:text-ink-3-on-dark hover:text-ink-2 dark:hover:text-ink-2-on-dark flex items-center gap-1 transition-colors"
                data-action="expandable-explanation#toggle"
                aria-expanded="false"
                aria-controls="explanation-<%= index %>"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" fill-rule="evenodd" />
                </svg>
                <span>Why this score?</span>
              </button>
              <div
                id="explanation-<%= index %>"
                class="hidden mt-2 p-3 bg-surface-2 dark:bg-surface-2-on-dark/50 rounded-md"
                data-expandable-explanation-target="explanation"
              >
                <p class="text-xs leading-relaxed text-ink-2 dark:text-ink-2-on-dark">
                  <%= explanation %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
