<div class="flex flex-col gap-1">
  <div class="flex items-center justify-between">
    <label class="text-sm font-medium text-zinc-700 dark:text-zinc-300"><%= label %></label>
    <span class="text-sm font-bold <%= match_score_text_class(match_level) %>"><%= score %>%</span>
  </div>
  <div class="relative h-2 overflow-hidden rounded-full <%= progress_bar_bg_class %>">
    <div
      class="h-full rounded-full transition-all duration-300 <%= progress_bar_color_class %>"
      style="width: <%= score %>%;"
      role="progressbar"
      aria-valuenow="<%= score %>"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="<%= label %> score: <%= score %>%"
    ></div>
  </div>
</div>
