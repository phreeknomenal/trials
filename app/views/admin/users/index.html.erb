<div class="px-5 lg:px-12 py-10">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-ink dark:text-ink-on-dark">Users</h1>
    <p class="mt-1 text-sm text-ink-3 dark:text-ink-3-on-dark">
      <%= pluralize(@pagy.count, "user") %> &middot; <%= User.staff.count %> staff &middot; read-only
    </p>
  </div>

  <div class="overflow-x-auto border border-line dark:border-line-on-dark rounded-lg">
    <table class="w-full text-sm">
      <thead class="bg-surface-2 dark:bg-surface-on-dark/50 text-left">
        <tr>
          <th class="px-4 py-3 font-semibold text-ink-2 dark:text-ink-2-on-dark">Email</th>
          <th class="px-4 py-3 font-semibold text-ink-2 dark:text-ink-2-on-dark">Role</th>
          <th class="px-4 py-3 font-semibold text-ink-2 dark:text-ink-2-on-dark">Profile</th>
          <th class="px-4 py-3 font-semibold text-ink-2 dark:text-ink-2-on-dark">Joined</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line dark:divide-line-on-dark">
        <% @users.each do |user| %>
          <tr>
            <td class="px-4 py-3 text-ink dark:text-ink-on-dark"><%= user.email %></td>
            <td class="px-4 py-3">
              <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= user.staff? ? "bg-warn/10 text-warn dark:bg-warn-on-dark/40 dark:text-warn-on-dark" : "bg-surface-2 text-ink-3 dark:bg-surface-on-dark dark:text-ink-3-on-dark" %>">
                <%= user.role %>
              </span>
            </td>
            <td class="px-4 py-3 text-ink-3 dark:text-ink-3-on-dark">
              <% if user.profile.nil? %>
                <span class="text-ink-4">none</span>
              <% elsif user.profile.onboarded? %>
                Onboarded
              <% else %>
                Incomplete
              <% end %>
            </td>
            <td class="px-4 py-3 text-ink-3 dark:text-ink-4-on-dark"><%= user.created_at.to_date.to_fs(:long) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render Shared::PaginationComponent.new(
        pagy: @pagy,
        path_for: ->(page) { admin_users_path(page: page) },
        unit: "user"
      ) %>
</div>
