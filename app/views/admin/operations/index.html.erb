<div class="px-5 lg:px-12 py-10 flex flex-col gap-5">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-1">
      <h1 class="font-primary text-2xl font-bold tracking-tight text-ink dark:text-ink-on-dark">
        Generation queues
      </h1>
      <%# From the board, and the reason this screen is worth opening: every row
          is somebody waiting. %>
      <p class="text-meta text-ink-3 dark:text-ink-3-on-dark">
        Every row is one study waiting on a paid Claude call. A patient asked for each of these.
      </p>
    </div>

    <%# A link, not a button. The page is counts read on request, so reloading
        it is the whole of refreshing it. %>
    <%= link_to admin_operations_path, class: "#{Buttons::ButtonStyles.classes("secondary", size: "px-4 py-2 text-meta")}" do %>
      <%= render Utilities::IconComponent.new("spinner", size: 4) %>
      Refresh
    <% end %>
  </div>

  <%# The healthy state is one line for the whole page, not one per queue: a
      healthy prescreen queue must not say "nothing stuck" while summaries fail.
      The sections below render only when they have rows. %>
  <% if @healthy %>
    <section class="rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-5 flex items-center gap-3.5">
      <span class="w-10 h-10 shrink-0 rounded-chip bg-good/12 dark:bg-good-on-dark/20 text-good dark:text-good-on-dark flex items-center justify-center">
        <%= render Utilities::IconComponent.new("check", size: 5) %>
      </span>
      <div class="flex flex-col gap-0.5">
        <span class="text-body font-semibold text-ink dark:text-ink-on-dark">Nothing stuck or failed</span>
        <span class="text-meta text-ink-3 dark:text-ink-3-on-dark">
          <%= @feeds.map { |feed| pluralize(feed.completed_count, feed.noun) }.to_sentence %> cached,
          <%= @feeds.sum { |feed| feed.pending.size } %> generating now.
        </span>
      </div>
    </section>
  <% end %>

  <% @feeds.each do |feed| %>
    <%= render "feed", feed: feed %>
  <% end %>

  <%# Retrying costs a paid Claude call and goes through the same limits as a
      patient's own request, so an operator clearing a backlog spends their own
      hourly allowance. Better said than discovered. %>
  <% unless @healthy %>
    <p class="text-xs text-ink-3 dark:text-ink-3-on-dark">
      Each retry is a fresh Claude call and counts against the same hourly and daily
      limits as a patient's own request.
    </p>
  <% end %>
</div>
