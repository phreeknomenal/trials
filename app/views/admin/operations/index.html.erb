<div class="px-5 lg:px-12 py-10 space-y-8">
  <div>
    <h1 class="text-2xl font-bold text-ink dark:text-ink-on-dark">Operations</h1>
    <p class="mt-1 text-sm text-ink-3 dark:text-ink-3-on-dark">Health of readable summary generation.</p>
  </div>

  <% if @failed.none? && @stale.none? %>
    <div class="rounded-lg border border-good/30 dark:border-good-on-dark bg-good/10 dark:bg-good-on-dark/20 p-4">
      <p class="text-sm text-good dark:text-good-on-dark">
        No failed or stuck summaries. <%= pluralize(@completed_count, "summary") %> completed,
        <%= @pending.size %> currently generating.
      </p>
    </div>
  <% end %>

  <% if @stale.any? %>
    <section>
      <h2 class="text-lg font-semibold text-ink dark:text-ink-on-dark mb-1">Stuck</h2>
      <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mb-3">
        Pending for more than <%= distance_of_time_in_words(ReadableStudySummary::STALE_AFTER) %>.
        The job that owned these is gone, most likely a dyno restart.
      </p>
      <div class="border border-warn/30 dark:border-warn-on-dark rounded-lg divide-y divide-warn dark:divide-warn-on-dark">
        <% @stale.each do |summary| %>
          <div class="p-4 flex items-center justify-between gap-4">
            <span class="font-mono text-sm text-ink dark:text-ink-on-dark"><%= summary.nct_id %></span>
            <span class="text-xs text-ink-3">last updated <%= time_ago_in_words(summary.updated_at) %> ago</span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @failed.any? %>
    <section>
      <h2 class="text-lg font-semibold text-ink dark:text-ink-on-dark mb-3">Failed</h2>
      <div class="border border-crit/30 dark:border-crit-on-dark rounded-lg divide-y divide-crit dark:divide-crit-on-dark">
        <% @failed.each do |summary| %>
          <div class="p-4">
            <div class="flex items-center justify-between gap-4 mb-1">
              <span class="font-mono text-sm text-ink dark:text-ink-on-dark"><%= summary.nct_id %></span>
              <span class="text-xs text-ink-3"><%= time_ago_in_words(summary.updated_at) %> ago</span>
            </div>
            <p class="text-sm text-crit dark:text-crit-on-dark"><%= summary.error_message.presence || "No error message recorded." %></p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @pending.any? %>
    <section>
      <h2 class="text-lg font-semibold text-ink dark:text-ink-on-dark mb-3">In progress</h2>
      <div class="border border-line dark:border-line-on-dark rounded-lg divide-y divide-line dark:divide-line-on-dark">
        <% @pending.each do |summary| %>
          <div class="p-4 flex items-center justify-between gap-4">
            <span class="font-mono text-sm text-ink dark:text-ink-on-dark"><%= summary.nct_id %></span>
            <span class="text-xs text-ink-3">started <%= time_ago_in_words(summary.created_at) %> ago</span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
