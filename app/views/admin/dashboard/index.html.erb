<div class="px-5 lg:px-12 py-10 space-y-10">
  <div>
    <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">Overview</h1>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">Signed in as <%= current_user.email %> (<%= current_user.role %>).</p>
  </div>

  <section>
    <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-3">People</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <%= render Admin::StatCardComponent.new(label: "Users", value: @users_total, hint: "#{@staff_count} staff") %>
      <%= render Admin::StatCardComponent.new(label: "New in 30 days", value: @users_recent) %>
      <%= render Admin::StatCardComponent.new(label: "Profiles", value: @profiles_total) %>
      <%= render Admin::StatCardComponent.new(label: "Onboarded", value: @profiles_onboarded,
            hint: @profiles_total.zero? ? "no profiles yet" : "#{(@profiles_onboarded * 100.0 / @profiles_total).round}% of profiles") %>
    </div>
  </section>

  <section>
    <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-3">Summary generation</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <%= render Admin::StatCardComponent.new(label: "Completed", value: @summaries_by_status.fetch("completed", 0)) %>
      <%= render Admin::StatCardComponent.new(label: "Failed", value: @summaries_failed, tone: :alert) %>
      <%= render Admin::StatCardComponent.new(label: "Stuck", value: @summaries_stale, tone: :alert,
            hint: "pending over #{distance_of_time_in_words(ReadableStudySummary::STALE_AFTER)}") %>
      <%= render Admin::StatCardComponent.new(label: "Pending", value: @summaries_by_status.fetch("pending", 0)) %>
    </div>
    <% if @summaries_failed.positive? || @summaries_stale.positive? %>
      <p class="mt-3 text-sm"><%= link_to "View details on the operations page →", admin_operations_path, class: "text-lavender-600 hover:text-lavender-700 font-medium" %></p>
    <% end %>
  </section>

  <section>
    <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-3">Content</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <%= render Admin::StatCardComponent.new(label: "Testimonials", value: @testimonials_total,
            hint: "#{@testimonials_published} published") %>
      <%= render Admin::StatCardComponent.new(label: "Seeded placeholders", value: @testimonials_placeholder,
            hint: @testimonials_placeholder.positive? ? "replace before public launch" : nil) %>
      <%= render Admin::StatCardComponent.new(label: "Saved trials", value: @saved_trials_total) %>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-1">Signups, last <%= Admin::DashboardController::SIGNUP_WINDOW %> days</h2>
      <p class="text-xs text-zinc-500 mb-3">Grouped by UTC date.</p>
      <%= render Admin::BarChartComponent.new(series: @signups_by_day, empty_message: "No signups in this window.") %>
    </section>

    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-3">Saved trials by status</h2>
      <%= render Admin::BarChartComponent.new(series: @saved_trials_by_status, empty_message: "No saved trials yet.") %>
    </section>
  </div>
</div>
