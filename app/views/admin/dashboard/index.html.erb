<div class="px-5 lg:px-12 py-10 flex flex-col gap-8">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-1">
      <h1 class="font-primary text-2xl font-bold tracking-tight text-ink dark:text-ink-on-dark">Overview</h1>
      <%# On the board, and worth saying: every number here is a COUNT run on
          request. Nothing is cached, so nothing can be quietly out of date. %>
      <p class="text-meta text-ink-3 dark:text-ink-3-on-dark">Counts are live. Nothing here is cached.</p>
    </div>
    <p class="text-meta text-ink-3 dark:text-ink-3-on-dark tabular-nums">
      <%= Time.current.strftime("%A %-d %B %Y, %H:%M") %>
    </p>
  </div>

  <%# Four headline counts, per the board. It had eleven cards across three
      sections, which is a list of every number the controller happens to load
      rather than the four somebody opens this page for. %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <%= render Admin::StatCardComponent.new(
          label: "Users", value: number_with_delimiter(@users_total),
          hint: "#{@users_recent} joined in the last 30 days · #{@staff_count} staff"
        ) %>

    <%= render Admin::StatCardComponent.new(
          label: "Profiles onboarded", value: number_with_delimiter(@profiles_onboarded),
          hint: @profiles_total.zero? ? "no profiles yet" : "of #{number_with_delimiter(@profiles_total)} · #{(@profiles_onboarded * 100.0 / @profiles_total).round}%"
        ) %>

    <%= render Admin::StatCardComponent.new(
          label: "Saved trials", value: number_with_delimiter(@saved_trials_total),
          hint: "Across #{pluralize(@saved_trials_users, "user")}"
        ) %>

    <%= render Admin::StatCardComponent.new(
          label: "Readable summaries", value: number_with_delimiter(@summaries_completed),
          hint: "Cached, one per study"
        ) %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <section class="flex flex-col gap-2">
      <h2 class="font-primary text-body font-bold text-ink dark:text-ink-on-dark">
        Sign ups, last <%= Admin::DashboardController::SIGNUP_WINDOW %> days
      </h2>
      <p class="text-xs text-ink-3 dark:text-ink-3-on-dark">
        One bar per day.
        <%= pluralize(@signups_in_window, "sign up") %> in this window,
        <%= (@signups_in_window / Admin::DashboardController::SIGNUP_WINDOW.to_f).round(1) %> a day.
        Grouped by UTC date.
      </p>
      <%= render Admin::BarChartComponent.new(series: @signups_by_day, empty_message: "No signups in this window.") %>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="font-primary text-body font-bold text-ink dark:text-ink-on-dark">Saved trials by status</h2>
      <p class="text-xs text-ink-3 dark:text-ink-3-on-dark">
        Ordered by count. The order is the story, so there is no legend.
      </p>
      <%= render Admin::BarChartComponent.new(series: @saved_trials_by_status, empty_message: "No saved trials yet.") %>
    </section>
  </div>

  <%# One block per paid generation queue, from the same list the operations
      page reads, so a new queue cannot be on one page and missing from the other. %>
  <% @feeds.each do |feed| %>
    <section class="flex flex-col gap-3">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-primary text-body font-bold text-ink dark:text-ink-on-dark"><%= feed.title %></h2>
        <%= link_to "Open operations", admin_operations_path(anchor: feed.dom_id),
              class: "text-meta font-semibold text-sky-700 dark:text-sky-300 hover:underline" %>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <%= render Admin::StatCardComponent.new(label: "Completed", value: feed.completed_count) %>
        <%= render Admin::StatCardComponent.new(label: "Pending", value: feed.pending.size + feed.stale.size) %>
        <%= render Admin::StatCardComponent.new(label: "Stale", value: feed.stale.size, tone: :alert,
              hint: "pending over #{distance_of_time_in_words(GeneratedPerStudy::STALE_AFTER)}") %>
        <%= render Admin::StatCardComponent.new(label: "Failed", value: feed.failed.size, tone: :alert) %>
      </div>
    </section>
  <% end %>

  <%# The content counts the board leaves off the overview. Kept, smaller: the
      seeded placeholder count is the one number that has already been wrong in
      public, and it belongs where somebody will see it. %>
  <section class="flex flex-col gap-3">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="font-primary text-body font-bold text-ink dark:text-ink-on-dark">Content</h2>
      <%= link_to "Open testimonials", admin_testimonials_path,
            class: "text-meta font-semibold text-sky-700 dark:text-sky-300 hover:underline" %>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <%= render Admin::StatCardComponent.new(label: "Testimonials", value: @testimonials_total,
            hint: "#{@testimonials_published} published") %>
      <%= render Admin::StatCardComponent.new(label: "Seeded placeholders", value: @testimonials_placeholder,
            hint: @testimonials_placeholder.positive? ? "held back, never public" : nil) %>
    </div>
  </section>
</div>
