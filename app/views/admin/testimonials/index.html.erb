<div class="px-5 lg:px-12 py-10">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-ink dark:text-ink-on-dark">Testimonials</h1>
      <p class="mt-1 text-sm text-ink-3 dark:text-ink-3-on-dark">
        <%= pluralize(@testimonials.size, "testimonial") %> &middot;
        <%= @testimonials.count(&:published?) %> published &middot;
        <%= @testimonials.count(&:placeholder?) %> seeded placeholder
      </p>
    </div>
    <%= link_to "New testimonial", new_admin_testimonial_path,
          class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-navy-600 text-white hover:bg-navy-700" %>
  </div>

  <% if @testimonials.any? %>
    <div class="overflow-x-auto border border-line dark:border-line-on-dark rounded-lg">
      <table class="w-full text-sm">
        <thead class="bg-surface-2 dark:bg-surface-on-dark/50 text-left">
          <tr>
            <th class="px-4 py-3 font-semibold text-ink-2 dark:text-ink-2-on-dark">#</th>
            <th class="px-4 py-3 font-semibold text-ink-2 dark:text-ink-2-on-dark">Author</th>
            <th class="px-4 py-3 font-semibold text-ink-2 dark:text-ink-2-on-dark">Quote</th>
            <th class="px-4 py-3 font-semibold text-ink-2 dark:text-ink-2-on-dark">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line dark:divide-line-on-dark">
          <% @testimonials.each do |testimonial| %>
            <tr>
              <td class="px-4 py-3 text-ink-3 dark:text-ink-4-on-dark"><%= testimonial.position %></td>
              <td class="px-4 py-3">
                <div class="font-medium text-ink dark:text-ink-on-dark"><%= testimonial.author_name %></div>
                <div class="text-ink-3 dark:text-ink-4-on-dark"><%= testimonial.author_role %></div>
              </td>
              <td class="px-4 py-3 text-ink-2 dark:text-ink-2-on-dark max-w-md"><%= truncate(testimonial.quote, length: 90) %></td>
              <td class="px-4 py-3">
                <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= testimonial.published? ? "bg-good/10 text-good dark:bg-good-on-dark/40 dark:text-good-on-dark" : "bg-surface-2 text-ink-3 dark:bg-surface-on-dark dark:text-ink-3-on-dark" %>">
                  <%= testimonial.published? ? "Published" : "Draft" %>
                </span>
                <% if testimonial.placeholder? %>
                  <span class="ml-1 inline-block px-2 py-0.5 rounded text-xs font-medium bg-warn/10 text-warn dark:bg-warn-on-dark/40 dark:text-warn-on-dark"
                        title="Seeded content. Deleting it is temporary — the next deploy recreates it.">Seeded</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <%# IconComponent renders its svg aria-hidden, so the accessible name
                    has to live on the control itself. %>
                <div class="flex items-center justify-end gap-1">
                  <%= link_to edit_admin_testimonial_path(testimonial),
                        class: "p-2 rounded text-warn hover:text-warn dark:text-warn-on-dark dark:hover:text-warn-on-dark hover:bg-surface-2 dark:hover:bg-surface-on-dark transition-colors",
                        title: "Edit", "aria-label": "Edit testimonial from #{testimonial.author_name}" do %>
                    <%= render Utilities::IconComponent.new("pencil", size: 5) %>
                  <% end %>

                  <%= button_to admin_testimonial_path(testimonial), method: :delete,
                        form: {data: {turbo_confirm: testimonial.placeholder? ? "This is seeded placeholder content. Deleting it is temporary — the next deploy will recreate it. Continue?" : "Delete this testimonial?"}, class: "inline"},
                        class: "p-2 rounded text-crit hover:text-crit dark:text-crit-on-dark dark:hover:text-crit-on-dark hover:bg-surface-2 dark:hover:bg-surface-on-dark cursor-pointer transition-colors",
                        title: "Delete", "aria-label": "Delete testimonial from #{testimonial.author_name}" do %>
                    <%= render Utilities::IconComponent.new("trash", size: 5) %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-ink-3 dark:text-ink-3-on-dark">No testimonials yet.</p>
  <% end %>
</div>
