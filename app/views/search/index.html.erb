<section class="px-5 lg:px-24 py-16 border-b border-zinc-200 dark:border-zinc-700">
  <%= render Page::HeaderComponent.new(
    heading: "Search Clinical Trials",
    subheading: "Find clinical trials that match your health needs and location",
    position: :left
  ) %>
</section>

<div class="min-h-screen">
  <div class="px-5 lg:px-24 py-10 lg:py-18">
    <!-- Search Form -->
    <div class="border border-zinc-200 dark:border-zinc-700 rounded-lg p-6 mb-8">
      <%= form_with url: search_index_path, method: :get, class: "space-y-6" do |f| %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Condition -->
          <div class="form-group">
            <%= f.label :condition, "Condition", class: "block text-sm font-medium text-zinc-900 dark:text-zinc-300 mb-2" %>
            <%= f.select :condition, 
                options_for_select(@conditions.pluck(:name, :name), params[:condition]),
                { include_blank: "Select a condition" },
                { class: "block p-2 w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 placeholder:text-zinc-500 dark:placeholder:text-zinc-400 text-base text-zinc-900 dark:text-zinc-300 rounded focus:ring-lavender-600 focus:border-lavender-600" } 
            %>
          </div>

          <!-- Location -->
          <div class="form-group">
            <%= f.label :location, "Location (City, State)", class: "block text-sm font-medium text-zinc-900 dark:text-zinc-300 mb-2" %>
            <%= f.text_field :location, 
                value: params[:location],
                placeholder: "e.g., Boston, MA",
                class: "block w-full form-control bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-zinc-300 text-base rounded focus:ring-lavender-600 focus:border-lavender-600 p-2" 
            %>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex gap-4">
          <%= f.submit "Search Trials", class: "inline-flex items-center gap-1 px-4 font-medium py-2 rounded-md transition-colors cursor-pointer border border-lavender-600 text-white bg-lavender-600 hover:border-coral-600 hover:bg-coral-600" %>
          <% if params[:condition].present? || params[:location].present? %>
            <%= link_to "Clear Filters", search_index_path, class: "inline-flex items-center px-4 py-2 text-base font-medium text-zinc-700 dark:text-zinc-300 hover:text-lavender-600" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Error Message -->
    <% if @error.present? %>
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-8">
        <p class="text-red-800 dark:text-red-200"><%= @error %></p>
      </div>
    <% end %>

    <!-- Search Results -->
    <% if @studies.present? %>
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-300 mb-2">
          Search Results
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400">
          Showing <%= number_with_delimiter(@total_count) %> clinical trials on this page
        </p>
      </div>

      <!-- Results Grid -->
      <div class="space-y-8 mb-8">
        <% @studies.each do |study| %>
          <%= render Page::Cards::StudyCardComponent.new(study: study) %>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @current_page > 1 || @has_next_page %>
        <div class="flex justify-center gap-4 items-center">
          <% if @current_page > 1 %>
            <%= link_to "Previous", search_index_path(params.permit!.merge(page: @current_page - 1)), 
                class: "px-4 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded hover:bg-zinc-50 dark:hover:bg-zinc-700" %>
          <% end %>

          <span class="text-sm text-zinc-600 dark:text-zinc-400">
            Page <%= @current_page %>
          </span>

          <% if @has_next_page %>
            <%= link_to "Next", search_index_path(params.permit!.merge(page: @current_page + 1)),
                class: "px-4 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded hover:bg-zinc-50 dark:hover:bg-zinc-700" %>
          <% end %>
        </div>
      <% end %>

    <% elsif params[:condition].present? || params[:location].present? || params[:status].present? || params[:min_age].present? || params[:max_age].present? %>
      <!-- No Results -->
      <div class="bg-zinc-100 dark:bg-zinc-800 rounded-lg p-8 text-center">
        <div class="text-zinc-400 dark:text-zinc-500 mb-4">
          <%= render Utilities::IconComponent.new("search", size: 16) %>
        </div>
        <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-300 mb-2">
          No trials found
        </h3>
        <p class="text-zinc-600 dark:text-zinc-400 mb-4">
          Try adjusting your search criteria to find more results.
        </p>
        <%= link_to "Clear All Filters", search_index_path, class: "text-lavender-600 hover:text-lavender-700 font-medium" %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="bg-zinc-100 dark:bg-zinc-800 rounded-lg p-8 text-center">
        <div class="w-24 h-24 mx-auto text-zinc-400 dark:text-zinc-500 mb-4">
          <%= render Utilities::IconComponent.new("search", size: 16) %>
        </div>
        <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-300 mb-2">
          Start Your Search
        </h3>
        <p class="text-zinc-600 dark:text-zinc-400">
          Use the filters above to find clinical trials that match your needs.
        </p>
      </div>
    <% end %>
  </div>
</div>

