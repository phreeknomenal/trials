<section class="px-5 lg:px-24 py-16 border-b border-line dark:border-line-on-dark">
  <%= render Page::HeaderComponent.new(
    heading: "Search Clinical Trials",
    subheading: "Find clinical trials that match your health needs and location",
    position: :left
  ) %>
</section>

<div class="min-h-screen">
  <div class="px-5 lg:px-24 py-10 lg:py-18">
    <!-- Search Form -->
    <div class="border border-line dark:border-line-on-dark rounded-lg p-6 mb-8">
      <%= form_with url: search_index_path, method: :get, class: "space-y-6" do |f| %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Condition -->
          <div class="form-group">
            <%= f.label :condition, "Condition", class: "block text-sm font-medium text-ink dark:text-ink-2-on-dark mb-2" %>
            <%= f.select :condition, 
                options_for_select(@conditions.pluck(:name, :name), params[:condition]),
                { include_blank: "Select a condition" },
                { class: "block p-2 w-full bg-surface dark:bg-paper-on-dark border border-line dark:border-line-on-dark placeholder:text-ink-3 dark:placeholder:text-ink-3-on-dark text-base text-ink dark:text-ink-2-on-dark rounded focus:ring-sky-500 focus:border-navy-600" } 
            %>
          </div>

          <!-- Location -->
          <div class="form-group">
            <%= f.label :location, "Location (City, State)", class: "block text-sm font-medium text-ink dark:text-ink-2-on-dark mb-2" %>
            <%= f.text_field :location, 
                value: params[:location],
                placeholder: "e.g., Boston, MA",
                class: "block w-full form-control bg-surface dark:bg-paper-on-dark border border-line dark:border-line-on-dark text-ink dark:text-ink-2-on-dark text-base rounded focus:ring-sky-500 focus:border-navy-600 p-2" 
            %>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex gap-4">
          <%= f.submit "Search Trials", class: "inline-flex items-center gap-1 px-4 font-medium py-2 rounded-md transition-colors cursor-pointer border border-navy-600 text-white bg-navy-600 hover:border-navy-700 hover:bg-navy-700" %>
          <% if params[:condition].present? || params[:location].present? %>
            <%= link_to "Clear Filters", search_index_path, class: "inline-flex items-center px-4 py-2 text-base font-medium text-ink-2 dark:text-ink-2-on-dark hover:text-sky-600" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Error Message -->
    <% if @error.present? %>
      <div class="bg-crit/10 dark:bg-crit-on-dark/20 border border-crit/30 dark:border-crit-on-dark rounded-lg p-4 mb-8">
        <p class="text-crit dark:text-crit-on-dark"><%= @error %></p>
      </div>
    <% end %>

    <!-- Search Results -->
    <% if @studies.present? %>
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-ink dark:text-ink-2-on-dark mb-2">
          Search Results
        </h2>
        <p class="text-ink-3 dark:text-ink-3-on-dark">
          Showing <%= number_with_delimiter(@total_count) %> clinical trials on this page
        </p>
      </div>

      <!-- Results Grid -->
      <div class="space-y-8 mb-8">
        <% @studies.each do |study| %>
          <%= render Page::Cards::StudyCardComponent.new(study: study) %>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @current_page > 1 || @has_next_page %>
        <div class="flex justify-center gap-4 items-center">
          <% if @current_page > 1 %>
            <%= link_to "Previous", search_index_path(pagination_params.merge(page: @current_page - 1)), 
                class: "px-4 py-2 text-sm font-medium text-ink-2 dark:text-ink-2-on-dark bg-surface dark:bg-surface-on-dark border border-line dark:border-line-on-dark rounded hover:bg-surface-2 dark:hover:bg-surface-2-on-dark" %>
          <% end %>

          <span class="text-sm text-ink-3 dark:text-ink-3-on-dark">
            Page <%= @current_page %>
          </span>

          <% if @has_next_page %>
            <%= link_to "Next", search_index_path(pagination_params.merge(page: @current_page + 1)),
                class: "px-4 py-2 text-sm font-medium text-ink-2 dark:text-ink-2-on-dark bg-surface dark:bg-surface-on-dark border border-line dark:border-line-on-dark rounded hover:bg-surface-2 dark:hover:bg-surface-2-on-dark" %>
          <% end %>
        </div>
      <% end %>

    <% elsif params[:condition].present? || params[:location].present? || params[:status].present? || params[:min_age].present? || params[:max_age].present? %>
      <!-- No Results -->
      <div class="bg-surface-2 dark:bg-surface-on-dark rounded-lg p-8 text-center">
        <div class="text-ink-4 dark:text-ink-4-on-dark mb-4">
          <%= render Utilities::IconComponent.new("search", size: 12) %>
        </div>
        <h3 class="text-xl font-semibold text-ink dark:text-ink-2-on-dark mb-2">
          No trials found
        </h3>
        <p class="text-ink-3 dark:text-ink-3-on-dark mb-4">
          Try adjusting your search criteria to find more results.
        </p>
        <%= link_to "Clear All Filters", search_index_path, class: "text-sky-600 hover:text-sky-700 font-medium" %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="bg-surface-2 dark:bg-surface-on-dark rounded-lg p-8 text-center">
        <div class="w-24 h-24 mx-auto text-ink-4 dark:text-ink-4-on-dark mb-4">
          <%= render Utilities::IconComponent.new("search", size: 24) %>
        </div>
        <h3 class="text-xl font-semibold text-ink dark:text-ink-2-on-dark mb-2">
          Start Your Search
        </h3>
        <p class="text-ink-3 dark:text-ink-3-on-dark">
          Use the filters above to find clinical trials that match your needs.
        </p>
      </div>
    <% end %>
  </div>
</div>

