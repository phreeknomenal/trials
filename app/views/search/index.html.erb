<% searched = @studies.present? || params[:condition].present? || params[:location].present? %>

<div class="<%= Layout::PageWidth::CONTAINER %> py-8 lg:py-12">

  <%# The search bar leads the page rather than a heading over a form. On a
      results page the compact variant is the right one: the person has already
      said what they want and is adjusting it. %>
  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-bold tracking-tight text-ink dark:text-ink-on-dark mb-4">
      <%= @profile ? "Find your trials" : "Search clinical trials" %>
    </h1>
    <%= render Shared::SearchBarComponent.new(
          url: search_index_path,
          variant: :compact,
          conditions: @conditions,
          condition: params[:condition] || @default_condition,
          location: params[:location]
        ) %>
  </div>

  <% if @error.present? %>
    <div class="rounded-card border border-crit/30 dark:border-crit-on-dark bg-crit/10 dark:bg-crit-on-dark/20 p-4 mb-6">
      <p class="text-crit dark:text-crit-on-dark"><%= @error %></p>
    </div>
  <% end %>

  <% if @studies.present? %>
    <div class="flex flex-col lg:flex-row gap-8">

      <%# Desktop sidebar. Below lg the same partial renders inside the sheet. %>
      <aside class="hidden lg:block w-65 shrink-0">
        <div class="sticky top-6">
          <%= render "search/filters", id: "filters-desktop" %>
        </div>
      </aside>

      <div class="min-w-0 flex-1">

        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
          <div>
            <p class="text-lg font-bold text-ink dark:text-ink-on-dark">
              <%= number_with_delimiter(@total_count) %>
              <%= "study".pluralize(@total_count) %>
              <%= "matching your filters" if @refined %>
            </p>
            <% if @profile %>
              <p class="text-sm text-ink-3 dark:text-ink-3-on-dark">Scored against your profile.</p>
            <% else %>
              <p class="text-sm text-ink-3 dark:text-ink-3-on-dark">
                <%= link_to "Sign in", new_user_session_path, class: "font-semibold text-sky-700 dark:text-sky-300 hover:underline" %>
                to see how well each one fits you.
              </p>
            <% end %>
          </div>

          <div class="flex items-center gap-2">
            <%# The filter trigger is a details element rather than a modal, so it
                works with no JavaScript and closes on Escape for free. %>
            <details class="lg:hidden relative">
              <summary class="<%= Buttons::ButtonStyles.classes("secondary", size: "px-3 py-2 text-sm") %> list-none">
                <%= render Utilities::IconComponent.new("filter_1", size: 4) %>
                Filters<%= " · on" if filters_active? %>
              </summary>
              <div class="absolute right-0 z-20 mt-2 w-70 rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-4 shadow-lg">
                <%= render "search/filters", id: "filters-sheet" %>
              </div>
            </details>

            <%# Sorting by match needs a profile to match against. %>
            <% if @profile %>
              <%= form_with url: search_index_path, method: :get, class: "flex items-center gap-2" do |f| %>
                <% pagination_params.except(:sort_by).each do |key, value| %>
                  <% Array(value).each do |v| %>
                    <%= hidden_field_tag "#{key}#{"[]" if value.is_a?(Array)}", v %>
                  <% end %>
                <% end %>
                <%= f.label :sort_by, "Sort", class: "text-sm font-medium text-ink-2 dark:text-ink-2-on-dark" %>
                <%= f.select :sort_by,
                      options_for_select([["Best match for you", "score"], ["The registry's own order", "relevance"]],
                        params[:sort_by].presence || "score"),
                      {include_blank: false},
                      {class: Forms::FieldStyles.input(extra: "py-1.5 text-sm w-auto")} %>
                <%= f.button "Sort", type: "submit", class: Buttons::ButtonStyles.classes("secondary", size: "px-3 py-1.5 text-sm") %>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="flex flex-col gap-4 mb-8">
          <% @studies.each do |study| %>
            <%= render Page::Cards::ResultCardComponent.new(
                  study: study,
                  saved_trial: @saved_trials_by_nct_id&.dig(study[:nct_id]),
                  signed_in: user_signed_in?
                ) %>
          <% end %>
        </div>

        <% if @current_page > 1 || @has_next_page %>
          <nav class="flex items-center justify-center gap-3" aria-label="Results pages">
            <% if @current_page > 1 %>
              <%= link_to "Previous", search_index_path(pagination_params.merge(page: @current_page - 1, page_token: @prev_page_token).compact),
                    class: Buttons::ButtonStyles.classes("secondary", size: "px-4 py-2 text-sm") %>
            <% end %>
            <span class="text-sm text-ink-3 dark:text-ink-3-on-dark">Page <%= @current_page %></span>
            <% if @has_next_page %>
              <%= link_to "Next", search_index_path(pagination_params.merge(page: @current_page + 1, page_token: @next_page_token).compact),
                    class: Buttons::ButtonStyles.classes("secondary", size: "px-4 py-2 text-sm") %>
            <% end %>
          </nav>
        <% end %>
      </div>
    </div>

  <% elsif searched %>
    <%# The empty state names what was actually searched for, and every way out
        of it is something the app can really do. %>
    <div class="rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-8 lg:p-12 max-w-2xl">
      <div class="text-ink-4 dark:text-ink-4-on-dark mb-4">
        <%= render Utilities::IconComponent.new("file_search", size: 12) %>
      </div>
      <h2 class="text-xl font-bold text-ink dark:text-ink-on-dark mb-2">
        No studies found<%= " for #{params[:condition]}" if params[:condition].present? %><%= " near #{params[:location]}" if params[:location].present? %>
      </h2>
      <p class="text-ink-3 dark:text-ink-3-on-dark mb-6 leading-relaxed">
        <% if filters_active? %>
          The search found studies, but none of them match the filters you have set.
        <% else %>
          The registry has nothing recruiting under those terms right now. That changes often.
        <% end %>
      </p>
      <div class="flex flex-wrap gap-3">
        <% if filters_active? %>
          <%= link_to "Clear the filters",
                search_index_path(condition: params[:condition], location: params[:location]),
                class: Buttons::ButtonStyles.classes("primary", size: "px-4 py-2 text-sm") %>
        <% end %>
        <% if params[:location].present? %>
          <%= link_to "Search everywhere instead",
                search_index_path(condition: params[:condition]),
                class: Buttons::ButtonStyles.classes("secondary", size: "px-4 py-2 text-sm") %>
        <% end %>
        <%= link_to "Start a new search", search_index_path,
              class: Buttons::ButtonStyles.classes("quiet", size: "px-4 py-2 text-sm") %>
      </div>
    </div>

  <% else %>
    <div class="rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-8 lg:p-12 max-w-2xl">
      <h2 class="text-xl font-bold text-ink dark:text-ink-on-dark mb-2">Start with a condition</h2>
      <p class="text-ink-3 dark:text-ink-3-on-dark leading-relaxed">
        Pick what you are looking for above, and add a location if you want studies near you.
      </p>
    </div>
  <% end %>
</div>
