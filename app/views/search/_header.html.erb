<section class="px-5 lg:px-44 py-16 border-b border-zinc-200 dark:border-zinc-700">
  <%= render Page::HeaderComponent.new(
    heading: study[:title],
    position: :left
  ) %>
  <% if study[:nct_id].present? %>
    <div class="flex items-start gap-2 mt-3">
      <%= render Utilities::BadgeComponent.new(
        text: study[:nct_id],
        variant: :nct_id,
        size: :md
      ) %>
      <% if study[:status].present? %>
        <%= render Utilities::BadgeComponent.new(
          status: study[:status],
          size: :md
        ) %>
      <% end %>
    </div>
  <% end %>
  
  <% if study[:why_stopped].present? %>
    <div class="mt-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
      <p class="text-sm font-medium text-red-800 dark:text-red-200">
        <strong>Why Stopped:</strong> <%= study[:why_stopped] %>
      </p>
    </div>
  <% end %>
</section>