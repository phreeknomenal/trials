<%# One expression for the section and its sidebar link, so the two cannot
    disagree and leave an anchor pointing at nothing. %>
<% who_runs_it = @study.present? && (@study[:sponsor].present? ||
                                    @study[:central_contacts].present? ||
                                    @study[:overall_officials].present?) %>

<% if @error.present? %>
  <!-- Error State -->
  <div class="min-h-screen flex items-center justify-center px-5">
    <div class="bg-crit/10 dark:bg-crit-on-dark/20 border border-crit/30 dark:border-crit-on-dark rounded-panel p-8 max-w-2xl w-full text-center">
      <div class="text-crit dark:text-crit-on-dark mb-4">
        <%= render Utilities::IconComponent.new("exclamation_circle", size: 12) %>
      </div>
      <h2 class="text-2xl font-bold text-crit dark:text-crit-on-dark mb-2">Error Loading Trial</h2>
      <p class="text-crit dark:text-crit-on-dark mb-6"><%= @error %></p>
      <%= link_to "Back to search", search_index_path, class: "inline-flex items-center text-sky-600 hover:text-sky-700 font-medium" %>
    </div>
  </div>
<% elsif @study.present? %>
  <%# The board has no full-width banner. Its first panel is the study header,
      inside the main column, which is why this page read as a different one: a
      banner spanning the viewport above a two-column layout is page chrome, and
      this is the study. %>
  <section class="<%= Layout::PageWidth::CONTAINER %> pt-8">
    <%= render Page::Navigation::BreadcrumbComponent.new(current: @study[:title]) %>
  </section>

  <section class="px-5 lg:px-44 pt-8 pb-16">
    <%# main and aside, per the board. It was a left rail of nine anchor links
        into the page; the board has no such rail and puts what to do next in a
        right column instead, which is the question somebody actually arrives
        with. The rail also shipped four anchors that pointed at sections which
        do not always render. %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">
      <main class="lg:col-span-2 space-y-8">
        <%= render Page::Trials::StudyHeaderComponent.new(
              study: @study, nct_id: @nct_id, saved_trial: @saved_trial, match_score: @trial_score
            ) %>

        <%# The score is inside the criteria panel now, where the board puts it:
            one panel headed "You meet N of M criteria" with the number beside
            it, instead of a score two sections above the reason for it.

            Key details went with it. Its facts are phase, status, ages,
            enrolment and sponsor, and the board carries those in the page header
            and under "Who runs it" rather than in a panel of their own. %>

        <%# Only when the study is not open. get_study is deliberately unfiltered
            unlike search, so a saved study that has since closed still opens
            here, and that is the one time this is the most important thing on
            the page. %>
        <% unless TrialStatus.accepting?(@study[:status]) %>
          <%= render Page::Trials::StatusMessageComponent.new(study: @study, score_breakdown: @score_breakdown, trial_score: @trial_score, match_level: @match_level) %>
        <% end %>

        <!-- Phase / Status explainer -->

        <!-- Key dates timeline -->

        <!-- Eligibility Criteria -->
        <%# The criteria split, which is the payoff for the score on the result
            row. What you meet, what the team still checks, and what rules you
            out, each in its own group rather than one flat list. %>
        <div class="mb-8">
          <%= render Page::Trials::CriteriaSplitComponent.new(
                checklist: @eligibility_checklist,
                profile: @profile,
                trial_score: @trial_score,
                match_level: @match_level,
                score_breakdown: @score_breakdown
              ) %>
        </div>

        <!-- Overview -->
        <%= render Page::Trials::OverviewComponent.new(
          study: @study,
          nct_id: @nct_id
        ) %>

        <%# The study's own eligibility text, which is written for clinicians and
            is long. It stays collapsed under the split rather than above it. %>
        <% if @study[:inclusion_criteria].present? || @study[:exclusion_criteria].present? %>
          <div class="mb-8 rounded-panel border border-line dark:border-line-on-dark p-6 lg:p-8">
            <h2 class="text-base font-bold text-ink dark:text-ink-on-dark mb-1">The study's own criteria</h2>
            <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mb-4">
              The registry's wording, unedited. Ages <%= [@study[:min_age], @study[:max_age]].compact.join(" to ").presence || "not stated" %><%= ", #{humanize_registry_value(@study[:sex])}" if @study[:sex].present? %>.
            </p>
            <% if @study[:inclusion_criteria].present? %>
              <%= render Page::DropdownComponent.new(title: "Inclusion criteria", body: @study[:inclusion_criteria]) %>
            <% end %>
            <% if @study[:exclusion_criteria].present? %>
              <div class="mt-3">
                <%= render Page::DropdownComponent.new(title: "Exclusion criteria", body: @study[:exclusion_criteria]) %>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="mb-8">
          <%= render Page::Trials::TakingPartComponent.new(study: @study) %>
        </div>

        <div id="locations" class="p-8 border border-line-2 dark:border-line-on-dark rounded-panel">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Where it takes place") %>
          <% locations_to_show = @study[:locations_detailed].present? ? sort_locations_near_user(@study[:locations_detailed], @profile) : (@study[:locations] || []).map { |l| { display: l, near_you: false } } %>
          <% if locations_to_show.any? %>
            <div class="grid grid-cols-2 mt-4 gap-6">
              <% locations_to_show.each do |loc| %>
                <div class="col-span-1 flex items-start gap-1 p-3 border border-line-2 dark:border-line-on-dark rounded-card <%= "ring-2 ring-sky-500 bg-sky-50 dark:bg-navy-900/20" if loc[:near_you] %>">
                  <div class="mt-0.5">
                    <%= render Utilities::IconComponent.new("map_pin", size: 5, options: { class: "text-sky-600" }) %>
                  </div>
                  <div class="flex flex-col gap-1.5 min-w-0">
                    <span class="text-ink dark:text-ink-on-dark"><%= loc[:display] %></span>
                    <% if loc[:near_you] %>
                      <span class="w-fit inline-flex items-center px-2 py-0.5 rounded-chip text-xs font-medium bg-sky-100 text-sky-800 dark:bg-navy-900/40 dark:text-sky-200">Near you</span>
                    <% end %>
                    <%# The board puts Directions on each site. It is a maps
                        query on the site's own address, which is the one thing
                        the app can offer here: there is no distance in the data,
                        so it cannot say how far, only how to get there. %>
                    <%= link_to "https://www.google.com/maps/search/?api=1&query=#{CGI.escape(loc[:display].to_s)}",
                          target: "_blank", rel: "noopener",
                          class: "w-fit inline-flex items-center gap-1 text-xs font-semibold text-sky-600 dark:text-sky-300 hover:underline" do %>
                      Directions
                      <%= render Utilities::IconComponent.new("external_link", size: 3) %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% elsif @study[:locations].present? %>
            <div class="grid grid-cols-2 mt-4 gap-6">
              <% @study[:locations].each do |location| %>
                <div class="col-span-1 flex items-start gap-1 p-3 border border-line-2 dark:border-line-on-dark rounded-card">
                  <div class="mt-0.5">
                    <%= render Utilities::IconComponent.new("map_pin", size: 5, options: { class: "text-sky-600" }) %>
                  </div>
                  <span class="text-ink dark:text-ink-on-dark"><%= location %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-ink-3 dark:text-ink-3-on-dark mt-4">No location information available.</p>
          <% end %>
        </div>

        <!-- Who runs it -->
        <% if who_runs_it %>
          <div id="contact-information" class="mb-8 p-8 border border-line-2 dark:border-line-on-dark rounded-panel">
            <div class="mb-4">
              <%= render Typography::HeadingComponent.new(size: :h5, text: "Who runs it") %>
            </div>

            <%# The registry id and when the record was last touched. The board
                asks for both, and the second is the more useful: a listing is
                only as current as its last edit, and "Recruiting" carries a
                different weight when the team confirmed it last week than when
                nobody has touched it in two years. %>
            <div class="mb-6 flex flex-wrap gap-x-8 gap-y-3">
              <div>
                <%= render Typography::HeadingComponent.new(size: :h6, text: "Registry ID") %>
                <p class="mt-2 text-base text-ink dark:text-ink-2-on-dark">
                  <span class="font-mono"><%= @nct_id %></span>
                  &middot;
                  <%= link_to "View on ClinicalTrials.gov", "https://clinicaltrials.gov/study/#{@nct_id}",
                        target: "_blank", rel: "noopener",
                        class: "font-semibold text-sky-600 dark:text-sky-300 hover:underline" %>
                </p>
              </div>
              <% if @study[:last_update].present? %>
                <div>
                  <%= render Typography::HeadingComponent.new(size: :h6, text: "Record last updated") %>
                  <p class="mt-2 text-base text-ink dark:text-ink-2-on-dark">
                    <%= Date.parse(@study[:last_update].to_s).to_fs(:long) rescue @study[:last_update] %>
                  </p>
                </div>
              <% end %>
            </div>

            <% if @study[:sponsor].present? %>
              <div class="mb-6">
                <%= render Typography::HeadingComponent.new(size: :h6, text: "Sponsor") %>
                <p class="mt-2 text-base text-ink dark:text-ink-2-on-dark"><%= @study[:sponsor] %></p>
              </div>
            <% end %>

            <% if @study[:central_contacts].present? && @study[:central_contacts].any? %>
              <div class="mb-6">
                <%= render Typography::HeadingComponent.new(size: :h6, text: "Study Contacts") %>
                <div class="mt-3 space-y-3">
                  <% @study[:central_contacts].each do |contact| %>
                    <div class="bg-surface-2 dark:bg-surface-on-dark rounded-card p-4">
                      <h4 class="font-semibold text-ink dark:text-ink-2-on-dark">
                        <%= contact[:name] %>
                      </h4>
                      <% if contact[:role].present? %>
                        <p class="text-sm text-ink-3 dark:text-ink-3-on-dark">
                          <%= contact[:role] %>
                        </p>
                      <% end %>
                      <div class="mt-2 space-y-1">
                        <% if contact[:phone].present? %>
                          <p class="text-sm text-ink-3 dark:text-ink-3-on-dark">
                            <strong>Phone:</strong> <%= contact[:phone] %>
                          </p>
                        <% end %>
                        <% if contact[:email].present? %>
                          <p class="text-sm text-ink-3 dark:text-ink-3-on-dark">
                            <strong>Email:</strong> <%= contact[:email] %>
                          </p>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @study[:overall_officials].present? && @study[:overall_officials].any? %>
              <div>
                <%= render Typography::HeadingComponent.new(size: :h6, text: "Principal Investigators") %>
                <div class="mt-3 space-y-3">
                  <% @study[:overall_officials].each do |official| %>
                    <div class="bg-surface-2 dark:bg-surface-on-dark rounded-card p-4">
                      <h4 class="font-semibold text-ink dark:text-ink-2-on-dark">
                        <%= official[:name] %>
                      </h4>
                      <% if official[:role].present? %>
                        <p class="text-sm text-ink-3 dark:text-ink-3-on-dark">
                          <%= official[:role] %>
                        </p>
                      <% end %>
                      <% if official[:affiliation].present? %>
                        <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mt-1">
                          <%= official[:affiliation] %>
                        </p>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>


        <!-- CTA Section -->
        <div class="bg-sky-50 dark:bg-navy-900/20 border border-sky-200 dark:border-sky-800 rounded-panel p-6">
          <h3 class="text-lg font-semibold text-navy-900 dark:text-sky-100 mb-2">
            Interested in this trial?
          </h3>
          <p class="text-sky-800 dark:text-sky-200 mb-4">
            Visit ClinicalTrials.gov for contact information and to learn more about participating.
          </p>
          <div class="flex flex-wrap gap-3">
            <%= link_to "View on ClinicalTrials.gov", "https://clinicaltrials.gov/study/#{@study[:nct_id]}",
                target: "_blank",
                rel: "noopener noreferrer",
                class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-control text-white bg-navy-600 hover:bg-navy-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500" %>
            <% if @saved_trial.present? %>
              <%= link_to "Edit status & notes", edit_saved_trial_path(@saved_trial),
                  class: "inline-flex items-center px-4 py-2 border border-navy-600 dark:border-sky-500 text-sm font-medium rounded-control text-sky-700 dark:text-sky-300 bg-surface dark:bg-surface-on-dark hover:bg-sky-50 dark:hover:bg-navy-900/20" %>
              <% other_saved_count = current_user.saved_trials.where.not(id: @saved_trial.id).count %>
              <% if other_saved_count >= 1 %>
                <%= link_to "Add to comparison", my_trials_trial_comparison_path(ids: [ @saved_trial.id, current_user.saved_trials.where.not(id: @saved_trial.id).limit(2).pluck(:id) ].flatten.uniq.take(3)),
                    class: "inline-flex items-center px-4 py-2 border border-navy-600 dark:border-sky-500 text-sm font-medium rounded-control text-sky-700 dark:text-sky-300 bg-surface dark:bg-surface-on-dark hover:bg-sky-50 dark:hover:bg-navy-900/20" %>
              <% end %>
            <% end %>
            <% unless user_signed_in? %>
              <%= link_to "Sign in to save this study", new_user_session_path,
                  class: "inline-flex items-center px-4 py-2 border border-navy-600 dark:border-sky-500 text-sm font-medium rounded-control text-sky-700 dark:text-sky-300 bg-surface dark:bg-surface-on-dark hover:bg-sky-50 dark:hover:bg-navy-900/20" %>
            <% end %>
          </div>
        </div>
      </main>

      <aside class="lg:col-span-1">
        <%= render Page::Trials::NextStepComponent.new(
              study: @study, nct_id: @nct_id, similar_trials: @similar_trials
            ) %>
      </aside>
    </div>
  </section>
<% else %>
  <!-- Not Found State -->
  <section class="<%= Layout::PageWidth::CONTAINER %> py-16">
    <div class="bg-surface-2 dark:bg-surface-on-dark rounded-panel p-8 text-center">
      <div class="text-ink-4 dark:text-ink-4-on-dark mb-4">
        <%= render Utilities::IconComponent.new("search", size: 12) %>
      </div>
      <h3 class="text-xl font-semibold text-ink dark:text-ink-2-on-dark mb-2">
        Trial Not Found
      </h3>
      <p class="text-ink-3 dark:text-ink-3-on-dark mb-4">
        The clinical trial you're looking for could not be found.
      </p>
      <%= link_to "Back to Search", search_index_path, class: "text-sky-600 hover:text-sky-700 font-medium" %>
    </div>
  </section>
<% end %>

