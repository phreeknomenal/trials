<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Complete your profile" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Opts Turbo into cross-document view transitions between wizard steps. %>
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>

  <%# No navigation. The wizard is the only thing on screen until it is done. %>
  <body class="bg-zinc-50 dark:bg-zinc-900 min-h-screen">
    <%= yield %>
  </body>
</html>
