<div class="col-span-3 lg:col-span-1 flex flex-col items-center gap-3 p-3 border border-zinc-300 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-800">
  <div class="flex-1">
    <%= f.collection_select :condition_id, Condition.all.order(:name), :id, :name, 
        { prompt: "Select a Condition..." }, 
        class: "w-full border border-zinc-300 dark:border-zinc-600 rounded-lg p-2 text-sm text-zinc-900 dark:text-zinc-300 dark:bg-zinc-800" %>
  </div>
  
  <div class="w-full flex items-center justify-between gap-2">
    <label class="inline-flex items-center cursor-pointer">
      <%= f.check_box :is_primary, class: "mr-1" %>
      <span class="text-sm text-zinc-700 dark:text-zinc-300">Primary</span>
    </label>
    
    <div>
      <%= link_to_remove_association "Remove", f, data: { cocoon: true }, class: "px-3 py-1 bg-red-500 hover:bg-red-600 text-white text-sm rounded-lg transition-colors" %>
    </div>
  </div>
</div>