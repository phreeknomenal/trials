<%# One section, read or being edited. Both states live here so the two cannot
    show different fields, which is how a read view and an edit form drift into
    disagreeing about what a section contains. %>
<% incomplete = sections.incomplete?(section) %>
<%# Editing wins, so the section being worked on stays the one outlined in
    navy. Otherwise an incomplete section is outlined in red to match its link. %>
<% border = if editing then "border-navy-600 dark:border-sky-400"
            elsif incomplete then "border-crit dark:border-crit-on-dark"
            else "border-line dark:border-line-on-dark"
            end %>
<section id="<%= section.slug %>" class="rounded-panel border <%= border %> bg-surface dark:bg-surface-on-dark p-5 lg:p-6">

  <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
    <div>
      <h2 class="text-base font-bold text-ink dark:text-ink-on-dark"><%= section.heading %></h2>
      <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mt-0.5"><%= section.blurb %></p>
      <%# Said plainly, because "sex assigned at birth" and "pronouns" look
          equally personal and only one of them rules studies out. %>
      <span class="inline-flex items-center gap-1.5 mt-2 text-xs font-semibold <%= section.affects_matching? ? "text-sky-700 dark:text-sky-300" : "text-ink-3 dark:text-ink-3-on-dark" %>">
        <% if section.affects_matching? %>
          <%= render Utilities::IconComponent.new("chart_mixed", size: 4) %>
        <% end %>
        <%= section.impact_label %>
      </span>
      <%# Said in words as well, so the red outline is not the only signal. %>
      <% if incomplete %>
        <span class="ml-3 mt-2 inline-flex text-xs font-semibold text-crit dark:text-crit-on-dark">Incomplete</span>
      <% end %>
    </div>

    <% if editing %>
      <span class="inline-flex items-center rounded-chip bg-navy-600 px-2.5 py-1 text-xs font-bold text-white">Editing</span>
    <% else %>
      <%= link_to profile_path(profile, section: section.slug, anchor: section.slug),
            class: Buttons::ButtonStyles.classes("secondary", size: "px-3 py-1.5 text-sm") do %>
        <%= render Utilities::IconComponent.new("pencil", size: 4) %>
        Edit
      <% end %>
    <% end %>
  </div>

  <% if editing %>
    <%= form_with model: profile, url: profile_path(profile, section: section.slug), method: :patch, class: "flex flex-col gap-4" do |f| %>
      <%# The photo has its own control rather than a generic field, and belongs
          with the names, which is where the wizard collects it. %>
      <% if section.slug == "about_you" %>
        <%= render Forms::ImageUploadComponent.new(
              form: f, attribute: :avatar, current: profile.avatar, initials: profile.initials
            ) %>
      <% end %>

      <% section.fields.each do |field| %>
        <%= render Forms::FieldComponent.new(**profile_field_args(f, field)) %>
      <% end %>

      <%# The wizard's own steps, rendered in place. They used to be reached by a
          link into the wizard, which redirects a finished profile home, so
          neither could be edited at all once onboarding was done. %>
      <% if section.slug == "conditions" %>
        <% profile.errors[:base].each do |message| %>
          <p class="<%= Forms::FieldStyles::MESSAGE %>"><%= message %></p>
        <% end %>
        <%= render Onboarding::Steps::ConditionsComponent.new(form: f, profile: profile) %>
      <% end %>

      <% if section.slug == "community" %>
        <%= render Onboarding::Steps::CommunityComponent.new(form: f, profile: profile) %>
      <% end %>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <%= f.button type: "submit", class: Buttons::ButtonStyles.classes("primary", size: "px-4 py-2 text-sm") do %>
          Save <%= section.heading.downcase %>
        <% end %>
        <%= link_to "Cancel", profile_path(profile, anchor: section.slug),
              class: Buttons::ButtonStyles.classes("quiet", size: "px-4 py-2 text-sm") %>
        <% if section.affects_matching? %>
          <span class="text-xs text-ink-3 dark:text-ink-3-on-dark">Saving rescores every study.</span>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
      <% if section.slug == "community" %>
        <div class="sm:col-span-2">
          <dt class="text-xs font-semibold uppercase tracking-wide text-ink-3 dark:text-ink-3-on-dark">Selected</dt>
          <dd class="mt-1 flex flex-wrap gap-1.5">
            <% tags = profile.identities.to_a + profile.interests.to_a %>
            <% if tags.any? %>
              <% tags.each do |tag| %>
                <span class="inline-flex items-center rounded-chip bg-surface-2 dark:bg-surface-2-on-dark px-2.5 py-1 text-sm font-semibold text-ink-2 dark:text-ink-2-on-dark"><%= tag.name.titleize %></span>
              <% end %>
            <% else %>
              <span class="text-sm text-ink-4 dark:text-ink-4-on-dark">Nothing chosen</span>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% if section.slug == "conditions" %>
        <div class="sm:col-span-2">
          <dt class="text-xs font-semibold uppercase tracking-wide text-ink-3 dark:text-ink-3-on-dark">Conditions</dt>
          <dd class="mt-1 flex flex-wrap gap-1.5">
            <% if profile.profile_conditions.any? %>
              <%# Primary first, because it is the one matching leans on. %>
              <% profile.profile_conditions.includes(:condition).sort_by { |pc| [pc.is_primary ? 0 : 1, pc.condition.name] }.each do |pc| %>
                <span class="inline-flex items-center gap-1.5 rounded-chip bg-surface-2 dark:bg-surface-2-on-dark px-2.5 py-1 text-sm font-semibold text-ink-2 dark:text-ink-2-on-dark">
                  <%= pc.condition.name.titleize %>
                  <% if pc.is_primary %>
                    <span class="text-xs font-bold text-sky-700 dark:text-sky-300">Primary</span>
                  <% end %>
                </span>
              <% end %>
            <% elsif profile.no_diagnosis? %>
              <span class="text-sm text-ink dark:text-ink-2-on-dark">No diagnosis yet</span>
            <% else %>
              <%= unanswered_profile_field %>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% section.fields.each do |field| %>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-ink-3 dark:text-ink-3-on-dark">
            <%= profile_field_label(field) %>
          </dt>
          <dd class="mt-0.5 text-sm text-ink dark:text-ink-2-on-dark">
            <%= profile_field_value(profile, field) %>
          </dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</section>
