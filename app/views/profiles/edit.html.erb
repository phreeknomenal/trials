<section class="px-5 lg:px-24 py-16 border-b border-zinc-200 dark:border-zinc-700">
  <div class="flex flex-col justify-center items-center">
    <div class="w-24 h-24 text-4xl mx-auto mb-3">
      <%= render Utilities::AvatarComponent.new(avatar: @profile.avatar, initials: @profile.initials) %>
    </div>
    <h3 class="text-3xl font-bold leading-none text-center mb-1 text-zinc-900 dark:text-zinc-300">Edit Profile</h3>
    <span class="text-sm font-body font-medium text-center text-zinc-600 mb-8"><%= @profile.full_name %></span>
  </div>
</section>

<section class="px-5 lg:px-36 py-24">
  <div class="flex gap-10">
    <div class="w-full lg:w-4/5">
      <%= render partial: "form", locals: { profile: @profile, path: profile_path(@profile) } %>
    </div>

    <div class="w-1/5 flex gap-10">
      <div class="w-full h-124 bg-purple-300/10 rounded-lg border border-zinc-200 dark:border-zinc-700 p-4">
        <p class="text-sm text-zinc-600 dark:text-zinc-400">
          <strong>Note:</strong> Fields marked with * are required. Your profile helps us match you with relevant clinical trials.
        </p>
      </div>
    </div>
  </div>
</section>
