<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Clinical Trials Search</h1>
      <p class="text-lg text-gray-600">Search for clinical trials from ClinicalTrials.gov</p>
    </div>

    <!-- Search Form -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
      <%= form_with url: root_path, method: :get, local: true, class: "flex gap-4" do |f| %>
        <div class="flex-1">
          <%= f.text_field :query, 
              value: @query,
              placeholder: "Enter condition, disease, or keyword (e.g., diabetes, cancer, COVID-19)",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>
        <%= f.submit "Search", class: "px-8 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
      <% end %>
    </div>

    <!-- Error Message -->
    <% if @error.present? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
        <strong>Error:</strong> <%= @error %>
      </div>
    <% end %>

    <!-- Results -->
    <% if @studies.present? %>
      <div class="mb-6">
        <div class="flex justify-between items-center">
          <h2 class="text-2xl font-bold text-gray-900">
            Results for "<%= @query %>"
          </h2>
          <span class="text-gray-600">
            Found <%= @total_count %> trial<%= @total_count == 1 ? '' : 's' %>
          </span>
        </div>
      </div>

      <!-- Studies List -->
      <div class="space-y-6">
        <% @studies.each do |study| %>
          <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <!-- Study Header -->
            <div class="mb-4">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-xl font-semibold text-gray-900 flex-1">
                  <%= study[:title] %>
                </h3>
                <% if study[:nct_id].present? %>
                  <a href="https://clinicaltrials.gov/study/<%= study[:nct_id] %>" 
                     target="_blank"
                     class="px-3 py-1 bg-blue-100 text-blue-700 rounded-md text-sm font-medium hover:bg-blue-200 whitespace-nowrap">
                    <%= study[:nct_id] %> ↗
                  </a>
                <% end %>
              </div>
            </div>

            <!-- Study Metadata -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 text-sm">
              <% if study[:status].present? %>
                <div>
                  <span class="font-semibold text-gray-700">Status:</span>
                  <span class="px-2 py-1 rounded-full text-xs ml-2
                    <%= study[:status]&.downcase&.include?('recruiting') ? 'bg-green-100 text-green-800' : 
                        study[:status]&.downcase&.include?('completed') ? 'bg-gray-100 text-gray-800' : 
                        'bg-yellow-100 text-yellow-800' %>">
                    <%= study[:status] %>
                  </span>
                </div>
              <% end %>

              <% if study[:phase].present? %>
                <div>
                  <span class="font-semibold text-gray-700">Phase:</span>
                  <span class="text-gray-600 ml-2"><%= study[:phase] %></span>
                </div>
              <% end %>

              <% if study[:start_date].present? %>
                <div>
                  <span class="font-semibold text-gray-700">Start Date:</span>
                  <span class="text-gray-600 ml-2"><%= study[:start_date] %></span>
                </div>
              <% end %>
            </div>

            <!-- Conditions -->
            <% if study[:conditions].present? %>
              <div class="mb-3">
                <span class="font-semibold text-gray-700 text-sm">Conditions:</span>
                <div class="flex flex-wrap gap-2 mt-2">
                  <% study[:conditions].first(5).each do |condition| %>
                    <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm">
                      <%= condition %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Summary -->
            <% if study[:summary].present? %>
              <div class="mb-3">
                <p class="text-gray-700 text-sm leading-relaxed">
                  <%= truncate(study[:summary], length: 300) %>
                </p>
              </div>
            <% end %>

            <!-- Locations -->
            <% if study[:locations].present? %>
              <div class="text-sm">
                <span class="font-semibold text-gray-700">Locations:</span>
                <span class="text-gray-600 ml-2"><%= study[:locations].join(" • ") %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @total_count > 10 %>
        <div class="mt-8 flex justify-center gap-2">
          <% if @current_page > 1 %>
            <%= link_to "← Previous", root_path(query: @query, page: @current_page - 1), 
                class: "px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
          <% end %>

          <span class="px-4 py-2 bg-blue-600 text-white rounded-lg">
            Page <%= @current_page %>
          </span>

          <% if @studies.present? && @studies.length >= 10 %>
            <%= link_to "Next →", root_path(query: @query, page: @current_page + 1), 
                class: "px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
          <% end %>
        </div>
      <% end %>

    <% elsif @query.present? %>
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-6 py-4 rounded-lg text-center">
        <p class="text-lg">No trials found for "<%= @query %>". Try different keywords.</p>
      </div>
    <% end %>
  </div>
</div>