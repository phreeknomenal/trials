<div class="w-full flex items-center justify-center">
  <div class="w-1/3 py-24">
    <div class="w-full border border-line-2 dark:border-line-on-dark rounded-panel overflow-hidden">
      <div class="p-10">
        <h3 class="text-2xl font-semibold font-accent text-sky-600 leading-none">Locked out</h3>
        <h1 class="text-6xl font-bold leading-none text-ink dark:text-ink-2-on-dark">Dira<span class="font-light text-ink-3 dark:text-ink-3-on-dark"> Health</span></h1>
        <%# The wait is stated, because "email me a link" is the wrong advice for
            someone who can simply come back later, and the link may land in spam. %>
        <h2 class="text-md text-ink-3 dark:text-ink-3-on-dark mb-10">
          Too many sign-in attempts locked this account. It unlocks on its own after an hour,
          or we can send you a link to unlock it now.
        </h2>

        <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: {method: :post}) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="field mb-6">
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email address", class: "w-full border border-line-2 dark:border-line-on-dark rounded-control text-ink-3 dark:text-ink-3-on-dark placeholder:text-ink-3 dark:placeholder:text-ink-3-on-dark p-5 mb-2" %>
          </div>

          <div class="actions mt-10">
            <%= f.submit "Send unlock instructions", class: "w-full bg-navy-600 text-white font-medium py-3 px-4 rounded-control hover:bg-navy-700 transition-all duration-300 cursor-pointer" %>
          </div>
        <% end %>

        <div class="flex items-center justify-between mt-20">
          <p class="text-ink-3">Remembered it? <%= link_to "Log in", new_user_session_path, class: "text-sky-600 hover:text-sky-700 transition-all duration-300 cursor-pointer" %></p>
        </div>
      </div>
    </div>
  </div>
</div>
