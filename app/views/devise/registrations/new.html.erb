<%= render layout: "devise/shared/auth_shell", locals: {heading: "Create your account"} do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: {class: "flex flex-col gap-4"}) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Email", class: Forms::FieldStyles::LABEL %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: Forms::FieldStyles.input(invalid: resource.errors[:email].any?) %>
    </div>

    <div>
      <%= f.label :password, "Password", class: Forms::FieldStyles::LABEL %>
      <%= f.password_field :password, autocomplete: "new-password", class: Forms::FieldStyles.input(invalid: resource.errors[:password].any?) %>
      <%# Read from Devise rather than written out, so raising the floor cannot
          leave a stale number on the page. %>
      <% if @minimum_password_length %>
        <p class="<%= Forms::FieldStyles::HINT %>">
          <%= @minimum_password_length %> characters minimum. Longer is better, and a passphrase beats a short complicated one.
        </p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: Forms::FieldStyles::LABEL %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: Forms::FieldStyles.input(invalid: resource.errors[:password_confirmation].any?) %>
    </div>

    <%= f.button "Create account", type: "submit", class: "#{Buttons::ButtonStyles.classes("primary", size: "px-4 py-2.5 text-base")} w-full mt-2" %>
  <% end %>

  <p class="mt-6 text-sm text-ink-3 dark:text-ink-3-on-dark">
    Already have one? <%= link_to "Sign in", new_session_path(resource_name), class: "font-semibold text-sky-700 dark:text-sky-300 hover:underline" %>
  </p>
<% end %>
