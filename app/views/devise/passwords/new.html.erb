<div class="w-full flex items-center justify-center">
  <div class="w-1/3 py-24">
    <div class="w-full border border-zinc-300 dark:border-zinc-700 rounded-2xl overflow-hidden">
      <div class="p-10">
        <h3 class="text-2xl font-semibold font-accent text-lavender-600 leading-none">Reset your password</h3>
        <h1 class="text-6xl font-bold leading-none text-zinc-900 dark:text-zinc-300">Lumen</h1>
        <h2 class="text-md text-zinc-600 dark:text-zinc-400 mb-10">Enter your email address and we'll send you instructions to reset your password.</h2>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="field mb-6">
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email address", class: "w-full border border-zinc-300 dark:border-zinc-700 rounded text-zinc-600 dark:text-zinc-400 placeholder:text-zinc-600 dark:placeholder:text-zinc-400 p-5 mb-2" %>
          </div>

          <div class="actions mt-10">
            <%= f.submit "Send reset instructions", class: "w-full bg-lavender-600 text-white font-medium py-3 px-4 rounded-lg hover:bg-coral-600 transition-all duration-300 cursor-pointer" %>
          </div>
        <% end %>

        <div class="flex items-center justify-between mt-20">
          <p class="text-zinc-500">Remember your password? <%= link_to "Log in", new_user_session_path, class: "text-lavender-600 hover:text-coral-600 transition-all duration-300 cursor-pointer" %></p>
        </div>
      </div>
    </div>
  </div>
</div>
