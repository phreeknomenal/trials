<%= render layout: "devise/shared/auth_shell", locals: {
      heading: "Reset your password",
      blurb: "Enter the email you signed up with and we will send a link to set a new password."
    } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: {method: :post, class: "flex flex-col gap-4"}) do |f| %>
    <div>
      <%= f.label :email, "Email", class: Forms::FieldStyles::LABEL %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: Forms::FieldStyles.input %>
    </div>

    <%= f.button "Send reset link", type: "submit", class: "#{Buttons::ButtonStyles.classes("primary", size: "px-4 py-2.5 text-base")} w-full mt-2" %>
  <% end %>

  <p class="mt-6 text-sm text-ink-3 dark:text-ink-3-on-dark">
    <%= link_to "Back to sign in", new_session_path(resource_name), class: "font-semibold text-sky-700 dark:text-sky-300 hover:underline" %>
  </p>
<% end %>
