<%= render layout: "devise/shared/auth_shell", locals: {heading: "Choose a new password"} do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: {method: :put, class: "flex flex-col gap-4"}) do |f| %>
    <%= f.hidden_field :reset_password_token %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :password, "New password", class: Forms::FieldStyles::LABEL %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: Forms::FieldStyles.input(invalid: resource.errors[:password].any?) %>
      <% if @minimum_password_length %>
        <p class="<%= Forms::FieldStyles::HINT %>"><%= @minimum_password_length %> characters minimum.</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: Forms::FieldStyles::LABEL %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: Forms::FieldStyles.input(invalid: resource.errors[:password_confirmation].any?) %>
    </div>

    <%= f.button "Save and sign in", type: "submit", class: "#{Buttons::ButtonStyles.classes("primary", size: "px-4 py-2.5 text-base")} w-full mt-2" %>
  <% end %>
<% end %>
