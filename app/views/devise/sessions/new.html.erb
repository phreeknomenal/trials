<%= render layout: "devise/shared/auth_shell", locals: {heading: "Sign in"} do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: {class: "flex flex-col gap-4"}) do |f| %>
    <%# Devise's failure message arrives as a flash, not on the resource, so the
        shared error partial has nothing to show here. The layout renders it. %>

    <div>
      <%= f.label :email, "Email", class: Forms::FieldStyles::LABEL %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: Forms::FieldStyles.input %>
    </div>

    <div>
      <div class="flex items-baseline justify-between gap-3">
        <%= f.label :password, "Password", class: Forms::FieldStyles::LABEL %>
        <%# Guarded on the module, the way devise/shared/_links does. A route
            helper for a module that is off does not exist, so an unguarded link
            takes the whole page down rather than degrading. %>
        <% if devise_mapping.recoverable? %>
          <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm font-semibold text-sky-700 dark:text-sky-300 hover:underline" %>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", class: Forms::FieldStyles.input %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2.5 cursor-pointer">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded-sm border-line-2 dark:border-line-on-dark accent-sky-500" %>
        <span class="text-sm text-ink-2 dark:text-ink-2-on-dark">Keep me signed in on this device</span>
      </label>
    <% end %>

    <%= f.button "Sign in", type: "submit", class: "#{Buttons::ButtonStyles.classes("primary", size: "px-4 py-2.5 text-base")} w-full mt-2" %>
  <% end %>

  <% if devise_mapping.registerable? %>
    <p class="mt-6 text-sm text-ink-3 dark:text-ink-3-on-dark">
      New here? <%= link_to "Create an account", new_registration_path(resource_name), class: "font-semibold text-sky-700 dark:text-sky-300 hover:underline" %>
    </p>
  <% end %>

  <%# Paranoid mode tells a locked account "that email and password do not match",
      the same as any other failure, so nobody is told they are locked. Without a
      permanent link here they would keep trying and never find the way out. The
      link reveals nothing: it is on the page for everyone.

      Guarded on the mapping rather than assumed. devise_for draws its routes
      from User.devise_modules when routes are drawn, so a server whose routes
      predate lockable has no unlock helper at all, and an unguarded call raised
      NoMethodError on the whole sign-in page. %>
  <% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) %>
    <p class="mt-8 pt-6 border-t border-line dark:border-line-on-dark text-sm text-ink-3 dark:text-ink-3-on-dark">
      Tried several times and still stuck? Too many attempts lock an account for an hour.
      <%= link_to "Unlock it by email", new_unlock_path(resource_name), class: "font-semibold text-sky-700 dark:text-sky-300 hover:underline" %>.
    </p>
  <% end %>
<% end %>
