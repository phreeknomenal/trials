<section>
  <div class="w-full lg:h-148 px-5 lg:p-0 py-10 lg:py-0 flex flex-col items-center justify-center border-b border-zinc-200">
    <h1 class="w-full lg:w-3/5 mx-auto text-5xl lg:text-7xl tracking-tight font-medium text-center mb-5">Discover clinical trials that match your health journey.</h1>
    <p class="text-lg text-center text-gray-600 mb-6">Discover personalized clinical trials tailored to your unique medical profile and needs.<br> Our advanced matching system connects you with research opportunities that matter.</p>
    <div class="flex justify-center gap-4">
      <%= render Buttons::ButtonComponent.new(path: new_user_registration_path, text: "Get Started", color: "blue") %>
      <%= render Buttons::ButtonComponent.new(path: "#", text: "Learn More", color: "blue") %>
    </div>
  </div>
</section>

<section class="py-24 border-b border-zinc-200">
  <%= render Page::HeaderComponent.new(pretext: "Explore", heading: "Top medical conditions", subheading: "Browse clinical trials across various health categories") %>
  <div class="w-full grid grid-cols-4 gap-6 px-24">
    <div class="col-span-1 bg-indigo-100">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/600/400",
        pretext: "Cancer",
        title: "Oncology trials",
        subtitle: "Advanced research for cancer treatment and prevention.", 
        link_text: "Learn More", 
        type: :top
      ) %>
    </div>
    <div class="col-span-1 bg-indigo-100">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/507/300",
        pretext: "Neurology",
        title: "Brain health research",
        subtitle: "Innovative studies for neurological conditions.", 
        link_text: "Explore",
        type: :top
      ) %>
    </div>
    <div class="col-span-2 bg-pink-100">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/505/300",
        pretext: "Neurology",
        title: "Brain health research",
        subtitle: "Innovative studies for neurological conditions.", 
        link_text: "Explore",
        type: :left
      ) %>
    </div>
  </div>
</section>

<section class="py-24 border-b border-zinc-200">
  <%= render Page::HeaderComponent.new(pretext: "Journey", heading: "How it works", subheading: "Simple steps to find your perfect clinical trial match") %>
  <div class="w-full grid grid-cols-3 gap-6 px-24">
    <div class="col-span-1 bg-indigo-100">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/601/400",
        pretext: "Search",
        title: "Browse personalized trial reccomendations",
        subtitle: "Use our intelligent matching system to find trials that match your health profile and needs.", 
        link_text: "Start Searching", 
        type: :bottom
      ) %>
    </div>
    <div class="col-span-1 bg-indigo-100">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/501/300",
        pretext: "Match",
        title: "Get your personal fit score",
        subtitle: "Understand how well a trial matches your profile.", 
        link_text: "Check Compatibility",
        type: :bottom
      ) %>
    </div>
    <div class="col-span-1 bg-pink-100">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/503/300",
        pretext: "Connect",
        title: "Reach our to trial coodinators",
        subtitle: "Seamless communication with reseach teams.", 
        link_text: "Get Started",
        type: :bottom
      ) %>
    </div>
  </div>
</section>