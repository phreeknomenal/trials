<section>
  <div class="w-full lg:h-148 px-5 lg:p-0 py-10 lg:py-0 flex flex-col items-center justify-center border-b border-zinc-200 dark:border-zinc-700">
    <h1 class="w-full lg:w-3/5 mx-auto text-5xl lg:text-7xl tracking-tight font-medium text-center mb-5 text-zinc-900 dark:text-zinc-300">Discover clinical trials that match your health journey.</h1>
    <p class="text-lg text-center text-zinc-600 dark:text-zinc-600 mb-6">Discover personalized clinical trials tailored to your unique medical profile and needs.<br> Our advanced matching system connects you with research opportunities that matter.</p>
    <div class="flex justify-center gap-4">
      <%= render Buttons::ButtonComponent.new(path: new_user_registration_path, text: "Get Started", color: "lavender") %>
      <%= render Buttons::ButtonComponent.new(path: "#", text: "Learn More", color: "blue") %>
    </div>
  </div>
</section>

<section class="py-24 border-b border-zinc-300 dark:border-zinc-700">
  <div class="w-full mb-16">
    <%= render Page::HeaderComponent.new(
      pretext: "Explore", 
      heading: "Top medical conditions", 
      subheading: "Browse clinical trials across various health categories"
    ) %>
  </div>
  <div class="w-full grid grid-cols-4 gap-6 px-24">
    <div class="col-span-1">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/600/400",
        pretext: "Cancer",
        title: "Oncology trials",
        subtitle: "Advanced research for cancer treatment and prevention.", 
        link_text: "Learn More", 
        type: :top
      ) %>
    </div>
    <div class="col-span-1">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/507/300",
        pretext: "Neurology",
        title: "Brain health research",
        subtitle: "Innovative studies for neurological conditions.", 
        link_text: "Explore",
        type: :top
      ) %>
    </div>
    <div class="col-span-2">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/505/300",
        pretext: "Neurology",
        title: "Brain health research",
        subtitle: "Innovative studies for neurological conditions.", 
        link_text: "Explore",
        type: :left
      ) %>
    </div>
  </div>
</section>

<section class="py-24 border-b border-zinc-300 dark:border-zinc-700">
  <div class="w-full mb-16">
    <%= render Page::HeaderComponent.new(
      pretext: "Journey", 
      heading: "How it works", 
      subheading: "Simple steps to find your perfect clinical trial match"
    ) %>
  </div>
  <div class="w-full grid grid-cols-3 gap-6 px-24">
    <div class="col-span-1">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/601/400",
        pretext: "Search",
        title: "Browse personalized trial reccomendations",
        subtitle: "Use our intelligent matching system to find trials that match your health profile and needs.", 
        link_text: "Start Searching", 
        type: :bottom
      ) %>
    </div>
    <div class="col-span-1">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/501/300",
        pretext: "Match",
        title: "Get your personal fit score",
        subtitle: "Understand how well a trial matches your profile.", 
        link_text: "Check Compatibility",
        type: :bottom
      ) %>
    </div>
    <div class="col-span-1">
      <%= render Page::Cards::CardComponent.new(
        image: "https://picsum.photos/503/300",
        pretext: "Connect",
        title: "Reach our to trial coodinators",
        subtitle: "Seamless communication with reseach teams.", 
        link_text: "Get Started",
        type: :bottom
      ) %>
    </div>
  </div>
</section>

<section class="py-24 border-b border-zinc-300 dark:border-zinc-700">
  <div class="w-3/5 h-full mx-auto flex flex-col justify-center items-center gap-x-4 p-6 space-y-3">
    <div class="w-auto h-12 flex gap-1 mb-5">
      <%= render Utilities::IconComponent.new("star", size: 8) %>
      <%= render Utilities::IconComponent.new("star", size: 8) %>
      <%= render Utilities::IconComponent.new("star", size: 8) %>
      <%= render Utilities::IconComponent.new("star", size: 8) %>
      <%= render Utilities::IconComponent.new("star", size: 8) %>
    </div>
    <div class="mb-8">
      <p class="text-4xl leading-12 font-bold text-center">The platform gave me hope when I thought no options existed. It connected me with a groundbreaking trial that changed my life.</p>
    </div>
    <div class="mt-auto">
      <div class="flex items-center gap-2">
        <div class="w-10 h-10">
          <%= render Utilities::AvatarComponent.new(User.find(1).profile) %>
        </div>
        <div class="flex flex-col">
          <h3 class="text-base font-bold"><%= User.find(1).profile.full_name %></h3>
          <p class="text-sm font-body text-zinc-600">Cancer Survivor, research participant</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-24 border-b border-zinc-300 dark:border-zinc-700">
  <div class="w-full lg:w-1/2 mx-auto text-center mb-8">
    <%= render Page::HeaderComponent.new(
      heading: "Your health journey starts here", 
      subheading: "Discover personalized clinical trials that could transform your medical experience and contribute to groundbreaking research",
      position: :center
    ) %>
  </div>

  <div class="flex justify-center gap-2">
    <%= render Buttons::ButtonComponent.new(path: "#", text: "Find my match", color: "clear_navy") %>
    <%= render Buttons::ButtonComponent.new(path: "#", text: "Explore", color: "clear_navy") %>
  </div>

  <div class="w-full px-5 lg:px-24 mt-10">
    <%= image_tag "https://picsum.photos/600/400", class: "w-full h-144 rounded-2xl object-cover" %>
  </div>
</section>