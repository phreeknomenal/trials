<section class="px-5 lg:px-44 py-16 border-b border-line dark:border-line-on-dark">
  <%= render Page::HeaderComponent.new(
    heading: "Saved Trials",
    subheading: "Keep track of clinical trials you're interested in",
    position: :left
  ) %>
</section>

<div class="px-5 lg:px-44 py-16">
  <!-- Filters and Search -->
  <div class="bg-surface dark:bg-paper-on-dark rounded-lg border border-line dark:border-line-on-dark p-6 mb-6">
    <%= form_with url: saved_trials_path, method: :get, class: "space-y-4", local: true do |f| %>
      <!-- Search -->
      <div class="flex gap-4">
        <div class="flex-1">
          <%= f.text_field :search, 
              placeholder: "Search by trial title or notes...", 
              value: params[:search],
              class: "block p-2 w-full bg-surface dark:bg-paper-on-dark border border-line dark:border-line-on-dark placeholder:text-ink-3 dark:placeholder:text-ink-3-on-dark text-base text-ink dark:text-ink-2-on-dark rounded focus:ring-sky-500 focus:border-navy-600" %>
        </div>
        <%= f.submit "Search", class: "cursor-pointer inline-flex items-center px-6 py-2 border border-transparent text-base font-medium rounded-md text-white bg-navy-600 hover:bg-navy-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500" %>
      </div>

      <!-- Filters -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Status Filter -->
        <div>
          <%= f.select :status, 
              options_for_select(
                [["All Statuses", ""]] + SavedTrial::STATUSES.map { |s| [s.humanize, s] },
                params[:status]
              ),
              { include_blank: false },
              class: "block p-2 w-full bg-surface dark:bg-paper-on-dark border border-line dark:border-line-on-dark placeholder:text-ink-3 dark:placeholder:text-ink-3-on-dark text-base text-ink dark:text-ink-2-on-dark rounded focus:ring-sky-500 focus:border-navy-600" %>
        </div>

        <!-- Sort By -->
        <div>
          <%= f.select :sort_by, 
              options_for_select(
                [["Date Saved", "date"], ["Status", "status"], ["Match Score", "match_score"]],
                params[:sort_by] || "date"
              ),
              { include_blank: false },
              class: "block p-2 w-full bg-surface dark:bg-paper-on-dark border border-line dark:border-line-on-dark placeholder:text-ink-3 dark:placeholder:text-ink-3-on-dark text-base text-ink dark:text-ink-2-on-dark rounded focus:ring-sky-500 focus:border-navy-600" %>
        </div>

        <!-- Sort Order -->
        <div>
          <%= f.select :sort, 
              options_for_select(
                [["Newest First", "newest"], ["Oldest First", "oldest"]],
                params[:sort] || "newest"
              ),
              { include_blank: false },
              class: "block p-2 w-full bg-surface dark:bg-paper-on-dark border border-line dark:border-line-on-dark placeholder:text-ink-3 dark:placeholder:text-ink-3-on-dark text-base text-ink dark:text-ink-2-on-dark rounded focus:ring-sky-500 focus:border-navy-600" %>
        </div>
      </div>

      <!-- Bulk Action Checkbox -->
      <div class="flex items-center gap-4">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="select-all" class="w-4 h-4 rounded border-line-2 text-info">
          <span class="text-sm text-ink-2">Select All</span>
        </label>
        <div id="bulk-actions" class="hidden flex items-center gap-2">
          <label for="bulk-status" class="text-sm text-ink-2">Mark as:</label>
          <select id="bulk-status" class="px-3 py-1 border border-line-2 rounded text-sm">
            <option value="">-- Select Status --</option>
            <% SavedTrial::STATUSES.each do |status| %>
              <option value="<%= status %>"><%= status.humanize %></option>
            <% end %>
          </select>
          <button type="button" id="bulk-update-btn" class="px-4 py-1 bg-info text-white text-sm rounded hover:bg-info">
            Update
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Results -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <h2 class="text-2xl font-bold text-ink dark:text-ink-on-dark">
      Saved Trials (<%= @saved_trials.count %>)
    </h2>
    <% if @saved_trials.any? && @saved_trials.count >= 2 %>
      <%= form_with url: my_trials_trial_comparison_path, method: :get, id: "compare-trials-form", local: true, class: "flex items-center gap-2" do |f| %>
        <span class="text-sm text-ink-3 dark:text-ink-3-on-dark">Select 2–3 trials above, then</span>
        <%= f.submit "Compare selected", class: "cursor-pointer inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-navy-600 hover:bg-navy-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500" %>
      <% end %>
    <% end %>
  </div>
  <% if @saved_trials.any? %>
    <div class="grid grid-cols-2 gap-8">
      <% @saved_trials.each do |saved_trial| %>
        <%= render Page::SavedTrials::CardComponent.new(saved_trial: saved_trial) %>
      <% end %>
    </div>

    <%= render Shared::PaginationComponent.new(
          pagy: @pagy,
          path_for: ->(page) { saved_trials_path(request.query_parameters.merge(page: page)) },
          unit: "trial"
        ) %>
  <% else %>
    <div class="flex flex-col justify-center items-center text-center py-12">
      <div class="text-sky-600">
        <%= render Utilities::IconComponent.new("bookmark", size: 12) %>
      </div>
      <h3 class="mt-2 text-2xl font-semibold text-ink dark:text-ink-on-dark">No saved trials yet</h3>
      <p class="mt-1 text-ink-3">Start saving trials to keep track of ones you're interested in</p>
      <%= link_to "Search Trials", my_trials_root_path, class: "mt-4 inline-block px-6 py-3 bg-navy-600 text-white rounded-lg hover:bg-navy-700 transition-colors" %>
    </div>
  <% end %>
</div>

<style>
  .status-interested { @apply bg-info/10 text-info; }
  .status-applying { @apply bg-warn/10 text-warn; }
  .status-contacted { @apply bg-info/10 text-info; }
  .status-enrolled { @apply bg-good/10 text-good; }
  .status-rejected { @apply bg-crit/10 text-crit; }
  .status-completed { @apply bg-surface-2 text-ink-2; }
  .status-not_eligible { @apply bg-warn/10 text-warn; }
</style>

