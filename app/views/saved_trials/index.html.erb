<%# Saved studies, rebuilt against the "Saved studies" board.

    Two changes the board asks for and one it does not.

    The status rail replaces a select. It is the page's main axis -- what people
    come here to do is see what is waiting on them -- and a select hides the
    counts, which are the whole reason to look.

    One selection model replaces two. There were a "Select All" checkbox with a
    "Mark as" dropdown, and a separate set of checkboxes inside a compare form:
    two sets of boxes on one page answering the same question. The first pair
    had no endpoint and no JavaScript, so it had never done anything at all.
    Both actions now read one selection.

    Not here: the distance beside each location ("Birmingham, AL · 4 mi"). There
    is no distance in the data, which this plan records for the results page
    too. %>

<% content_for :title, "Saved studies - Dira Health" %>

<div class="<%= Layout::PageWidth::CONTAINER %> py-10 flex flex-col gap-6"
     data-controller="selection">

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-1.5">
      <h1 class="font-primary text-3xl font-bold tracking-tight text-ink dark:text-ink-on-dark">Saved studies</h1>
      <p class="text-sm text-ink-3 dark:text-ink-3-on-dark">
        <%= pluralize(@total_count, "study") %> saved.
      </p>
    </div>
    <%= render Buttons::ButtonComponent.new(
          path: search_index_path, text: "Find more studies", color: "primary"
        ) %>
  </div>

  <%# The rail. Counts come from the whole collection, before the status filter,
      so a status never removes its own option and strands whoever clicked it. %>
  <nav class="flex flex-wrap gap-2" aria-label="Filter by status">
    <%= render Shared::PillComponent.new(
          text: "All", path: saved_trials_path(request.query_parameters.except("status", "page")),
          selected: params[:status].blank?, count: @total_count
        ) %>
    <% SavedTrial::STATUSES.each do |status| %>
      <% count = @status_counts[status].to_i %>
      <% next if count.zero? && params[:status] != status %>
      <%= render Shared::PillComponent.new(
            text: Shared::StatusBadgeComponent::STATUSES.dig(status, :label) || status.humanize,
            path: saved_trials_path(request.query_parameters.except("page").merge(status: status)),
            selected: params[:status] == status,
            count: count
          ) %>
    <% end %>
  </nav>

  <%= form_with url: saved_trials_path, method: :get, class: "flex flex-wrap gap-3 items-end" do |f| %>
    <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
    <div class="flex-1 min-w-[16rem]">
      <%= label_tag :search, "Search your saved studies and notes", class: Forms::FieldStyles::LABEL %>
      <%= search_field_tag :search, params[:search],
            placeholder: "A word from the title, or from a note you wrote",
            class: Forms::FieldStyles.input %>
    </div>
    <div class="w-full sm:w-56">
      <%= label_tag :sort_by, "Sort", class: Forms::FieldStyles::LABEL %>
      <%= select_tag :sort_by,
            options_for_select(
              [["Date saved", "date"], ["Status", "status"], ["Match score", "match_score"]],
              params[:sort_by]
            ),
            class: Forms::FieldStyles.input %>
    </div>
    <%= render Forms::SubmitComponent.new(form: f, text: "Apply", style: :secondary) %>
  <% end %>

  <%# Appears on selection, carries both actions, and reads one set of boxes. %>
  <div data-selection-target="toolbar" hidden
       class="rounded-card border border-navy-600 dark:border-sky-400 bg-sky-50 dark:bg-navy-900/40 p-4
              flex flex-wrap items-center gap-3">
    <span class="text-sm font-bold text-ink dark:text-ink-on-dark" data-selection-target="count"></span>

    <%= form_with url: bulk_update_saved_trials_path, method: :patch,
          data: {selection_target: "statusForm", selection_param: "saved_trial_ids[]"},
          class: "flex items-center gap-2" do %>
      <label for="bulk-status" class="sr-only">Move the selected studies to</label>
      <%= select_tag :status,
            options_for_select(SavedTrial::STATUSES.map { |s|
              [Shared::StatusBadgeComponent::STATUSES.dig(s, :label) || s.humanize, s]
            }),
            include_blank: "Mark as…",
            id: "bulk-status",
            class: Forms::FieldStyles.input(extra: "w-48 text-sm") %>
      <%= submit_tag "Move", class: Buttons::ButtonStyles.classes("primary", size: "px-3 py-2 text-sm") %>
    <% end %>

    <%= form_with url: my_trials_trial_comparison_path, method: :get,
          data: {selection_target: "statusForm", selection_param: "ids[]"} do %>
      <button type="submit" data-selection-target="compare"
              class="<%= Buttons::ButtonStyles.classes("secondary", size: "px-3 py-2 text-sm") %>">
        <span data-selection-target="compareLabel">Compare</span>
      </button>
    <% end %>

    <button type="button" data-action="selection#clear"
            class="<%= Buttons::ButtonStyles.classes("quiet", size: "px-3 py-2 text-sm") %>">
      Clear
    </button>
  </div>

  <% if @saved_trials.any? %>
    <label class="flex items-center gap-2 text-sm font-semibold text-ink-2 dark:text-ink-2-on-dark w-fit">
      <input type="checkbox" data-selection-target="selectAll" data-action="selection#toggleAll"
             class="w-4 h-4 rounded-sm border-line-2 dark:border-line-2-on-dark">
      Select all on this page
    </label>

    <ul class="flex flex-col gap-4">
      <% @saved_trials.each do |saved_trial| %>
        <li>
          <%= render Page::SavedTrials::CardComponent.new(saved_trial: saved_trial) %>
        </li>
      <% end %>
    </ul>

    <%= render Shared::PaginationComponent.new(
          pagy: @pagy,
          path_for: ->(page) { saved_trials_path(request.query_parameters.merge(page: page)) },
          unit: "study"
        ) %>
  <% else %>
    <div class="rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-10 text-center flex flex-col items-center gap-3">
      <h2 class="font-primary text-xl font-bold tracking-tight text-ink dark:text-ink-on-dark">
        <%= params[:status].present? || params[:search].present? ? "Nothing here matches" : "Nothing saved yet" %>
      </h2>
      <p class="text-sm text-ink-3 dark:text-ink-3-on-dark max-w-md">
        <% if params[:status].present? || params[:search].present? %>
          Try another status, or clear the search.
        <% else %>
          Saving a study keeps your notes, your tags and where you are with it in one place.
        <% end %>
      </p>
      <%= render Buttons::ButtonComponent.new(
            path: search_index_path, text: "Find studies", color: "primary"
          ) %>
    </div>
  <% end %>
</div>
