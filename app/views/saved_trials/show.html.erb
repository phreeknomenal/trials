<section class="px-5 lg:px-44 py-12 border-b border-line dark:border-line-on-dark">
  <div class="flex flex-col gap-4">
    <h1 class="text-3xl lg:text-4xl font-bold text-ink dark:text-ink-on-dark">
      <%= @saved_trial.trial_title %>
    </h1>

    <div class="flex flex-wrap gap-4 text-sm text-ink-3 dark:text-ink-3-on-dark">
      <div class="flex items-center gap-1">
        <%= render Utilities::IconComponent.new("profile_card", size: 6) %>
        <span><strong>NCT-ID:</strong> <%= @saved_trial.nct_id %></span>
      </div>
      
    </div>
  </div>
</section>

<section class="px-5 lg:px-44 pt-8 mb-5 lg:mb-8 flex flex-row justify-between items-center">
  <%= render Page::Navigation::BreadcrumbComponent.new %>

  <%= link_to saved_trials_path, class: "inline-flex items-center text-sky-600 dark:text-sky-300 hover:text-sky-700 dark:hover:text-sky-200 font-medium" do %>
    <%= render Utilities::IconComponent.new("arrow_left", size: 5) %>
    <span>Back to Saved Trials</span>
  <% end %>
</section>

<section class="px-5 lg:px-44 pt-8 pb-16">
  <div class="grid grid-cols-5 gap-8">
    <!-- Left Sidebar -->
    <div class="col-span-5 lg:col-span-1">
      <div class="w-full rounded-panel border border-line dark:border-line-on-dark p-6 space-y-4">
        <div class="flex items-center justify-between mb-3">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Status") %>
        </div>
        <%# BadgeComponent switches on the registry's trial status. This is the
            user's own pipeline status, a different vocabulary, and five of its
            seven values fell through to the default there. %>
        <%= render Shared::StatusBadgeComponent.new(status: @saved_trial.status) %>

        <% if @saved_trial.match_score.present? %>
          <div class="flex flex-col ">
            <%= render Typography::HeadingComponent.new(size: :h5, text: "Match Score") %>
            <%= render Page::SavedTrials::MatchScoreCardComponent.new(match_score: @saved_trial.match_score) %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Main Content -->
    <div class="col-span-5 lg:col-span-3 space-y-6">
      <!-- Summary Card -->
      <% if @saved_trial.summary.present? %>
        <div class="rounded-panel border border-line dark:border-line-on-dark p-6">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Trial Summary") %>
          <p class="text-ink-3 dark:text-ink-3-on-dark font-body leading-relaxed"><%= @saved_trial.summary %></p>
        </div>
      <% end %>

      <!-- Notes Card -->
      <div class="rounded-panel border border-line dark:border-line-on-dark p-6">
        <div class="flex items-center justify-between mb-3">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Notes") %>
          <%= link_to saved_trial_path(@saved_trial), class: "flex items-center gap-1 text-warn hover:text-warn font-medium" do %>
            <%= render Utilities::IconComponent.new("pencil", size: 4) %>
            <span>Edit</span>
          <% end %>
        </div>
        <% if @saved_trial.notes.present? %>
          <%# notes is has_rich_text, so this renders markup, not text. It was in
              a <p>, which put a div inside a paragraph, and whitespace-pre-wrap
              does nothing for content that already carries its own line breaks. %>
          <div class="prose prose-sm dark:prose-invert max-w-none text-ink-2 dark:text-ink-2-on-dark"><%= @saved_trial.notes %></div>
        <% else %>
          <p class="text-ink-3 font-body italic dark:text-ink-3-on-dark">No notes added yet. Add notes to help you remember why you saved this trial.</p>
        <% end %>
      </div>

      <!-- Tags Card -->
      <div class="rounded-panel border border-line dark:border-line-on-dark p-6">
        <div class="flex items-center justify-between mb-4">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Tags") %>
          <%= link_to saved_trial_path(@saved_trial), class: "flex items-center gap-1 text-warn hover:text-warn font-medium" do %>
            <%= render Utilities::IconComponent.new("pencil", size: 4) %>
            <span>Edit</span>
          <% end %>
        </div>
        <% if @saved_trial.tags_array.any? %>
          <div class="flex flex-wrap gap-2">
            <% @saved_trial.tags_array.each do |tag| %>
              <span class="inline-block bg-info/10 text-info px-3 py-1 rounded-full text-sm font-medium dark:text-info-on-dark">
                <%= tag %>
              </span>
            <% end %>
          </div>
        <% else %>
          <p class="text-ink-3 font-body italic dark:text-ink-3-on-dark">No tags added yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Right Sidebar -->
    <div class="col-span-5 lg:col-span-1">
      <div class="rounded-panel border border-line dark:border-line-on-dark p-6 sticky top-6 space-y-6">
        <!-- Key Details -->
        <div>
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Key Details") %>
          <div class="space-y-3 mt-3">
            <% if @saved_trial.phase.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Phase", record: @saved_trial.phase, icon: "swatch") %>
            <% end %>

            <% if @saved_trial.study_type.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Study Type", record: @saved_trial.study_type, icon: "rectangle_stack") %>
            <% end %>

            <% if @saved_trial.trial_status.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Trial Status", record: @saved_trial.trial_status.gsub("_", " ").titleize, icon: "exclamation_triangle") %>
            <% end %>

            <% if @saved_trial.min_age.present? || @saved_trial.max_age.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Age Range", record: [@saved_trial.min_age, @saved_trial.max_age].compact.join(" - "), icon: "calendar_month") %>
            <% end %>

            <% if @saved_trial.sponsor.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Sponsor", record: @saved_trial.sponsor, icon: "building_office") %>
            <% end %>

            <% if @saved_trial.enrollment_count.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Enrollment", record: @saved_trial.enrollment_count, icon: "users_group") %>
            <% end %>
          </div>
        </div>

        <!-- Trial Dates -->
        <% if @saved_trial.start_date.present? || @saved_trial.completion_date.present? %>
          <div>
            <h3 class="text-lg font-semibold text-ink mb-4 dark:text-ink-on-dark">Trial Timeline</h3>
            <div class="space-y-3">
              <% if @saved_trial.start_date.present? %>
                <div>
                  <p class="text-xs text-ink-3 uppercase tracking-wide dark:text-ink-3-on-dark">Start Date</p>
                  <p class="text-sm font-medium text-ink dark:text-ink-on-dark"><%= @saved_trial.start_date.strftime("%B %d, %Y") %></p>
                </div>
              <% end %>
              <% if @saved_trial.completion_date.present? %>
                <div>
                  <p class="text-xs text-ink-3 uppercase tracking-wide dark:text-ink-3-on-dark">Completion Date</p>
                  <p class="text-sm font-medium text-ink dark:text-ink-on-dark"><%= @saved_trial.completion_date.strftime("%B %d, %Y") %></p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="pt-4 border-t border-line dark:border-line-on-dark">
          <%= render Page::Trials::TileComponent.new(title: "Saved Date", record: @saved_trial.created_at.strftime("%b %d, %Y"), icon: "calendar_month") %>
        </div>

        <div class="pt-4 border-t border-line dark:border-line-on-dark space-y-2">
          <%= link_to "View Full Trial", search_path(@saved_trial.nct_id),
              class: "block w-full text-center px-4 py-2 bg-navy-600 text-white rounded-control hover:bg-navy-700 transition-colors font-medium" %>
          
          <%# Was a filled amber button: white on warn is 3.69:1, which fails in
              both themes, so dark mode only surfaced it. Amber was also the
              wrong signal for editing your own notes. Buttons::ButtonStyles is
              where a button's appearance is decided. %>
          <%= link_to "Edit Trial", edit_saved_trial_path(@saved_trial),
              class: "#{Buttons::ButtonStyles.classes("secondary")} block w-full" %>
          
          <%= link_to "Remove from Saved", saved_trial_path(@saved_trial),
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to remove this trial?" },
              class: "block w-full text-center px-4 py-2 text-crit dark:text-crit-on-dark hover:bg-crit/10 rounded-control transition-colors font-medium" %>
        </div>
      </div>
    </div>
  </div>
</section>

