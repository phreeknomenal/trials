<section class="px-5 lg:px-44 py-12 border-b border-zinc-200 dark:border-zinc-700">
  <div class="flex flex-col gap-4">
    <h1 class="text-3xl lg:text-4xl font-bold text-zinc-900 dark:text-zinc-100">
      <%= @saved_trial.trial_title %>
    </h1>

    <div class="flex flex-wrap gap-4 text-sm text-zinc-600 dark:text-zinc-400">
      <div class="flex items-center gap-1">
        <%= render Utilities::IconComponent.new("profile_card", size: 6) %>
        <span><strong>NCT-ID:</strong> <%= @saved_trial.nct_id %></span>
      </div>
      
    </div>
  </div>
</section>

<section class="px-5 lg:px-44 pt-8 mb-5 lg:mb-8 flex flex-row justify-between items-center">
  <%= render Page::Navigation::BreadcrumbComponent.new %>

  <%= link_to saved_trials_path, class: "inline-flex items-center text-lavender-600 hover:text-lavender-700 font-medium" do %>
    <%= render Utilities::IconComponent.new("arrow_left", size: 5) %>
    <span>Back to Saved Trials</span>
  <% end %>
</section>

<section class="px-5 lg:px-44 pt-8 pb-16">
  <div class="grid grid-cols-5 gap-8">
    <!-- Left Sidebar -->
    <div class="col-span-5 lg:col-span-1">
      <div class="w-full rounded-lg border border-zinc-200 dark:border-zinc-700 p-6 space-y-4">
        <div class="flex items-center justify-between mb-3">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Status") %>
        </div>
        <%= render Utilities::BadgeComponent.new(status: @saved_trial.status, size: :md) %>

        <% if @saved_trial.match_score.present? %>
          <div class="flex flex-col ">
            <%= render Typography::HeadingComponent.new(size: :h5, text: "Match Score") %>
            <%= render Page::SavedTrials::MatchScoreCardComponent.new(match_score: @saved_trial.match_score) %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Main Content -->
    <div class="col-span-5 lg:col-span-3 space-y-6">
      <!-- Summary Card -->
      <% if @saved_trial.summary.present? %>
        <div class="rounded-lg border border-zinc-200 dark:border-zinc-700 p-6">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Trial Summary") %>
          <p class="text-zinc-600 dark:text-zinc-400 font-body leading-relaxed"><%= @saved_trial.summary %></p>
        </div>
      <% end %>

      <!-- Notes Card -->
      <div class="rounded-lg border border-zinc-200 dark:border-zinc-700 p-6">
        <div class="flex items-center justify-between mb-3">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Notes") %>
          <%= link_to saved_trial_path(@saved_trial), class: "flex items-center gap-1 text-amber-600 hover:text-amber-700 font-medium" do %>
            <%= render Utilities::IconComponent.new("pencil", size: 4) %>
            <span>Edit</span>
          <% end %>
        </div>
        <% if @saved_trial.notes.present? %>
          <p class="text-gray-700 whitespace-pre-wrap"><%= @saved_trial.notes %></p>
        <% else %>
          <p class="text-gray-500 font-body italic">No notes added yet. Add notes to help you remember why you saved this trial.</p>
        <% end %>
      </div>

      <!-- Tags Card -->
      <div class="rounded-lg border border-zinc-200 dark:border-zinc-700 p-6">
        <div class="flex items-center justify-between mb-4">
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Tags") %>
          <%= link_to saved_trial_path(@saved_trial), class: "flex items-center gap-1 text-amber-600 hover:text-amber-700 font-medium" do %>
            <%= render Utilities::IconComponent.new("pencil", size: 4) %>
            <span>Edit</span>
          <% end %>
        </div>
        <% if @saved_trial.tags_array.any? %>
          <div class="flex flex-wrap gap-2">
            <% @saved_trial.tags_array.each do |tag| %>
              <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                <%= tag %>
              </span>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 font-body italic">No tags added yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Right Sidebar -->
    <div class="col-span-5 lg:col-span-1">
      <div class="rounded-lg border border-zinc-200 dark:border-zinc-700 p-6 sticky top-6 space-y-6">
        <!-- Key Details -->
        <div>
          <%= render Typography::HeadingComponent.new(size: :h5, text: "Key Details") %>
          <div class="space-y-3 mt-3">
            <% if @saved_trial.phase.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Phase", record: @saved_trial.phase, icon: "swatch") %>
            <% end %>

            <% if @saved_trial.study_type.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Study Type", record: @saved_trial.study_type, icon: "rectangle_stack") %>
            <% end %>

            <% if @saved_trial.trial_status.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Trial Status", record: @saved_trial.trial_status.gsub("_", " ").titleize, icon: "exclamation_triangle") %>
            <% end %>

            <% if @saved_trial.min_age.present? || @saved_trial.max_age.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Age Range", record: [@saved_trial.min_age, @saved_trial.max_age].compact.join(" - "), icon: "calendar_month") %>
            <% end %>

            <% if @saved_trial.sponsor.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Sponsor", record: @saved_trial.sponsor, icon: "building_office") %>
            <% end %>

            <% if @saved_trial.enrollment_count.present? %>
              <%= render Page::Trials::TileComponent.new(title: "Enrollment", record: @saved_trial.enrollment_count, icon: "users_group") %>
            <% end %>
          </div>
        </div>

        <!-- Trial Dates -->
        <% if @saved_trial.start_date.present? || @saved_trial.completion_date.present? %>
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Trial Timeline</h3>
            <div class="space-y-3">
              <% if @saved_trial.start_date.present? %>
                <div>
                  <p class="text-xs text-gray-600 uppercase tracking-wide">Start Date</p>
                  <p class="text-sm font-medium text-gray-900"><%= @saved_trial.start_date.strftime("%B %d, %Y") %></p>
                </div>
              <% end %>
              <% if @saved_trial.completion_date.present? %>
                <div>
                  <p class="text-xs text-gray-600 uppercase tracking-wide">Completion Date</p>
                  <p class="text-sm font-medium text-gray-900"><%= @saved_trial.completion_date.strftime("%B %d, %Y") %></p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="pt-4 border-t border-zinc-200 dark:border-zinc-700">
          <%= render Page::Trials::TileComponent.new(title: "Saved Date", record: @saved_trial.created_at.strftime("%b %d, %Y"), icon: "calendar_month") %>
        </div>

        <div class="pt-4 border-t border-zinc-200 dark:border-zinc-700 space-y-2">
          <%= link_to "View Full Trial", my_trial_path(@saved_trial.nct_id),
              class: "block w-full text-center px-4 py-2 bg-lavender-600 text-white rounded-lg hover:bg-lavender-700 transition-colors font-medium" %>
          
          <%= link_to "Edit Trial", edit_saved_trial_path(@saved_trial),
              class: "block w-full text-center px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors font-medium" %>
          
          <%= link_to "Remove from Saved", saved_trial_path(@saved_trial),
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to remove this trial?" },
              class: "block w-full text-center px-4 py-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors font-medium" %>
        </div>
      </div>
    </div>
  </div>
</section>

