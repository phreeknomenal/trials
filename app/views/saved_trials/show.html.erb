<%# A saved study, rebuilt against the "Saved study, open and editing" board.

    The pipeline leads, because changing status is what people open this page to
    do. It used to be a select inside the edit form, behind a Save.

    Two things the board draws that are not here. The distance beside the
    location ("Birmingham, AL · 4 mi") needs geocoding at both ends and stored
    coordinates, which the app does not have and which this file already records
    for the results page. And "4 mi" on a saved study would be measured against
    a profile that may have moved since. %>

<% content_for :title, "#{@saved_trial.trial_title} - Dira Health" %>

<div class="<%= Layout::PageWidth::CONTAINER %> py-10 flex flex-col gap-6">

  <%= link_to saved_trials_path,
        class: "inline-flex items-center gap-2 text-sm font-semibold text-sky-600 dark:text-sky-300 hover:text-sky-700 dark:hover:text-sky-200 w-fit" do %>
    <%= render Utilities::IconComponent.new("arrow_left", size: 4) %>
    All saved studies
  <% end %>

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex flex-col gap-2 min-w-0">
      <h1 class="font-primary text-2xl lg:text-3xl font-bold tracking-tight text-ink dark:text-ink-on-dark">
        <%= @saved_trial.trial_title %>
      </h1>
      <span class="font-mono text-sm text-ink-3 dark:text-ink-3-on-dark"><%= @saved_trial.nct_id %></span>
    </div>
    <%= render Buttons::ButtonComponent.new(
          path: search_path(@saved_trial.nct_id), text: "Open the full study",
          color: "secondary", icon: "external_link", icon_position: "right"
        ) %>
  </div>

  <%= render Page::SavedTrials::PipelineComponent.new(saved_trial: @saved_trial) %>

  <div class="grid gap-6 lg:grid-cols-[1fr_320px] items-start">

    <div class="flex flex-col gap-6">
      <section class="rounded-card border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-5 lg:p-6 flex flex-col gap-3">
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-primary text-base font-bold tracking-tight text-ink dark:text-ink-on-dark">Your notes</h2>
          <%= link_to edit_saved_trial_path(@saved_trial),
                class: "inline-flex items-center gap-1.5 text-sm font-semibold text-sky-600 dark:text-sky-300" do %>
            <%= render Utilities::IconComponent.new("pencil", size: 4) %>
            Edit
          <% end %>
        </div>
        <% if @saved_trial.notes.present? %>
          <div class="prose prose-sm max-w-none text-ink-2 dark:text-ink-2-on-dark">
            <%= @saved_trial.notes %>
          </div>
        <% else %>
          <p class="text-sm italic text-ink-3 dark:text-ink-3-on-dark">
            Nothing yet. Notes are where the coordinator's name and what they said go.
          </p>
        <% end %>
      </section>

      <section class="rounded-card border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-5 lg:p-6 flex flex-col gap-3">
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-primary text-base font-bold tracking-tight text-ink dark:text-ink-on-dark">Tags</h2>
          <%= link_to "Edit", edit_saved_trial_path(@saved_trial),
                class: "text-sm font-semibold text-sky-600 dark:text-sky-300" %>
        </div>
        <% if @saved_trial.tags_array.any? %>
          <ul class="flex flex-wrap gap-2">
            <% @saved_trial.tags_array.each do |tag| %>
              <li class="rounded-chip bg-sky-50 dark:bg-navy-900/40 px-2.5 py-1 text-xs font-semibold text-sky-700 dark:text-sky-300">
                <%= tag %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm italic text-ink-3 dark:text-ink-3-on-dark">No tags yet.</p>
        <% end %>
      </section>

      <% if @saved_trial.summary.present? %>
        <section class="rounded-card border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-5 lg:p-6 flex flex-col gap-3">
          <h2 class="font-primary text-base font-bold tracking-tight text-ink dark:text-ink-on-dark">What the registry says</h2>
          <p class="text-sm leading-relaxed text-ink-2 dark:text-ink-2-on-dark"><%= @saved_trial.summary %></p>
          <p class="text-xs text-ink-3 dark:text-ink-3-on-dark">
            Saved when you bookmarked it. The live record may have changed since.
          </p>
        </section>
      <% end %>
    </div>

    <div class="flex flex-col gap-6">
      <% if @saved_trial.match_score.present? %>
        <section class="rounded-card border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-5 flex flex-col gap-3">
          <h2 class="font-primary text-base font-bold tracking-tight text-ink dark:text-ink-on-dark">Your match</h2>
          <div class="flex items-center gap-3">
            <span class="rounded-control bg-sky-700 dark:bg-sky-300 px-3 py-2 flex flex-col items-center leading-none">
              <span class="text-xl font-extrabold tabular-nums text-white dark:text-navy-900"><%= @saved_trial.match_score.to_i %></span>
              <span class="text-[9px] font-bold tracking-wider text-sky-100 dark:text-navy-800">OF 100</span>
            </span>
            <%# Said plainly rather than implied. The score was worked out against
                the profile as it stood when the study was saved, and a profile
                that has changed since would score it differently. %>
            <p class="text-sm leading-relaxed text-ink-2 dark:text-ink-2-on-dark">
              Scored against the profile you had when you saved this.
            </p>
          </div>
          <%= link_to "See which criteria you meet", search_path(@saved_trial.nct_id),
                class: "text-sm font-semibold text-sky-600 dark:text-sky-300" %>
        </section>
      <% end %>

      <section class="rounded-card border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-5 flex flex-col gap-3">
        <h2 class="font-primary text-base font-bold tracking-tight text-ink dark:text-ink-on-dark">Key details</h2>
        <dl class="flex flex-col gap-2">
          <% [
               ["Phase", humanize_registry_value(@saved_trial.phase)],
               ["Study type", humanize_registry_value(@saved_trial.study_type)],
               ["Recruitment", humanize_registry_value(@saved_trial.trial_status)],
               ["Ages", [@saved_trial.min_age, @saved_trial.max_age].compact.join(" to ").presence],
               ["Sponsor", @saved_trial.sponsor],
               ["Enrolling", @saved_trial.enrollment_count && "#{number_with_delimiter(@saved_trial.enrollment_count)} people"]
             ].each do |label, value| %>
            <% next if value.blank? %>
            <div class="rounded-control border border-line dark:border-line-on-dark px-3 py-2 flex flex-col gap-0.5">
              <dt class="text-[11px] font-bold uppercase tracking-wider text-ink-4 dark:text-ink-4-on-dark"><%= label %></dt>
              <dd class="text-sm font-semibold text-ink dark:text-ink-on-dark"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      </section>

      <% if @saved_trial.start_date.present? || @saved_trial.completion_date.present? %>
        <section class="rounded-card border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-5 flex flex-col gap-3">
          <h2 class="font-primary text-base font-bold tracking-tight text-ink dark:text-ink-on-dark">Timeline</h2>
          <ul class="flex flex-col gap-2">
            <% if @saved_trial.start_date.present? %>
              <li class="flex items-center gap-2 text-sm text-ink-2 dark:text-ink-2-on-dark">
                <span class="w-2 h-2 rounded-full bg-sky-500 dark:bg-sky-400 shrink-0"></span>
                Started <%= @saved_trial.start_date.to_fs(:long) %>
              </li>
            <% end %>
            <% if @saved_trial.completion_date.present? %>
              <li class="flex items-center gap-2 text-sm text-ink-2 dark:text-ink-2-on-dark">
                <span class="w-2 h-2 rounded-full bg-line-2 dark:bg-line-2-on-dark shrink-0"></span>
                Expected to finish <%= @saved_trial.completion_date.to_fs(:long) %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <%= button_to "Remove from saved", saved_trial_path(@saved_trial),
            method: :delete,
            form: {data: {turbo_confirm: "Remove this study from your saved list? Your notes and tags go with it."}},
            class: "text-sm font-semibold text-crit dark:text-crit-on-dark text-left hover:underline underline-offset-4 cursor-pointer" %>
    </div>
  </div>
</div>
