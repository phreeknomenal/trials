<%# Editing a saved study, against the board.

    Status is not on this form any more. It is the pipeline control on the show
    page, because changing status is the thing people come here to do and it
    should not need a form and a Save. The controller still permits it, so the
    pipeline's own PATCH goes through the same action.

    The match score was already read-only and is simply absent now: it is not
    something anyone edits, and a disabled field for a number you cannot change
    is furniture. PR #146 stopped `update` permitting it. %>

<% content_for :title, "Your notes - Dira Health" %>

<div class="<%= Layout::PageWidth::CONTAINER %> py-10 max-w-3xl flex flex-col gap-6">

  <%= link_to saved_trial_path(@saved_trial),
        class: "inline-flex items-center gap-2 text-sm font-semibold text-sky-600 dark:text-sky-300 hover:text-sky-700 dark:hover:text-sky-200 w-fit" do %>
    <%= render Utilities::IconComponent.new("arrow_left", size: 4) %>
    Back to the study
  <% end %>

  <div class="flex flex-col gap-1.5">
    <h1 class="font-primary text-2xl lg:text-3xl font-bold tracking-tight text-ink dark:text-ink-on-dark">
      Your notes on this study
    </h1>
    <p class="text-sm text-ink-3 dark:text-ink-3-on-dark"><%= @saved_trial.trial_title %></p>
  </div>

  <%= form_with model: @saved_trial, local: true,
        class: "rounded-card border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-6 flex flex-col gap-6" do |f| %>

    <% if @saved_trial.errors.any? %>
      <div class="rounded-card border border-crit dark:border-crit-on-dark bg-crit/5 dark:bg-crit-on-dark/10 p-4 flex gap-3 items-start" role="alert">
        <span class="text-crit dark:text-crit-on-dark shrink-0 mt-0.5">
          <%= render Utilities::IconComponent.new("exclamation_circle", size: 5) %>
        </span>
        <p class="text-sm font-semibold text-crit dark:text-crit-on-dark">
          Nothing was saved. <%= @saved_trial.errors.full_messages.to_sentence %>.
        </p>
      </div>
    <% end %>

    <%= render Forms::FieldComponent.new(
          form: f, attribute: :notes, label: "Notes", field_type: :rich_text,
          hint: "Only you can see this. Write down anything you want to remember when the coordinator calls back."
        ) %>

    <%# Stored as one comma-separated string, which is what the hint says. The
        board draws removable chips; that is a Stimulus control and its own
        piece of work, and a text field that plainly states its format is
        honest in the meantime. %>
    <%= render Forms::FieldComponent.new(
          form: f, attribute: :tags, label: "Tags",
          options: {placeholder: "travel ok, ask about insulin, UAB"},
          hint: "Separate them with commas."
        ) %>

    <div class="flex flex-wrap items-center gap-3">
      <%= render Forms::SubmitComponent.new(form: f, text: "Save notes", style: :primary) %>
      <%= render Buttons::ButtonComponent.new(
            path: saved_trial_path(@saved_trial), text: "Cancel", color: "secondary"
          ) %>
    </div>
  <% end %>
</div>
