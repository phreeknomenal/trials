<section class="px-5 lg:px-24 py-16 border-b border-line dark:border-line-on-dark">
  <div class="flex flex-col justify-center items-center">
    <h3 class="text-3xl font-bold leading-none text-center mb-2 text-ink dark:text-ink-2-on-dark">Edit Saved Trial</h3>
    <span class="text-sm font-body font-medium text-center text-ink-3 dark:text-ink-3-on-dark max-w-2xl">
      <%= truncate(@saved_trial.trial_title, length: 100) %>
    </span>
  </div>
</section>

<section class="px-5 lg:px-36 py-16 flex justify-center items-center">
  <div class="flex gap-10 max-w-4xl">
    <!-- Main Form -->
    <div class="w-full lg:w-2/3">
      <%= form_with model: @saved_trial, local: true, class: "space-y-6" do |f| %>
        <!-- Status -->
        <div>
          <%= f.label :status, "Status", class: "block text-sm font-semibold text-ink dark:text-ink-on-dark mb-2" %>
          <%= f.select :status, 
              options_for_select(SavedTrial::STATUSES, @saved_trial.status),
              { include_blank: false },
              class: "w-full px-4 py-2 border border-line-2 dark:border-line-2-on-dark rounded-lg bg-surface dark:bg-surface-on-dark text-ink dark:text-ink-on-dark focus:ring-2 focus:ring-sky-500 focus:border-transparent" %>
        </div>

        <!-- Notes -->
        <div>
          <%= f.label :notes, "Notes", class: "block text-sm font-semibold text-ink dark:text-ink-on-dark mb-2" %>
          <%= f.rich_textarea :notes,
              placeholder: "Add personal notes about this trial...",
              rows: 6,
              class: "w-full px-4 py-2 border border-line-2 dark:border-line-2-on-dark rounded-lg bg-surface dark:bg-surface-on-dark text-ink dark:text-ink-on-dark focus:ring-2 focus:ring-sky-500 focus:border-transparent" %>
          <p class="text-xs text-ink-3 dark:text-ink-3-on-dark mt-2">Write anything helpful to remember about this trial</p>
        </div>

        <!-- Tags -->
        <div>
          <%= f.label :tags, "Tags", class: "block text-sm font-semibold text-ink dark:text-ink-on-dark mb-2" %>
          <%= f.text_field :tags,
              placeholder: "Enter tags separated by commas",
              value: @saved_trial.tags_array.join(", "),
              class: "w-full px-4 py-2 border border-line-2 dark:border-line-2-on-dark rounded-lg bg-surface dark:bg-surface-on-dark text-ink dark:text-ink-on-dark focus:ring-2 focus:ring-sky-500 focus:border-transparent" %>
          <p class="text-xs text-ink-3 dark:text-ink-3-on-dark mt-2">Separate multiple tags with commas (e.g., promising, nearby, good phase)</p>
        </div>

        <!-- Match Score (read-only) -->
        <% if @saved_trial.match_score.present? %>
          <div>
            <%= f.label :match_score, "Match Score", class: "block text-sm font-semibold text-ink dark:text-ink-on-dark mb-2" %>
            <div class="px-4 py-3 border border-line-2 dark:border-line-2-on-dark rounded-lg bg-surface-2 dark:bg-surface-on-dark">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-bold text-sky-600"><%= @saved_trial.match_score %></span>
                <span class="text-ink-3 dark:text-ink-3-on-dark">% from your last search</span>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Actions -->
        <div class="flex gap-3 pt-6 border-t border-line dark:border-line-on-dark">
          <%= f.submit "Save Changes", class: "px-6 py-2 bg-navy-600 text-white font-medium rounded-lg hover:bg-navy-700 transition-colors" %>
          <%= link_to "Cancel", saved_trial_path(@saved_trial), class: "px-6 py-2 border border-line-2 dark:border-line-2-on-dark text-ink-2 dark:text-ink-2-on-dark font-medium rounded-lg hover:bg-surface-2 dark:hover:bg-surface-on-dark transition-colors" %>
        </div>
      <% end %>
    </div>

    <!-- Sidebar Info -->
    <div class="w-full lg:w-1/3">
      <div class="bg-sky-50 dark:bg-navy-900/20 border border-sky-200 dark:border-sky-800 rounded-lg p-6">
        <p class="text-sm font-semibold text-navy-900 dark:text-sky-100 mb-3">
          💡 Quick Tip
        </p>
        <p class="text-sm text-sky-800 dark:text-sky-200 leading-relaxed">
          Use the Status field to track where you are in the process. Add notes to remember why this trial interests you, and use tags to organize your saved trials.
        </p>
      </div>
    </div>
  </div>
</section>
