<section class="px-5 lg:px-24 py-16 border-b border-zinc-200 dark:border-zinc-700">
  <div class="flex flex-col justify-center items-center">
    <h3 class="text-3xl font-bold leading-none text-center mb-2 text-zinc-900 dark:text-zinc-300">Edit Saved Trial</h3>
    <span class="text-sm font-body font-medium text-center text-zinc-600 dark:text-zinc-400 max-w-2xl">
      <%= truncate(@saved_trial.trial_title, length: 100) %>
    </span>
  </div>
</section>

<section class="px-5 lg:px-36 py-16 flex justify-center items-center">
  <div class="flex gap-10 max-w-4xl">
    <!-- Main Form -->
    <div class="w-full lg:w-2/3">
      <%= form_with model: @saved_trial, local: true, class: "space-y-6" do |f| %>
        <!-- Status -->
        <div>
          <%= f.label :status, "Status", class: "block text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-2" %>
          <%= f.select :status, 
              options_for_select(SavedTrial::STATUSES, @saved_trial.status),
              { include_blank: false },
              class: "w-full px-4 py-2 border border-zinc-300 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:ring-2 focus:ring-lavender-500 focus:border-transparent" %>
        </div>

        <!-- Notes -->
        <div>
          <%= f.label :notes, "Notes", class: "block text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-2" %>
          <%= f.rich_textarea :notes,
              placeholder: "Add personal notes about this trial...",
              rows: 6,
              class: "w-full px-4 py-2 border border-zinc-300 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:ring-2 focus:ring-lavender-500 focus:border-transparent" %>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2">Write anything helpful to remember about this trial</p>
        </div>

        <!-- Tags -->
        <div>
          <%= f.label :tags, "Tags", class: "block text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-2" %>
          <%= f.text_field :tags,
              placeholder: "Enter tags separated by commas",
              value: @saved_trial.tags_array.join(", "),
              class: "w-full px-4 py-2 border border-zinc-300 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:ring-2 focus:ring-lavender-500 focus:border-transparent" %>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2">Separate multiple tags with commas (e.g., promising, nearby, good phase)</p>
        </div>

        <!-- Match Score (read-only) -->
        <% if @saved_trial.match_score.present? %>
          <div>
            <%= f.label :match_score, "Match Score", class: "block text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-2" %>
            <div class="px-4 py-3 border border-zinc-300 dark:border-zinc-600 rounded-lg bg-zinc-50 dark:bg-zinc-800">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-bold text-lavender-600"><%= @saved_trial.match_score %></span>
                <span class="text-zinc-600 dark:text-zinc-400">% from your last search</span>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Actions -->
        <div class="flex gap-3 pt-6 border-t border-zinc-200 dark:border-zinc-700">
          <%= f.submit "Save Changes", class: "px-6 py-2 bg-lavender-600 text-white font-medium rounded-lg hover:bg-lavender-700 transition-colors" %>
          <%= link_to "Cancel", saved_trial_path(@saved_trial), class: "px-6 py-2 border border-zinc-300 dark:border-zinc-600 text-zinc-700 dark:text-zinc-300 font-medium rounded-lg hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors" %>
        </div>
      <% end %>
    </div>

    <!-- Sidebar Info -->
    <div class="w-full lg:w-1/3">
      <div class="bg-lavender-50 dark:bg-lavender-900/20 border border-lavender-200 dark:border-lavender-800 rounded-lg p-6">
        <p class="text-sm font-semibold text-lavender-900 dark:text-lavender-100 mb-3">
          💡 Quick Tip
        </p>
        <p class="text-sm text-lavender-800 dark:text-lavender-200 leading-relaxed">
          Use the Status field to track where you are in the process. Add notes to remember why this trial interests you, and use tags to organize your saved trials.
        </p>
      </div>
    </div>
  </div>
</section>
