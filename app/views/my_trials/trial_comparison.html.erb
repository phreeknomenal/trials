<section class="<%= Layout::PageWidth::CONTAINER %> py-10 lg:py-12 flex flex-col gap-5">
  <%= link_to my_trials_saved_trials_path,
        class: "self-start inline-flex items-center gap-2 text-meta font-semibold text-sky-700 dark:text-sky-300 hover:underline" do %>
    <%= render Utilities::IconComponent.new("arrow_left", size: 4) %>
    Back to saved studies
  <% end %>

  <%# The count is spelled, as on the board. Comparison is capped at three, so
      this is never a number a reader has to parse. %>
  <h1 class="font-primary text-2xl lg:text-title font-bold tracking-tight text-ink dark:text-ink-on-dark">
    <%= (@saved_trials.length == 2) ? "Two" : "Three" %> studies, side by side
  </h1>

  <%= render Page::Trials::ComparisonTableComponent.new(
        saved_trials: @saved_trials, scored_by_id: @scored_by_id
      ) %>

  <%# The working behind the numbers in the column heads, the same shape the
      criteria panel uses on a study: the comparison is the answer and this is
      how each score was arrived at. The board has no such section, and a second
      full-width table of per-factor bars under the first is why. %>
  <details class="rounded-panel border border-line dark:border-line-on-dark bg-surface dark:bg-surface-on-dark p-6 group">
    <summary class="cursor-pointer list-none flex items-center gap-2 text-meta font-semibold text-ink-2 dark:text-ink-2-on-dark rounded-nav focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
      <span class="text-ink-3 dark:text-ink-3-on-dark transition-transform group-open:rotate-180">
        <%= render Utilities::IconComponent.new("chevron_down", size: 4) %>
      </span>
      How these scores break down
    </summary>

    <div class="pt-4">
      <%= render Page::Trials::ComparisonScoreBreakdownComponent.new(trials: @saved_trials) %>
    </div>
  </details>
</section>
