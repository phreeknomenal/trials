<section class="px-5 lg:px-44 py-12 border-b border-zinc-200 dark:border-zinc-700">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 mb-2">Compare Trials</h1>
      <p class="text-zinc-600 dark:text-zinc-400">
        Comparing <%= @saved_trials.count %> trials side-by-side
      </p>
    </div>
    <%= link_to "← Back to Saved Trials", my_trials_saved_trials_path, 
        class: "text-lavender-600 dark:text-lavender-400 hover:underline font-medium" %>
  </div>
</section>

<section class="px-5 lg:px-44 py-12">
  <div class="overflow-x-auto rounded-lg border border-zinc-200 dark:border-zinc-700 shadow-md bg-white dark:bg-zinc-800">
    <table class="w-full min-w-[800px] border-collapse">
      <thead>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <th scope="col" class="text-left py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 bg-transparent align-top w-40">
            Trial Details
          </th>
          <% @saved_trials.each do |trial| %>
            <th scope="col" class="text-left py-4 px-5 align-top border-l border-zinc-200 dark:border-zinc-700 min-w-[280px]">
              <div class="space-y-2">
                <p class="text-sm text-zinc-500 dark:text-zinc-400">NCT<%= trial.nct_id %></p>
                <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 line-clamp-2 text-base leading-snug">
                  <%= trial.trial_title %>
                </h3>
                <% if trial.match_score.present? %>
                  <% match_component = Page::SavedTrials::MatchScoreCardComponent.new(match_score: trial.match_score) %>
                  <div class="flex flex-wrap items-center gap-2 pt-1">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold <%= match_component.score_badge_classes %>">
                      <%= trial.match_score %>% Match
                    </span>
                    <span class="text-sm font-medium <%= match_component.score_color_classes %>"><%= match_component.score_label %></span>
                  </div>
                <% end %>
              </div>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Status</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 border-l border-zinc-200 dark:border-zinc-700">
              <span class="inline-block px-3 py-1 rounded-full text-sm font-medium <%= status_badge_classes(trial.status) %>">
                <%= trial.status.titleize %>
              </span>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Phase</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700">
              <%= trial.phase.presence || "—" %>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Study Type</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700">
              <%= trial.study_type.presence || "—" %>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Age Range</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700">
              <%= trial.min_age.present? || trial.max_age.present? ? "#{trial.min_age} - #{trial.max_age}" : "—" %>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Sponsor(s)</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700 align-top max-w-[280px]">
              <span class="block line-clamp-2 break-words"><%= trial.sponsor.presence || "—" %></span>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Summary</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700 align-top max-w-[280px]">
              <span class="block line-clamp-3 break-words"><%= trial.summary.presence || "—" %></span>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Enrollment</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700">
              <%= trial.enrollment_count.present? ? "#{number_with_delimiter(trial.enrollment_count)} participants" : "—" %>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Trial Status</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 border-l border-zinc-200 dark:border-zinc-700">
              <%= render Utilities::BadgeComponent.new(status: trial.trial_status, text: trial.trial_status.blank? ? "—" : nil) %>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Start Date</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700">
              <%= trial.start_date.present? ? trial.start_date.strftime("%B %Y") : "—" %>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Completion Date</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700">
              <%= trial.completion_date.present? ? trial.completion_date.strftime("%B %Y") : "—" %>
            </td>
          <% end %>
        </tr>
        <tr class="border-b border-zinc-200 dark:border-zinc-700">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400">Duration</td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 text-sm text-zinc-900 dark:text-zinc-100 border-l border-zinc-200 dark:border-zinc-700">
              <%= trial_duration(trial.start_date, trial.completion_date).presence || "—" %>
            </td>
          <% end %>
        </tr>
        <tr class="bg-zinc-50 dark:bg-zinc-700/50">
          <td class="py-4 px-5 text-xs font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-400"></td>
          <% @saved_trials.each do |trial| %>
            <td class="py-4 px-5 border-l border-zinc-200 dark:border-zinc-700 space-y-2">
              <%= link_to "View Full Trial", my_trial_path(trial.nct_id), 
                  class: "block w-full px-4 py-2 bg-lavender-600 text-white rounded-lg hover:bg-lavender-700 transition-colors text-center font-medium text-sm" %>
              <%= link_to "Edit Entry", edit_saved_trial_path(trial), 
                  class: "block w-full px-4 py-2 bg-white dark:bg-zinc-800 border-2 border-lavender-600 text-lavender-600 dark:text-lavender-400 rounded-lg hover:bg-lavender-50 dark:hover:bg-lavender-900/20 transition-colors text-center font-medium text-sm" %>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="px-5 lg:px-44 py-12">
  <%= render Page::Trials::ComparisonScoreBreakdownComponent.new(trials: @saved_trials) %>
</section>
