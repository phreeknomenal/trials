<section class="px-5 lg:px-24 py-16 border-b border-zinc-200 dark:border-zinc-700">
  <%= render Page::HeaderComponent.new(
    heading: "Find Your Trials",
    subheading: "Personalized clinical trial matches based on your health profile",
    position: :left
  ) %>
</section>

<div class="min-h-screen">
  <div class="px-5 lg:px-24 py-10 lg:py-18">
    <!-- Search Form -->
    <div class="border border-zinc-200 dark:border-zinc-700 rounded-lg p-6 mb-8">
      <%= form_with url: my_trials_search_path, method: :get, class: "space-y-6" do |f| %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Condition -->
          <div class="form-group">
            <%= f.label :condition, "Condition", class: "block text-sm font-medium text-zinc-900 dark:text-zinc-300 mb-2" %>
            <%= f.select :condition, 
                options_for_select(@conditions.pluck(:name, :name), params[:condition]),
                { include_blank: "Select a condition" },
                { class: "block p-2 w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 placeholder:text-zinc-500 dark:placeholder:text-zinc-400 text-base text-zinc-900 dark:text-zinc-300 rounded focus:ring-lavender-600 focus:border-lavender-600" } 
            %>
          </div>

          <!-- Location -->
          <div class="form-group">
            <%= f.label :location, "Location (City, State)", class: "block text-sm font-medium text-zinc-900 dark:text-zinc-300 mb-2" %>
            <%= f.text_field :location, 
                value: params[:location],
                placeholder: "e.g., Boston, MA",
                class: "block w-full form-control bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-zinc-300 text-base rounded focus:ring-lavender-600 focus:border-lavender-600 p-2" 
            %>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex gap-4">
          <%= f.submit "Search", class: "cursor-pointer inline-flex items-center px-6 py-2 border border-transparent text-base font-medium rounded-md text-white bg-lavender-600 hover:bg-lavender-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-lavender-500" %>
        </div>
      <% end %>
    </div>

    <!-- Search Results -->
    <% if @studies_with_scores.present? %>
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-300 mb-2">
          Search Results
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400">
          Found <%= number_with_delimiter(@total_count) %> clinical trials matched to your profile
        </p>
      </div>

      <!-- Sorting Options -->
      <div class="mb-6 flex items-center gap-4">
        <%= form_with url: my_trials_search_path, method: :get, class: "flex gap-2" do |f| %>
          <%= f.hidden_field :condition, value: params[:condition] %>
          <%= f.hidden_field :location, value: params[:location] %>
          <%= f.label :sort_by, "Sort by:", class: "text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
          <%= f.select :sort_by,
              options_for_select(
                [["Match Score (High to Low)", "score_desc"], ["Match Score (Low to High)", "score_asc"], ["Newest First", "newest"]],
                params[:sort_by] || "score_desc"
              ),
              { include_blank: false },
              class: "block p-2 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-base text-zinc-900 dark:text-zinc-300 rounded focus:ring-lavender-600 focus:border-lavender-600" %>
          <%= f.submit "Update", class: "cursor-pointer px-4 py-2 text-sm font-medium bg-lavender-600 text-white rounded hover:bg-lavender-700" %>
        <% end %>
      </div>

      <!-- Results Grid -->
      <div class="space-y-8 mb-8">
        <% @studies_with_scores.each do |study_with_score| %>
          <%= render Page::Cards::StudyCardComponent.new(study: study_with_score, base_path: :my_trials) %>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @current_page > 1 || @has_next_page %>
        <div class="flex justify-center gap-4 items-center">
          <% if @current_page > 1 %>
            <%= link_to "Previous", my_trials_search_path(pagination_params.merge(page: @current_page - 1, page_token: @prev_page_token).compact),
                class: "px-4 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded hover:bg-zinc-50 dark:hover:bg-zinc-700" %>
          <% end %>

          <span class="text-sm text-zinc-600 dark:text-zinc-400">
            Page <%= @current_page %>
          </span>

          <% if @has_next_page %>
            <%= link_to "Next", my_trials_search_path(pagination_params.merge(page: @current_page + 1, page_token: @next_page_token).compact),
                class: "px-4 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded hover:bg-zinc-50 dark:hover:bg-zinc-700" %>
          <% end %>
        </div>
      <% end %>

    <% elsif params[:condition].present? || params[:location].present? %>
      <!-- No Results -->
      <div class="bg-zinc-100 dark:bg-zinc-800 rounded-lg p-8 text-center">
        <h3 class="text-lg font-medium text-zinc-900 dark:text-zinc-100 mb-2">No trials found</h3>
        <p class="text-zinc-600 dark:text-zinc-400 mb-4">
          Try adjusting your search criteria or selecting a different condition or location.
        </p>
      </div>

    <% else %>
      <!-- Initial State -->
      <div class="bg-gradient-to-r from-lavender-50 to-blue-50 dark:from-lavender-900/20 dark:to-blue-900/20 border border-lavender-200 dark:border-lavender-800 rounded-lg p-8 text-center">
        <h3 class="text-lg font-medium text-zinc-900 dark:text-zinc-100 mb-2">Ready to search?</h3>
        <p class="text-zinc-600 dark:text-zinc-400">
          Select a condition and location above to see personalized trial matches based on your health profile.
        </p>
      </div>
    <% end %>
  </div>
</div>

