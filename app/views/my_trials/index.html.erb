<section class="px-5 lg:px-44 py-16 border-b border-zinc-200 dark:border-zinc-700">
  <div class="flex flex-col justify-center items-center">
    <h1 class="text-4xl font-bold text-center mb-3 text-zinc-900 dark:text-zinc-100">
      Welcome back, <%= @profile.first_name %>!
    </h1>
    <p class="text-lg text-zinc-600 dark:text-zinc-400 text-center max-w-2xl">
      Manage your saved clinical trials and discover new matches
    </p>
  </div>
</section>

<section class="px-5 lg:px-44 py-16">
  <div class="grid grid-cols-4 gap-6 mb-10">
    <div class="col-span-2 lg:col-span-1 bg-white dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700 p-8">
      <p class="text-4xl font-bold text-lavender-600 dark:text-lavender-400"><%= @saved_trials_count %></p>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2">Saved Trials</p>
    </div>
    <div class="col-span-2 lg:col-span-1 bg-white dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700 p-8">
      <p class="text-4xl font-bold text-green-600 dark:text-green-400"><%= @excellent_count %></p>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2">Excellent Match</p>
    </div>
    <div class="col-span-2 lg:col-span-1 bg-white dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700 p-8">
      <p class="text-4xl font-bold text-blue-600 dark:text-blue-400"><%= @good_count %></p>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2">Good Match</p>
    </div>
    <div class="col-span-2 lg:col-span-1 bg-white dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700 p-8">
      <p class="text-4xl font-bold text-amber-600 dark:text-amber-400"><%= @fair_count %></p>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2">Fair Match</p>
    </div>
  </div>

  <!-- Action Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
    <!-- Saved Trials Card -->
    <div class="bg-white dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700 p-8 hover:shadow-lg transition-shadow">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-2">Saved Trials</h2>
          <p class="text-zinc-600 dark:text-zinc-400">
            Manage and organize your saved clinical trials. Edit status, add notes, and keep track of your progress.
          </p>
        </div>
        <div class="text-3xl">📋</div>
      </div>
      <div class="mt-6 pt-6 border-t border-zinc-200 dark:border-zinc-700">
        <%= link_to "View All Saved Trials", my_trials_saved_trials_path, 
            class: "inline-block px-6 py-2 bg-lavender-600 text-white rounded-lg hover:bg-lavender-700 transition-colors font-medium" %>
      </div>
    </div>

    <!-- Compare Trials Card -->
    <div class="bg-white dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700 p-8 hover:shadow-lg transition-shadow">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-2">Compare Trials</h2>
          <p class="text-zinc-600 dark:text-zinc-400">
            Compare up to 3 saved trials side-by-side to make informed decisions about your options.
          </p>
        </div>
        <div class="text-3xl">⚖️</div>
      </div>
      <div class="mt-6 pt-6 border-t border-zinc-200 dark:border-zinc-700">
        <% if @saved_trials_count >= 2 %>
          <%= link_to "Start Comparing", my_trials_trial_comparison_path, 
              class: "inline-block px-6 py-2 bg-lavender-600 text-white rounded-lg hover:bg-lavender-700 transition-colors font-medium" %>
        <% else %>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">
            Save at least 2 trials to compare them
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Quick Search Section -->
  <div class="bg-white dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700 p-8">
    <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6">Search for New Trials</h2>
    <p class="text-zinc-600 dark:text-zinc-400 mb-6">
      Discover new clinical trials that match your profile
    </p>
    <%= link_to "Go to Trial Search", search_index_path, 
        class: "inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" %>
  </div>
</section>

<!-- Recommended Trials Section -->
<section class="px-5 lg:px-44">
  <%= render Page::Dashboard::RecommendedTrialsComponent.new(trials: @recommended_trials) %>
</section>
