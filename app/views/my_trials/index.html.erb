<section class="px-5 lg:px-44 py-16 border-b border-line dark:border-line-on-dark">
  <div class="flex flex-col justify-center items-center">
    <h1 class="text-4xl font-bold text-center mb-3 text-ink dark:text-ink-on-dark">
      Welcome back, <%= @profile.first_name %>!
    </h1>
    <p class="text-lg text-ink-3 dark:text-ink-3-on-dark text-center max-w-2xl">
      Manage your saved clinical trials and discover new matches
    </p>
  </div>
</section>

<section class="px-5 lg:px-44 py-16">
  <div class="grid grid-cols-4 gap-6 mb-10">
    <div class="col-span-2 lg:col-span-1 bg-surface dark:bg-surface-on-dark rounded-lg border border-line dark:border-line-on-dark p-8">
      <p class="text-4xl font-bold text-sky-600 dark:text-sky-400"><%= @saved_trials_count %></p>
      <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mt-2">Saved Trials</p>
    </div>
    <div class="col-span-2 lg:col-span-1 bg-surface dark:bg-surface-on-dark rounded-lg border border-line dark:border-line-on-dark p-8">
      <p class="text-4xl font-bold text-good dark:text-good-on-dark"><%= @excellent_count %></p>
      <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mt-2">Excellent Match</p>
    </div>
    <div class="col-span-2 lg:col-span-1 bg-surface dark:bg-surface-on-dark rounded-lg border border-line dark:border-line-on-dark p-8">
      <p class="text-4xl font-bold text-info dark:text-info-on-dark"><%= @good_count %></p>
      <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mt-2">Good Match</p>
    </div>
    <div class="col-span-2 lg:col-span-1 bg-surface dark:bg-surface-on-dark rounded-lg border border-line dark:border-line-on-dark p-8">
      <p class="text-4xl font-bold text-warn dark:text-warn-on-dark"><%= @fair_count %></p>
      <p class="text-sm text-ink-3 dark:text-ink-3-on-dark mt-2">Fair Match</p>
    </div>
  </div>

  <!-- Action Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
    <!-- Saved Trials Card -->
    <div class="bg-surface dark:bg-surface-on-dark rounded-lg border border-line dark:border-line-on-dark p-8 hover:shadow-lg transition-shadow">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h2 class="text-2xl font-bold text-ink dark:text-ink-on-dark mb-2">Saved Trials</h2>
          <p class="text-ink-3 dark:text-ink-3-on-dark">
            Manage and organize your saved clinical trials. Edit status, add notes, and keep track of your progress.
          </p>
        </div>
        <div class="text-3xl">📋</div>
      </div>
      <div class="mt-6 pt-6 border-t border-line dark:border-line-on-dark">
        <%= link_to "View All Saved Trials", my_trials_saved_trials_path, 
            class: "inline-block px-6 py-2 bg-navy-600 text-white rounded-lg hover:bg-navy-700 transition-colors font-medium" %>
      </div>
    </div>

    <!-- Compare Trials Card -->
    <div class="bg-surface dark:bg-surface-on-dark rounded-lg border border-line dark:border-line-on-dark p-8 hover:shadow-lg transition-shadow">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h2 class="text-2xl font-bold text-ink dark:text-ink-on-dark mb-2">Compare Trials</h2>
          <p class="text-ink-3 dark:text-ink-3-on-dark">
            Compare up to 3 saved trials side-by-side to make informed decisions about your options.
          </p>
        </div>
        <div class="text-3xl">⚖️</div>
      </div>
      <div class="mt-6 pt-6 border-t border-line dark:border-line-on-dark">
        <% if @saved_trials_count >= 2 %>
          <%= link_to "Start Comparing", my_trials_trial_comparison_path, 
              class: "inline-block px-6 py-2 bg-navy-600 text-white rounded-lg hover:bg-navy-700 transition-colors font-medium" %>
        <% else %>
          <p class="text-sm text-ink-3 dark:text-ink-3-on-dark">
            Save at least 2 trials to compare them
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Quick Search Section -->
  <div class="bg-surface dark:bg-surface-on-dark rounded-lg border border-line dark:border-line-on-dark p-8">
    <h2 class="text-2xl font-bold text-ink dark:text-ink-on-dark mb-6">Search for New Trials</h2>
    <p class="text-ink-3 dark:text-ink-3-on-dark mb-6">
      Discover new clinical trials that match your profile
    </p>
    <%= link_to "Go to Trial Search", search_index_path, 
        class: "inline-block px-6 py-2 bg-info text-white rounded-lg hover:bg-info transition-colors font-medium" %>
  </div>
</section>

<!-- Recommended Trials Section -->
<section class="px-5 lg:px-44">
  <%= render Page::Dashboard::RecommendedTrialsComponent.new(trials: @recommended_trials) %>
</section>
